{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://asystemofcells.dev/clackpad/schemas/extension.schema.json",
  "title": "Clackpad extension manifest (clackpad-extension/1)",
  "description": "Editor aid. The authoritative checks are in validate.mjs and the app (cross-field rules such as 'a template using {{typed}} needs typed:read' cannot be expressed here).",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "name", "version", "author", "description", "minClackpad", "contributes"],
  "properties": {
    "schema": { "const": "clackpad-extension/1" },
    "id": { "type": "string", "maxLength": 64, "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+$" },
    "name": { "type": "string", "minLength": 1, "maxLength": 40 },
    "version": { "type": "string", "maxLength": 32, "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(-[0-9A-Za-z]+(\\.[0-9A-Za-z]+)*)?$" },
    "author": { "type": "string", "minLength": 1, "maxLength": 60 },
    "homepage": { "type": "string", "maxLength": 200, "pattern": "^https://" },
    "license": { "type": "string", "maxLength": 40 },
    "description": { "type": "string", "minLength": 1, "maxLength": 140 },
    "minClackpad": { "type": "integer", "minimum": 1 },
    "icon": { "type": "string", "maxLength": 160, "pattern": "\\.png$" },
    "permissions": {
      "type": "array", "maxItems": 16, "uniqueItems": true,
      "items": { "type": "string", "pattern": "^(typed:read|clipboard|notes:write|folder:write|suggestions:surface|uri:(obsidian|logseq|https|mailto|geo)|net:[a-z0-9]([a-z0-9-]*[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)+)$" }
    },
    "config": { "type": "array", "maxItems": 24, "items": { "$ref": "#/$defs/field" } },
    "i18n": {
      "type": "object",
      "propertyNames": { "pattern": "^[a-z]{2,3}(-[A-Z]{2})?$" },
      "additionalProperties": { "type": "object", "additionalProperties": false, "properties": { "name": { "type": "string", "maxLength": 40 }, "description": { "type": "string", "maxLength": 140 } } }
    },
    "contributes": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "theme": { "type": "array", "maxItems": 4, "items": { "$ref": "#/$defs/theme" } },
        "toolsTab": { "type": "array", "maxItems": 4, "items": { "$ref": "#/$defs/toolsTab" } },
        "action": { "type": "array", "maxItems": 32, "items": { "$ref": "#/$defs/action" } },
        "suggestionSurface": { "type": "array", "maxItems": 4, "items": { "$ref": "#/$defs/suggestionSurface" } },
        "settingsPage": {
          "type": "object", "additionalProperties": false, "required": ["fields"],
          "properties": { "title": { "type": "string" }, "fields": { "type": "array", "items": { "$ref": "#/$defs/field" } } }
        }
      }
    }
  },
  "$defs": {
    "key": { "type": "string", "pattern": "^[a-z][A-Za-z0-9_]{0,31}$" },
    "itemId": { "type": "string", "pattern": "^[a-z][A-Za-z0-9_-]{0,31}$" },
    "params": { "type": "object", "maxProperties": 8, "propertyNames": { "$ref": "#/$defs/key" }, "additionalProperties": { "type": "string", "maxLength": 200 } },
    "template": { "type": "string", "maxLength": 4000, "description": "Variables: {{typed}} {{selection}} {{clipboard}} {{title}} {{date}} {{time}} {{datetime}} {{config.<key>}} {{param.<key>}}. Sections: {{#config.<key>}}..{{/config.<key>}} (option on or non-empty), {{#config.<key>=value}} (a choice equals value), {{^config.<key>}} (the opposite)." },
    "field": {
      "type": "object", "additionalProperties": false, "required": ["key", "type", "label"],
      "properties": {
        "key": { "$ref": "#/$defs/key" },
        "type": { "enum": ["toggle", "choice", "text", "number", "color", "folder"] },
        "label": { "type": "string", "maxLength": 40 },
        "default": {},
        "options": { "type": "array", "minItems": 1, "maxItems": 24, "items": { "type": "object", "additionalProperties": false, "required": ["value", "label"], "properties": { "value": { "type": "string", "maxLength": 40 }, "label": { "type": "string", "maxLength": 40 } } } },
        "min": { "type": "number" }, "max": { "type": "number" },
        "maxLength": { "type": "integer", "minimum": 1, "maximum": 500 },
        "template": { "type": "boolean", "description": "Text only. The value is itself a small template (title, date, time, datetime, param.* only) expanded wherever {{config.<key>}} is used." }
      }
    },
    "theme": {
      "type": "object", "additionalProperties": false,
      "properties": { "file": { "type": "string", "pattern": "\\.json$", "description": "Path to a clackpad-theme/1 JSON in the package." }, "pack": { "type": "object", "required": ["format"], "properties": { "format": { "const": "clackpad-theme/1" } } } },
      "oneOf": [{ "required": ["file"] }, { "required": ["pack"] }]
    },
    "button": {
      "type": "object", "additionalProperties": false, "required": ["type", "label", "action"],
      "properties": { "type": { "const": "button" }, "label": { "type": "string", "maxLength": 40 }, "action": { "$ref": "#/$defs/itemId" }, "params": { "$ref": "#/$defs/params" }, "primary": { "type": "boolean" } }
    },
    "uiNode": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["type", "text"], "properties": { "type": { "const": "text" }, "text": { "type": "string", "maxLength": 400 }, "style": { "enum": ["title", "body", "caption"] } } },
        { "$ref": "#/$defs/button" },
        { "type": "object", "additionalProperties": false, "required": ["type", "children"], "properties": { "type": { "const": "row" }, "children": { "type": "array", "minItems": 1, "maxItems": 3, "items": { "$ref": "#/$defs/button" } } } },
        { "type": "object", "additionalProperties": false, "required": ["type", "items"], "properties": { "type": { "const": "list" }, "items": { "type": "array", "minItems": 1, "maxItems": 24, "items": { "type": "object", "additionalProperties": false, "required": ["label", "action"], "properties": { "label": { "type": "string", "maxLength": 60 }, "action": { "$ref": "#/$defs/itemId" }, "params": { "$ref": "#/$defs/params" } } } } } },
        { "type": "object", "additionalProperties": false, "required": ["type", "config", "label"], "properties": { "type": { "const": "field" }, "config": { "$ref": "#/$defs/key" }, "label": { "type": "string", "maxLength": 40 }, "empty": { "type": "string", "maxLength": 40, "description": "Shown instead of 'label: not set' while the option is empty (a folder option shows its folder name)." } } },
        { "type": "object", "additionalProperties": false, "required": ["type"], "properties": { "type": { "const": "divider" } } }
      ]
    },
    "toolsTab": {
      "type": "object", "additionalProperties": false, "required": ["id", "title", "icon", "ui"],
      "properties": { "id": { "$ref": "#/$defs/itemId" }, "title": { "type": "string", "maxLength": 14 }, "icon": { "type": "string", "maxLength": 4 }, "ui": { "type": "array", "minItems": 1, "maxItems": 60, "items": { "$ref": "#/$defs/uiNode" } } }
    },
    "action": {
      "type": "object", "required": ["id", "type"],
      "properties": { "id": { "$ref": "#/$defs/itemId" }, "label": { "type": "string", "maxLength": 40 }, "quick": { "type": "boolean" } },
      "oneOf": [
        { "properties": { "type": { "const": "insertText" }, "template": { "$ref": "#/$defs/template" } }, "required": ["template"] },
        { "properties": { "type": { "const": "openUri" }, "uriTemplate": { "$ref": "#/$defs/template", "pattern": "^(obsidian|logseq|https|mailto|geo):" } }, "required": ["uriTemplate"] },
        { "properties": { "type": { "const": "saveToFolder" }, "folder": { "$ref": "#/$defs/key" }, "fileName": { "$ref": "#/$defs/template" }, "template": { "$ref": "#/$defs/template" }, "mode": { "enum": ["append", "create"] }, "appendWhen": { "type": "object", "additionalProperties": false, "required": ["config", "in"], "properties": { "config": { "$ref": "#/$defs/key" }, "in": { "type": "array", "minItems": 1, "maxItems": 24, "items": { "type": "string", "maxLength": 40 } } }, "description": "Append (instead of create) while the choice option holds one of these values. Not with mode." } }, "required": ["folder", "template"] },
        { "properties": { "type": { "const": "openSettings" } }, "description": "Opens this extension's own page in Clackpad Settings." },
        { "properties": { "type": { "const": "share" }, "template": { "$ref": "#/$defs/template" }, "subject": { "type": "string", "maxLength": 100 } }, "required": ["template"] },
        { "properties": { "type": { "const": "copyToClipboard" }, "template": { "$ref": "#/$defs/template" } }, "required": ["template"] },
        { "properties": { "type": { "const": "launchExtensionPage" }, "page": { "type": "string", "pattern": "\\.html$" } }, "required": ["page"] }
      ]
    },
    "suggestionSurface": {
      "type": "object", "additionalProperties": false, "required": ["surface"],
      "properties": {
        "surface": { "const": "frets" },
        "fontSize": { "type": "integer", "minimum": 8, "maximum": 18 },
        "colorRole": { "enum": ["text", "accent", "dim"] },
        "maxCandidates": { "type": "integer", "minimum": 1, "maximum": 5 },
        "placement": { "type": "array", "uniqueItems": true, "items": { "enum": [0, 1, 2] } },
        "gesture": { "enum": ["tap", "flick-up", "both"] },
        "showOnLandscape": { "type": "boolean" },
        "acceptSource": { "const": "host" },
        "layout": { "enum": ["even", "above-next-letter"], "default": "above-next-letter", "description": "above-next-letter: each candidate over the key it would type next (falls back to an even spread when it does not fit); even: spread over the chosen frets." },
        "look": { "enum": ["plate", "text"], "default": "plate", "description": "plate: each word on a raised plate on the bar; text: the classic plain-text look (no plate, the word hangs on the fret)." },
        "keepStrip": { "type": "boolean", "default": true, "description": "true keeps the built-in suggestion strip; false lets the frets replace it." },
        "replaceStrip": { "type": "boolean", "default": false, "description": "Alias: the inverse of keepStrip. Say one of the two; if both are present they must be opposite." },
        "fromConfig": {
          "type": "object", "additionalProperties": false,
          "description": "Surface field -> config key: the user's option overrides the declared value. Types: number for fontSize/maxCandidates, choice for colorRole/gesture/layout/look, toggle for keepStrip/showOnLandscape.",
          "properties": {
            "fontSize": { "$ref": "#/$defs/key" }, "maxCandidates": { "$ref": "#/$defs/key" }, "colorRole": { "$ref": "#/$defs/key" },
            "gesture": { "$ref": "#/$defs/key" }, "layout": { "$ref": "#/$defs/key" }, "look": { "$ref": "#/$defs/key" }, "keepStrip": { "$ref": "#/$defs/key" }, "showOnLandscape": { "$ref": "#/$defs/key" }
          }
        }
      }
    }
  }
}
