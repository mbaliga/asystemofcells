{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://asystemofcells.dev/clackpad/schemas/catalog.schema.json",
  "title": "Clackpad extension catalog (clackpad-catalog/1)",
  "type": "object",
  "required": ["schema", "extensions"],
  "properties": {
    "schema": { "const": "clackpad-catalog/1" },
    "name": { "type": "string", "maxLength": 80 },
    "updated": { "type": "string", "description": "ISO date the index was last changed." },
    "extensions": { "type": "array", "maxItems": 500, "items": { "$ref": "#/$defs/entry" } }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "required": ["id", "name", "version", "author", "description", "permissions", "package", "sha256", "status"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+$" },
        "name": { "type": "string", "maxLength": 40 },
        "version": { "type": "string", "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(-[0-9A-Za-z]+(\\.[0-9A-Za-z]+)*)?$" },
        "author": { "type": "string", "maxLength": 60 },
        "description": { "type": "string", "maxLength": 140 },
        "permissions": { "type": "array", "items": { "type": "string" }, "description": "Must list every permission of the package; the app refuses a package that asks for more." },
        "package": { "type": "string", "pattern": "^https://", "description": "https URL of the .cpx" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "homepage": { "type": "string", "pattern": "^https://" },
        "icon": { "type": "string", "pattern": "^https://", "description": "Reserved: the app does not fetch catalog icons." },
        "status": { "enum": ["official", "community", "fan-made"] },
        "noncommercial": { "type": "boolean" },
        "minClackpad": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
