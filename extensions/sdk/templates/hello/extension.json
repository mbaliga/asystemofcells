{
  "schema": "clackpad-extension/1",
  "id": "com.example.hello",
  "name": "Hello",
  "version": "1.0.0",
  "author": "Your Name",
  "homepage": "https://example.com/clackpad-hello",
  "license": "MIT",
  "description": "A starter extension: one Tools Panel tab that types a greeting.",
  "minClackpad": 50,
  "icon": "icon.png",
  "permissions": [],
  "config": [
    { "key": "name", "type": "text", "label": "Name to greet", "default": "world", "maxLength": 40 }
  ],
  "contributes": {
    "action": [
      { "id": "greet", "type": "insertText", "label": "Say hello", "template": "Hello, {{config.name}}! ({{date}})" },
      { "id": "about", "type": "launchExtensionPage", "label": "About", "page": "pages/about.html" }
    ],
    "toolsTab": [
      {
        "id": "main",
        "title": "Hello",
        "icon": "Hi",
        "ui": [
          { "type": "text", "text": "Hello extension", "style": "title" },
          { "type": "field", "config": "name", "label": "Greeting" },
          { "type": "row", "children": [
            { "type": "button", "label": "Say hello", "action": "greet", "primary": true },
            { "type": "button", "label": "About", "action": "about" }
          ] }
        ]
      }
    ]
  },
  "i18n": {
    "es": { "name": "Hola", "description": "Una extensión de ejemplo: una pestaña que escribe un saludo." },
    "de": { "name": "Hallo", "description": "Eine Starter-Erweiterung: ein Tab, der eine Begrüßung tippt." }
  }
}
