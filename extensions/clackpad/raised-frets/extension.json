{
  "schema": "clackpad-extension/1",
  "id": "dev.asystemofcells.frets.raised",
  "name": "Raised frets",
  "version": "1.1.0",
  "author": "A System of Cells",
  "description": "Predicted words on the fret bars, inspired by classic physical-keyboard phones. Unofficial, non-commercial fan project.",
  "minClackpad": 51,
  "homepage": "https://github.com/mbaliga/asystemofcells/tree/main/extensions/clackpad",
  "license": "MIT",
  "icon": "icon.png",
  "permissions": ["suggestions:surface"],
  "contributes": {
    "suggestionSurface": [
      {
        "surface": "frets",
        "maxCandidates": 3,
        "gesture": "both",
        "layout": "above-next-letter",
        "keepStrip": true,
        "look": "plate",
        "fontSize": 12,
        "colorRole": "text",
        "showOnLandscape": true,
        "acceptSource": "host",
        "fromConfig": {
          "maxCandidates": "count",
          "gesture": "gesture",
          "layout": "placement",
          "look": "look",
          "keepStrip": "keepStrip",
          "fontSize": "fontSize",
          "colorRole": "colorRole",
          "showOnLandscape": "landscape"
        }
      }
    ],
    "settingsPage": {
      "title": "Fret suggestions",
      "fields": [
        { "key": "count", "type": "number", "label": "Suggestions shown (1 to 5)", "default": 3, "min": 1, "max": 5 },
        { "key": "gesture", "type": "choice", "label": "Accept with", "default": "both",
          "options": [ { "value": "tap", "label": "Tap" }, { "value": "flick-up", "label": "Flick up" }, { "value": "both", "label": "Tap or flick up" } ] },
        { "key": "placement", "type": "choice", "label": "Placement", "default": "above-next-letter",
          "options": [ { "value": "above-next-letter", "label": "Above the likely next letter" }, { "value": "even", "label": "Spread evenly" } ] },
        { "key": "look", "type": "choice", "label": "Look", "default": "plate",
          "options": [ { "value": "text", "label": "Classic text" }, { "value": "plate", "label": "Raised plate" } ] },
        { "key": "keepStrip", "type": "toggle", "label": "Keep the suggestion strip", "default": true },
        { "key": "fontSize", "type": "number", "label": "Font size (8 to 18)", "default": 12, "min": 8, "max": 18 },
        { "key": "colorRole", "type": "choice", "label": "Colour", "default": "text",
          "options": [ { "value": "text", "label": "Text" }, { "value": "accent", "label": "Accent" }, { "value": "dim", "label": "Dim" } ] },
        { "key": "landscape", "type": "toggle", "label": "Show in landscape", "default": true }
      ]
    }
  }
}
