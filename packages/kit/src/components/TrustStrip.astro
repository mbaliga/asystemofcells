---
// component: TrustStrip
// The house's four fixed proofs. Same four, same order, on every page.
const proofs = [
  { label: 'Tiny', body: 'Animalcules is about 2 MB. Smaller than most apps’ screenshots.' },
  { label: 'On your device', body: 'Bring your own key, free APIs, no backend. Nothing phones home.' },
  { label: 'Yours forever', body: 'No subscription, no ads, no accounts, no tracking. A one-time unlock is a fanciness, not a necessity.' },
  { label: 'Made in Fonebrew', body: 'Built and shipped with the house’s own on-device AI environment.' },
]
---
<section class="trust-strip" aria-label="House proofs">
  <div class="shell trust-strip__grid">
    {proofs.map(p => (
      <div class="trust-strip__cell">
        <span class="trust-strip__label">{p.label}</span>
        <p class="trust-strip__body">{p.body}</p>
      </div>
    ))}
  </div>
</section>

<style>
  .trust-strip { padding: 3.5rem 0; border-top: 1px solid var(--hairline); border-bottom: 1px solid var(--hairline); }
  .trust-strip__grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 2rem; }
  .trust-strip__label {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--violet);
    margin-bottom: 0.5rem;
  }
  .trust-strip__body { margin: 0; font-size: 0.86rem; line-height: 1.55; color: var(--ink-muted); }
  @media (max-width: 900px) {
    .trust-strip__grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 560px) {
    .trust-strip__grid { grid-template-columns: 1fr; }
  }
</style>
