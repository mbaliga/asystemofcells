---
// component: CellCard
// One roster entry, rendered as a card. Hub products (own authoritative site)
// render lean and deep-link out rather than pretending to be a full sell page.
import { ctaLabel } from '@asoc/roster'

const { cell } = Astro.props
const isHub = !!cell.isHub
const cta = isHub ? `Visit ${cell.hubUrl.replace('https://', '')}` : ctaLabel(cell.status)
const href = isHub ? cell.hubUrl : `/${cell.slug}`
---
<article class="cell-card" style={`--cell-accent:${cell.accent}`} data-status={cell.status}>
  <div class="cell-card__hint" aria-hidden="true"></div>
  <div class="cell-card__body">
    <div class="cell-card__top">
      <span class="cell-card__name">{cell.slug}</span>
      <span class={`cell-card__status cell-card__status--${cell.status}`}>{cell.status}</span>
    </div>
    <p class="cell-card__line">{cell.oneLiner}</p>
  </div>
  <a class="cell-card__cta" href={href} target={isHub ? '_blank' : undefined} rel={isHub ? 'noopener noreferrer' : undefined}>
    {cta} <span aria-hidden="true">&rarr;</span>
  </a>
</article>

<style>
  .cell-card {
    position: relative;
    border-radius: var(--radius);
    border: 1px solid var(--hairline);
    background: var(--surface);
    padding: 1.4rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    overflow: hidden;
    transition: border-color var(--motion) var(--ease), transform var(--motion) var(--ease);
  }
  .cell-card:hover { border-color: var(--cell-accent); transform: translateY(-2px); }
  .cell-card__hint {
    position: absolute;
    top: -30%;
    right: -20%;
    width: 60%;
    height: 60%;
    border-radius: 50%;
    background: var(--cell-accent);
    opacity: 0.16;
    filter: blur(30px);
    pointer-events: none;
  }
  .cell-card__body { position: relative; z-index: 1; }
  .cell-card__top { display: flex; align-items: center; justify-content: space-between; gap: 0.6rem; margin-bottom: 0.6rem; }
  .cell-card__name { font-family: var(--font-mono); font-size: 0.8rem; letter-spacing: 0.02em; color: var(--ink); }
  .cell-card__status {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 0.2rem 0.5rem;
    border-radius: 999px;
    border: 1px solid var(--hairline);
    color: var(--ink-faint);
  }
  .cell-card__status--live { color: var(--provenance-native); border-color: var(--provenance-native); }
  .cell-card__status--beta { color: var(--cyan); border-color: var(--cyan); }
  .cell-card__line { margin: 0; font-size: 0.86rem; line-height: 1.5; color: var(--ink-muted); position: relative; z-index: 1; }
  .cell-card__cta {
    position: relative;
    z-index: 1;
    align-self: flex-start;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.03em;
    color: var(--violet);
    text-decoration: none;
  }
  .cell-card__cta:hover { text-decoration: underline; }
</style>
