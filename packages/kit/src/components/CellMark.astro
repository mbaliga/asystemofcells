---
// component: CellMark
// A small organic cell: one irregular closed blob (six points joined by cubic
// beziers, the rounded-polygon language of the cells generator), never a
// circle. Each variant changes the SHAPE or FILL treatment, so no variant
// depends on colour to be told apart. Colour is currentColor.
//
// Status:      live (filled) · beta (half filled) · soon (outline)
//              · building (outline, short inner dash) · open (filled, house violet, with an open centre)
// Provenance:  device (solid) · preview (outline) · web (inner mesh)
//              · render (hatched) · art (double border)
const VARIANTS = ['live', 'beta', 'soon', 'building', 'open', 'device', 'preview', 'web', 'render', 'art']
const { variant = 'live', size = 14, label, class: className } = Astro.props
if (!VARIANTS.includes(variant)) throw new Error(`CellMark: unknown variant "${variant}"`)

// Six points on a 24x24 grid, uneven radii, joined by a closed Catmull-Rom
// spline converted to cubic beziers.
const P = [
  [12, 2.6],
  [20.4, 6.2],
  [21.6, 14.6],
  [14.4, 21.4],
  [5.4, 19.2],
  [2.6, 10.4],
]
const T = 1 / 6
const f = (n) => Number(n.toFixed(2))
let d = `M${P[0][0]} ${P[0][1]}`
for (let i = 0; i < P.length; i++) {
  const p0 = P[(i - 1 + P.length) % P.length]
  const p1 = P[i]
  const p2 = P[(i + 1) % P.length]
  const p3 = P[(i + 2) % P.length]
  const c1 = [p1[0] + (p2[0] - p0[0]) * T, p1[1] + (p2[1] - p0[1]) * T]
  const c2 = [p2[0] - (p3[0] - p1[0]) * T, p2[1] - (p3[1] - p1[1]) * T]
  d += ` C${f(c1[0])} ${f(c1[1])} ${f(c2[0])} ${f(c2[1])} ${p2[0]} ${p2[1]}`
}
d += 'Z'

const id = `cellmark-${variant}`
const sw = 1.6
---
<span class:list={['cellmark', `cellmark--${variant}`, className]} style={`--cm-size:${size}px`}>
  <svg
    viewBox="0 0 24 24"
    width={size}
    height={size}
    aria-hidden={label ? undefined : 'true'}
    role={label ? 'img' : undefined}
    aria-label={label || undefined}
    focusable="false"
  >
    {(variant === 'live' || variant === 'device') && <path d={d} fill="currentColor" />}
    {variant === 'open' && (
      <>
        <path d={d} fill="var(--house-violet, #8E7BFF)" />
        <circle cx="12" cy="12" r="3.2" fill="var(--cellmark-ground, #fff)" />
      </>
    )}
    {variant === 'beta' && (
      <>
        <defs>
          <clipPath id={id}><rect x="0" y="0" width="12" height="24" /></clipPath>
        </defs>
        <path d={d} fill="currentColor" clip-path={`url(#${id})`} />
        <path d={d} fill="none" stroke="currentColor" stroke-width={sw} stroke-linejoin="round" />
      </>
    )}
    {(variant === 'soon' || variant === 'preview') && (
      <path d={d} fill="none" stroke="currentColor" stroke-width={sw} stroke-linejoin="round" />
    )}
    {variant === 'building' && (
      <>
        <path d={d} fill="none" stroke="currentColor" stroke-width={sw} stroke-linejoin="round" />
        <path d="M8.6 12.2 L15.4 12.2" fill="none" stroke="currentColor" stroke-width={sw} stroke-linecap="round" />
      </>
    )}
    {variant === 'web' && (
      <>
        <path d={d} fill="none" stroke="currentColor" stroke-width={sw} stroke-linejoin="round" />
        <path d="M5.2 9.6 C9 12.6 14.6 7.6 19.4 10.6" fill="none" stroke="currentColor" stroke-width="1.1" stroke-linecap="round" />
        <path d="M6.6 16 C10.4 13.4 14.4 17.8 18.6 15" fill="none" stroke="currentColor" stroke-width="1.1" stroke-linecap="round" />
      </>
    )}
    {variant === 'render' && (
      <>
        <defs>
          <pattern id={id} width="4" height="4" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
            <line x1="0" y1="0" x2="0" y2="4" stroke="currentColor" stroke-width="1.6" />
          </pattern>
        </defs>
        <path d={d} fill={`url(#${id})`} stroke="currentColor" stroke-width="1.2" stroke-linejoin="round" />
      </>
    )}
    {variant === 'art' && (
      <>
        <path d={d} fill="none" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round" />
        <path
          d={d}
          fill="none"
          stroke="currentColor"
          stroke-width="1.3"
          stroke-linejoin="round"
          transform="translate(12 12) scale(.66) translate(-12 -12)"
          vector-effect="non-scaling-stroke"
        />
      </>
    )}
  </svg>
  {label && <span class="cellmark__label">{label}</span>}
</span>

<style>
  .cellmark { display: inline-flex; align-items: center; vertical-align: -0.15em; line-height: 0; color: inherit; }
  .cellmark svg { display: block; width: var(--cm-size); height: var(--cm-size); }
  .cellmark__label {
    position: absolute; width: 1px; height: 1px; overflow: hidden;
    clip: rect(0 0 0 0); clip-path: inset(50%); white-space: nowrap;
  }
</style>
