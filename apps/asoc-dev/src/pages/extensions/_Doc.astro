---
import DevLayout from '../../layouts/DevLayout.astro'

/*
 * Shared frame for the extension developer docs. Analytics is passed false on
 * purpose: these are reference pages people read while building something, and
 * the house rule counts pages that describe the house, not pages where someone
 * makes or reads. Nothing here sets a cookie or loads a third-party script.
 */
const { title, description, path, eyebrow, heading, lead, sources = [] } = Astro.props

const NAV = [
  { href: '/extensions/', label: 'Overview' },
  { href: '/extensions/format/', label: 'Manifest format' },
  { href: '/extensions/permissions/', label: 'Permissions' },
  { href: '/extensions/publish/', label: 'Publish' },
  { href: '/extensions/agents/', label: 'For AI agents' },
]
---
<DevLayout
  title={`${title}: asystemofcells.dev`}
  description={description}
  canonical={`https://asystemofcells.dev${path}`}
  analytics={false}
>
  <div class="shell ext-doc">
    <a class="back-link" href="/">&larr; asystemofcells.dev</a>
    <nav class="ext-nav" aria-label="Extension documentation">
      {NAV.map((n) => (
        <a href={n.href} aria-current={n.href === path ? 'page' : undefined}>{n.label}</a>
      ))}
    </nav>
    <main id="main">
      <p class="eyebrow">{eyebrow}</p>
      <h1 class="ext-h1">{heading}</h1>
      {lead && <p class="ext-lead">{lead}</p>}
      <div class="dev-prose ext-body">
        <slot />
      </div>
      {sources.length > 0 && (
        <p class="ext-source">
          Source of truth in the repository:
          {sources.map((s, i) => (<>{i > 0 ? ', ' : ' '}<code>{s}</code></>))}.
          This page is generated from {sources.length > 1 ? 'those files' : 'that file'} when the site is built, so it cannot drift from it.
        </p>
      )}
    </main>
  </div>
</DevLayout>

<style is:global>
  .ext-doc { padding-top: 3.4rem; padding-bottom: 3rem; }
  .ext-nav { display: flex; flex-wrap: wrap; gap: 0.4rem 1.2rem; margin: 0 0 2rem; padding-bottom: 0.8rem; border-bottom: 1px solid var(--hairline-ghost); }
  .ext-nav a { font-size: var(--fs-small); color: var(--ink-muted); text-decoration: none; padding: 0.35rem 0; min-height: 24px; }
  .ext-nav a:hover, .ext-nav a[aria-current='page'] { color: var(--ink); }
  .ext-nav a[aria-current='page'] { border-bottom: 1px solid var(--ink); }
  .ext-h1 { font-size: var(--fs-h1); font-weight: 500; letter-spacing: var(--track-tight); margin: 0 0 0.7rem; line-height: var(--lh-tight); overflow-wrap: anywhere; }
  .ext-lead { max-width: 66ch; color: var(--ink-muted); line-height: var(--lh-body); margin: 0 0 1.4rem; }
  .ext-body { max-width: 78ch; }
  .ext-body h2 { scroll-margin-top: 1rem; }
  .ext-body h3 { font-size: var(--fs-body); color: var(--ink); font-weight: 500; margin: 1.8rem 0 0.6rem; }
  .ext-body ol { margin: 0 0 1rem; padding-left: 1.3rem; }
  .ext-body pre { background: var(--bg-sunken); border: 1px solid var(--hairline-ghost); padding: 0.8rem 1rem; overflow-x: auto; font-size: var(--fs-small); line-height: 1.5; color: var(--ink); margin: 0 0 1.2rem; max-width: 100%; }
  .ext-body pre code { background: none; border: 0; padding: 0; font-size: inherit; }
  .ext-body code { overflow-wrap: anywhere; }
  .ext-body .table-scroll { margin: 0 0 1.4rem; max-width: 100%; }
  .ext-body .table-scroll:focus-visible { outline: 1px solid var(--sect-tools); }
  .ext-body .dense-table td, .ext-body .dense-table th { padding-right: 1rem; }
  .ext-body .dense-table code { white-space: normal; }
  .ext-body .req { color: var(--ink); }
  .ext-body .note { border-left: 2px solid var(--hairline-strong); padding: 0.1rem 0 0.1rem 0.9rem; margin: 0 0 1.2rem; color: var(--ink-muted); }
  .ext-body .risk { font-size: var(--fs-micro); letter-spacing: var(--track-tag); text-transform: uppercase; white-space: nowrap; }
  .ext-body .risk--high { color: #ff8a65; }
  .ext-body .risk--medium { color: #ffd54f; }
  .ext-body .risk--low { color: var(--ink-muted); }
  .ext-source { max-width: 78ch; margin: 2.4rem 0 0; padding-top: 1rem; border-top: 1px solid var(--hairline-ghost); font-size: var(--fs-small); color: var(--ink-faint); line-height: var(--lh-body); }
  .ext-source code { overflow-wrap: anywhere; }
  .ext-body table { width: 100%; }
  .ext-body .dense-table { min-width: 36rem; }
  .ext-cards { display: grid; gap: 0.8rem; grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr)); margin: 0 0 1.6rem; }
  .ext-card { display: block; padding: 0.9rem 1rem; border: 1px solid var(--hairline-ghost); text-decoration: none; color: var(--ink-muted); border-bottom: 1px solid var(--hairline-ghost) !important; }
  .ext-card:hover { background: var(--surface-raised); color: var(--ink); }
  .ext-card b { display: block; color: var(--ink); font-weight: 500; margin-bottom: 0.3rem; }
  @media (max-width: 480px) { .ext-body pre { font-size: 0.78rem; } }
</style>
