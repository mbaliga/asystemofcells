---
import Doc from '../_Doc.astro'
import Rows from '../_Rows.astro'
import { extensionSchema, rowsFor, variantsFor, contributionKinds } from '../../../lib/extensions-docs.js'

const schema = extensionSchema()
const top = rowsFor(schema, schema)
const kinds = contributionKinds(schema)
const fieldRows = rowsFor(schema.$defs.field, schema)
const optionRows = rowsFor(schema.$defs.field.properties.options.items, schema)
const themeRows = rowsFor(schema.$defs.theme, schema)
const tabRows = rowsFor(schema.$defs.toolsTab, schema)
const ui = variantsFor('uiNode', schema)
const act = variantsFor('action', schema)
const surfaceRows = rowsFor(schema.$defs.suggestionSurface, schema)
const fromConfigRows = rowsFor(schema.$defs.suggestionSurface.properties.fromConfig, schema)
const settingsRows = rowsFor(schema.properties.contributes.properties.settingsPage, schema)
const i18nRows = rowsFor(schema.properties.i18n.additionalProperties, schema)
const paramsDef = schema.$defs.params
const T = (s) => s // helper so braces stay literal in markup below

const VARS = [
  ['{{typed}}', 'the selection if there is one, else the whole field text, read when the user taps', 'typed:read'],
  ['{{selection}}', 'the selected text only', 'typed:read'],
  ['{{clipboard}}', 'the clipboard text at tap time', 'clipboard'],
  ['{{title}}', 'param.title if given, else the first line of the typed text (60 chars, # stripped), else Note <date time>', 'none'],
  ['{{date}} {{time}} {{datetime}}', '2026-01-31, 14:05, 2026-01-31 14:05 (device time zone)', 'none'],
  ['{{config.key}}', 'the option’s current value (a folder option expands to empty)', 'none'],
  ['{{param.key}}', 'a parameter passed by the button or page, else empty', 'none'],
]
const ACTION_NEEDS = [
  ['insertText', 'types the expanded text into the focused field', 'the variables’ permissions'],
  ['openUri', 'opens a link with ACTION_VIEW', 'uri:<scheme>'],
  ['saveToFolder', 'writes a text file into the folder the user granted (fileName defaults to {{title}}.md)', 'folder:write'],
  ['share', 'system share sheet (ACTION_SEND, text/plain)', 'the variables’ permissions'],
  ['copyToClipboard', 'puts the expanded text on the clipboard', 'clipboard'],
  ['launchExtensionPage', 'opens the sandboxed page', 'none'],
  ['openSettings', 'opens this extension’s own screen in Clackpad Settings (its options and permissions)', 'none'],
]
const EXAMPLE = `{
  "schema": "clackpad-extension/1",
  "id": "com.example.hello",
  "name": "Hello",
  "version": "1.0.0",
  "author": "Your Name",
  "description": "A starter extension: one Tools Panel tab that types a greeting.",
  "minClackpad": 50,
  "icon": "icon.png",
  "permissions": [],
  "config": [{ "key": "name", "type": "text", "label": "Name to greet", "default": "world" }],
  "contributes": {
    "action": [{ "id": "greet", "type": "insertText", "label": "Say hello", "template": "Hello, {{config.name}}! ({{date}})" }],
    "toolsTab": [{ "id": "main", "title": "Hello", "icon": "Hi",
      "ui": [{ "type": "button", "label": "Say hello", "action": "greet", "primary": true }] }]
  }
}`
const TAB = `"toolsTab": [{
  "id": "main", "title": "Obsidian", "icon": "Ob",
  "ui": [
    { "type": "text", "text": "Send to Obsidian", "style": "title" },
    { "type": "field", "config": "vault", "label": "Vault" },
    { "type": "button", "label": "Send as note", "action": "send", "primary": true },
    { "type": "row", "children": [
      { "type": "button", "label": "Save", "action": "save" },
      { "type": "button", "label": "Copy", "action": "copy", "params": { "title": "Clip" } } ] },
    { "type": "list", "items": [ { "label": "Daily note", "action": "daily" } ] },
    { "type": "divider" }
  ]
}]`
const SURFACE = `"suggestionSurface": [{
  "surface": "frets", "fontSize": 12, "colorRole": "accent", "maxCandidates": 3,
  "placement": [0, 1, 2], "gesture": "tap", "showOnLandscape": true, "acceptSource": "host"
}]`
---
<Doc
  title="Manifest format"
  description="Reference for the Clackpad extension manifest (clackpad-extension/1), generated from the JSON Schema: every key, type and limit, plus contribution types, config fields, the Tools Panel and the suggestion surface."
  path="/extensions/format/"
  eyebrow="Extensions / Reference"
  heading="Manifest format: clackpad-extension/1"
  lead="The manifest is extension.json at the root of the package. Every table of keys and limits on this page is generated from the JSON Schema; the prose is taken from Clackpad's EXTENSIONS.md."
  sources={['extensions/sdk/schemas/extension.schema.json', 'Clackpad docs/EXTENSIONS.md (prose)']}
>
  <p class="note">
    The schema is an editor aid. Its own description says: the authoritative checks are in <code>validate.mjs</code> and the app, and cross-field
    rules such as &ldquo;a template using <code>{T('{{typed}}')}</code> needs <code>typed:read</code>&rdquo; cannot be expressed in it. Rules that only the validator knows are
    marked <em>(validator)</em> below and in <a href="#differences">the differences list</a>.
  </p>

  <h2 id="example">A complete manifest</h2>
  <pre><code>{EXAMPLE}</code></pre>

  <h2 id="top-level">Top-level keys</h2>
  <p>Any other key is rejected (<code>additionalProperties: false</code>).</p>
  <Rows rows={top} label="Top-level manifest keys" />

  <h3>Package limits <em>(validator)</em></h3>
  <p>
    At most <b>5 MB</b> packed, <b>200</b> entries, <b>16 MB</b> unpacked in total and <b>5 MB</b> per entry. Entry paths are relative, at most 160 chars,
    with no <code>..</code>, <code>.</code>, empty segments, backslashes, <code>:</code> or control characters; no symbolic links; no encryption; no Zip64; no
    case-insensitive duplicates. No entry named, or ending (anywhere after the first dot), <code>.dex .so .apk .jar .class .odex .vdex .aar .oat .art</code>, and no
    entry whose bytes start like an ELF, DEX, Java class or nested zip. Every file the manifest points at (icon, theme files, pages) must exist in the package.
    The icon is a PNG of at most 64 KB, ideally 64x64. Config fields: at most 24 across <code>config</code> and <code>settingsPage</code>. A manifest must declare at least one contribution (or config fields). <code>net:</code> permissions: at most 8.
  </p>

  <h2 id="contributions">Contribution types</h2>
  <p>Under <code>contributes</code> (any other key is rejected):</p>
  <div class="table-scroll" tabindex="0" role="region" aria-label="Contribution limits">
    <table class="dense-table">
      <thead><tr><th scope="col">Key</th><th scope="col">Shape</th></tr></thead>
      <tbody>
        {kinds.map((k) => (<tr><td><code>{k.key}</code></td><td>{k.isArray ? `array, maxItems ${k.maxItems}, items: ${k.def}` : 'object'}</td></tr>))}
      </tbody>
    </table>
  </div>

  <h3 id="theme"><code>theme</code>: a theme pack</h3>
  <p>
    Each entry gives exactly one of <code>file</code> (path to a <code>clackpad-theme/1</code> JSON in the package) or <code>pack</code> (the theme inline).
    The file is checked at install by the theme engine&rsquo;s own parser; a pack the engine would reject refuses the package. While the extension is enabled each
    pack appears in Settings &gt; Appearance &gt; Theme. Disabling, removing or Safe mode unregisters it; if it was the active theme the choice resets to Default.
    An extension cannot take a built-in theme id or another owner&rsquo;s. Starter: <code>extensions/sdk/templates/theme</code>.
  </p>
  <Rows rows={themeRows} label="theme entry keys" />

  <h3 id="tools-tab"><code>toolsTab</code>: a Tools Panel tab</h3>
  <pre><code>{TAB}</code></pre>
  <p>
    Tabs appear in the Tools Panel nav <b>after the built-in tabs</b>, on every nav layout. <code>title</code> is the nav label; <code>icon</code> is a text glyph
    (the nav draws it like the built-in &ldquo;GIF&rdquo; and &ldquo;Tt&rdquo; marks). UI elements: at most 60 per tab, nesting at most 3 <em>(validator)</em>. All targets are at least 44 dp;
    a <code>list</code> row is a 48 dp tap target. Every <code>action</code> a button or list item names must be declared in the same manifest.
    A <code>field</code> shows the option&rsquo;s current value; tapping it opens the extension&rsquo;s page in Settings, because a tab cannot host a text field (the panel <em>is</em> the keyboard).
    If an extension declares actions with <code>"quick": true</code> and <b>no</b> <code>toolsTab</code>, the host generates a tab named after the extension holding one button per quick action.
  </p>
  <Rows rows={tabRows} label="toolsTab keys" />
  <h4 style="margin:1.2rem 0 0.5rem;color:var(--ink);font-weight:500">UI elements (<code>ui[]</code>, discriminated by <code>type</code>)</h4>
  {ui.variants.map((v) => (
    <>
      <p style="margin-bottom:0.4rem"><code>type: {v.label}</code></p>
      <Rows rows={v.rows} label={`ui element ${v.label}`} />
    </>
  ))}
  <p><code>params</code>: an object, up to {paramsDef.maxProperties} <code>{'{key: string}'}</code> pairs (value maxLength {paramsDef.additionalProperties.maxLength}), exposed to the action as <code>{T('{{param.key}}')}</code>.</p>

  <h3 id="action"><code>action</code>: a named operation</h3>
  <p>
    Common keys: <code>id</code> (unique), <code>type</code>, optional <code>label</code>, optional <code>quick</code>. Actions are usable from <code>toolsTab</code> buttons and lists,
    from sandboxed pages (<code>clackpad.runAction</code>), and as quick buttons.
  </p>
  <Rows rows={act.common} label="action common keys" />
  <div class="table-scroll" tabindex="0" role="region" aria-label="Action types: what the host does and what each needs">
    <table class="dense-table">
      <thead><tr><th scope="col">type</th><th scope="col">What the host does</th><th scope="col">Needs</th></tr></thead>
      <tbody>{ACTION_NEEDS.map((a) => (<tr><td><code>{a[0]}</code></td><td>{a[1]}</td><td><code>{a[2]}</code></td></tr>))}</tbody>
    </table>
  </div>
  <p>
    <code>openUri</code> schemes are limited to <code>obsidian</code>, <code>logseq</code>, <code>https</code>, <code>mailto</code>, <code>geo</code>; the template must start with the scheme
    as literal text (never a variable), and the matching <code>uri:&lt;scheme&gt;</code> permission must be declared.
  </p>
  <h4 style="margin:1.2rem 0 0.5rem;color:var(--ink);font-weight:500">Keys per action type (from the schema)</h4>
  {act.variants.map((v) => (
    <>
      <p style="margin-bottom:0.4rem"><code>type: {v.label}</code>{v.description && <> &mdash; {v.description}</>}</p>
      <Rows rows={v.rows} label={`action type ${v.label}`} />
    </>
  ))}

  <h3 id="templates">Templates</h3>
  <p><b>Variables</b> (an unknown variable is an error; one used without its permission is <b>rejected at install</b>):</p>
  <div class="table-scroll" tabindex="0" role="region" aria-label="Template variables">
    <table class="dense-table">
      <thead><tr><th scope="col">Variable</th><th scope="col">Value</th><th scope="col">Needs</th></tr></thead>
      <tbody>{VARS.map((v) => (<tr><td><code>{v[0]}</code></td><td>{v[1]}</td><td><code>{v[2]}</code></td></tr>))}</tbody>
    </table>
  </div>
  <p>Schema description of a template: <q>{schema.$defs.template.description}</q> Maximum length {schema.$defs.template.maxLength}.</p>
  <ul>
    <li><b>One pass, no recursion.</b> A value is inserted verbatim and never scanned again: a clipboard that contains <code>{T('{{typed}}')}</code> stays that literal text.</li>
    <li><b>By context.</b> In <code>uriTemplate</code> every value is percent-encoded as UTF-8 (everything except <code>A-Z a-z 0-9 - _ . ~</code>). In <code>fileName</code> every value has <code>/ \ : * ? " &lt; &gt; |</code> and control characters replaced by spaces, whitespace collapsed, leading dots removed, 80 chars max. In every other template values are verbatim. Literal text written by the author is never altered.</li>
    <li><b>Limits.</b> Template 4000 chars; expanded text 100,000 chars; expanded URI 8,000 chars (longer is refused). An expanded URI is re-checked: its scheme must still be on the allowlist and permitted.</li>
    <li>Single <code>{'{'}</code> and <code>{'}'}</code> are literal; <code>{'{{'}</code> and <code>{'}}'}</code> must form a valid <code>{'{{variable}}'}</code>.</li>
    <li><b>Option templates</b>: a <code>text</code> option with <code>"template": true</code> holds a small template (only title, date, time, datetime, param.x) expanded one level wherever <code>{T('{{config.key}}')}</code> uses it. It can never reach typed text, the clipboard or other options.</li>
    <li>If the text is empty (<code>{T('{{typed}}')}</code> with nothing typed) the action refuses rather than sending a blank note.</li>
  </ul>
  <p><b>Privacy gate.</b> In password, incognito, &ldquo;force incognito&rdquo; and never-learn fields the host reads nothing and refuses every action that uses <code>{T('{{typed}}')}</code>, <code>{T('{{selection}}')}</code> or <code>{T('{{clipboard}}')}</code>. Actions that use none of them still run.</p>

  <h3 id="suggestion-surface"><code>suggestionSurface</code>: styling for the frets</h3>
  <pre><code>{SURFACE}</code></pre>
  <p>
    Configures the keyboard&rsquo;s built-in <b>frets</b> suggestion surface (the silver bars between key rows). <b>The keyboard supplies the candidates</b>; the extension
    only styles the surface. Requires the <code>suggestions:surface</code> permission. The host reads effective values with <code>SuggestionSurfaceSpec.resolved(config)</code>;
    a stored value that does not fit falls back to the declared one. Nothing shows in password, incognito or never-learn fields, with Safe mode, on the Katli board, or while a chip owns the strip.
    With no such extension enabled none of this code runs.
  </p>
  <Rows rows={surfaceRows} label="suggestionSurface keys" />
  <p><code>fromConfig</code> maps a surface field to a config key so the user&rsquo;s option overrides the declared value:</p>
  <Rows rows={fromConfigRows} label="suggestionSurface fromConfig keys" />

  <h3 id="settings-page"><code>settingsPage</code>: option fields</h3>
  <p>Same field objects as the top-level <code>config</code>; both lists are merged. The host renders them in the extension&rsquo;s detail screen.</p>
  <Rows rows={settingsRows} label="settingsPage keys" />

  <h2 id="config">Config fields</h2>
  <p>
    Values are stored per extension (<code>ext.&lt;id&gt;.&lt;key&gt;</code>), validated on every write, and available as <code>{T('{{config.key}}')}</code>. Changing or renaming a
    <code>key</code> orphans the user&rsquo;s saved value.
  </p>
  <Rows rows={fieldRows} label="config field keys" />
  <p>Each <code>options</code> item:</p>
  <Rows rows={optionRows} label="choice option keys" />
  <div class="table-scroll" tabindex="0" role="region" aria-label="Config field types and stored values">
    <table class="dense-table">
      <thead><tr><th scope="col">type</th><th scope="col">Extra</th><th scope="col">Stored value</th></tr></thead>
      <tbody>
        <tr><td><code>toggle</code></td><td><code>default</code> true/false</td><td><code>"true"</code> / <code>"false"</code></td></tr>
        <tr><td><code>choice</code></td><td><code>options</code>: 1 to 24 of <code>{'{value, label}'}</code>; <code>default</code> one of them</td><td>the option&rsquo;s <code>value</code></td></tr>
        <tr><td><code>text</code></td><td><code>default</code>, <code>maxLength</code> 1 to 500 (default 200)</td><td>text</td></tr>
        <tr><td><code>number</code></td><td><code>default</code>, <code>min</code>, <code>max</code></td><td>decimal string</td></tr>
        <tr><td><code>color</code></td><td><code>default</code> <code>#RRGGBB</code></td><td><code>#RRGGBB</code></td></tr>
        <tr><td><code>folder</code></td><td>no default</td><td>a persisted folder grant (system picker); released on change and on uninstall</td></tr>
      </tbody>
    </table>
  </div>

  <h2 id="i18n">i18n</h2>
  <p>
    Locale tags are <code>ll</code> or <code>ll-RR</code> (pattern <code>{schema.properties.i18n.propertyNames.pattern}</code>). The host shows the best match for the interface language
    (<code>pt-BR</code>, then <code>pt</code>), else the top-level values. Only <code>name</code> and <code>description</code> are localised; tab titles and labels are plain strings.
  </p>
  <Rows rows={i18nRows} label="i18n locale entry keys" />

  <h2 id="sandboxed-pages">Sandboxed pages</h2>
  <p>
    A page is an <code>.html</code> file in the package opened by a <code>launchExtensionPage</code> action. JavaScript is on; file and content access, storage, geolocation and popups are off.
    Every request is answered from the package; any other host, scheme or port gets 403. The CSP blocks inline <code>&lt;script&gt;</code>: put code in a <code>.js</code> file.
    The host injects <code>/__clackpad__/bridge.js</code>, defining <code>window.clackpad</code>; calls that need &ldquo;a tap&rdquo; reject unless the user touched the page in the last 1.5 seconds.
    The full bridge table is in Clackpad&rsquo;s <code>docs/EXTENSIONS.md</code>; it is not yet reproduced here.
  </p>

  <h2 id="versioning">Versioning and compatibility</h2>
  <ul>
    <li><code>version</code> is semver; the catalog offers an update only when its version is higher than the installed one. Updates are manual; nothing is fetched in the background.</li>
    <li>Patch for fixes that change no behaviour, minor for new buttons, options or tabs, major when an option&rsquo;s meaning changes or one is removed. A new permission is always at least a minor bump: the update installs switched off until the user accepts it.</li>
    <li><code>minClackpad</code> is a Clackpad <code>versionCode</code>. Set it to the <b>oldest build that has everything you use</b>, not to &ldquo;whatever is current&rdquo;. <code>validate.mjs --host-version N</code> checks your package against build <code>N</code>.</li>
    <li>The manifest <code>schema</code> is <code>clackpad-extension/1</code>. Additive host changes keep <code>/1</code>; anything that changes the meaning of an existing key becomes <code>/2</code> and is never read by older apps.</li>
    <li>Keep the <code>id</code> forever; changing it is a different extension.</li>
  </ul>

  <h2 id="differences">Where the schema and EXTENSIONS.md differ</h2>
  <p>We have not chosen between them silently. These are the places where the prose reference states a rule that the JSON Schema does not express, or states it differently. The validator and the app are authoritative.</p>
  <ul>
    <li><b>Config count.</b> EXTENSIONS.md: at most 24 across <code>config</code> and <code>settingsPage</code>. Schema: <code>config</code> has <code>maxItems 24</code>; <code>settingsPage.fields</code> has no limit.</li>
    <li><b>At least one contribution.</b> EXTENSIONS.md: <code>contributes</code> must declare at least one contribution (or config fields). Schema: <code>contributes</code> is required but may be empty.</li>
    <li><b><code>net:</code> hosts.</b> EXTENSIONS.md: at most 8. Schema: <code>permissions</code> has <code>maxItems 16</code> and no separate cap on <code>net:</code> entries.</li>
    <li><b>Icon size.</b> EXTENSIONS.md: PNG, at most 64 KB. Schema: only the <code>.png</code> suffix.</li>
    <li><b>Package, UI nesting and cross-field rules</b> (permissions needed by template variables, every <code>action</code> naming a declared action, files existing in the package) are validator rules, not schema rules.</li>
    <li><b>Paths.</b> EXTENSIONS.md says <code>clackpad/extensions-sdk/...</code>; in this repository the same SDK is at <code>extensions/sdk/</code>.</li>
  </ul>
</Doc>
