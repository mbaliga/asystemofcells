<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:aarso="https://aarso.dev/bpmn" id="defs_three-voice-debate" targetNamespace="https://aarso.dev/loops">
  <bpmn:process id="three-voice-debate" name="Three-voice debate" isExecutable="false">
    <bpmn:startEvent id="start" name="Objective">
      <bpmn:extensionElements><aarso:meta source="Hand-authored example, docs/design/bpmn-dialect.md" pattern="debate" distilledBy="hand-authored" distilledOn="2026-07-27" summary="Three debaters answer in parallel, exchange, revise for a second round, and a judge decides."/></bpmn:extensionElements>
      <bpmn:outgoing>e_in</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:parallelGateway id="fork" name="Open">
      <bpmn:incoming>e_in</bpmn:incoming>
      <bpmn:incoming>e_loop</bpmn:incoming>
      <bpmn:outgoing>e_f0</bpmn:outgoing>
      <bpmn:outgoing>e_f1</bpmn:outgoing>
      <bpmn:outgoing>e_f2</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="d0" name="Debater 1">
      <bpmn:extensionElements><aarso:meta role="Debater" systemPrompt="Argue your answer in full. After seeing the others, revise or defend it explicitly." diversity="encouraged"/></bpmn:extensionElements>
      <bpmn:incoming>e_f0</bpmn:incoming>
      <bpmn:outgoing>e_j0</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="d1" name="Debater 2">
      <bpmn:extensionElements><aarso:meta role="Debater" systemPrompt="Argue your answer in full. After seeing the others, revise or defend it explicitly." diversity="encouraged"/></bpmn:extensionElements>
      <bpmn:incoming>e_f1</bpmn:incoming>
      <bpmn:outgoing>e_j1</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="d2" name="Debater 3">
      <bpmn:extensionElements><aarso:meta role="Debater" systemPrompt="Argue your answer in full. After seeing the others, revise or defend it explicitly." diversity="encouraged"/></bpmn:extensionElements>
      <bpmn:incoming>e_f2</bpmn:incoming>
      <bpmn:outgoing>e_j2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="join" name="Exchange">
      <bpmn:incoming>e_j0</bpmn:incoming>
      <bpmn:incoming>e_j1</bpmn:incoming>
      <bpmn:incoming>e_j2</bpmn:incoming>
      <bpmn:outgoing>e_more</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:exclusiveGateway id="more" name="More rounds?">
      <bpmn:incoming>e_more</bpmn:incoming>
      <bpmn:outgoing>e_loop</bpmn:outgoing>
      <bpmn:outgoing>e_judge</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="judge" name="Judge">
      <bpmn:extensionElements><aarso:meta role="Judge" systemPrompt="Read the whole exchange and decide the final answer. Say which argument moved you." aggregation="judge"/></bpmn:extensionElements>
      <bpmn:incoming>e_judge</bpmn:incoming>
      <bpmn:outgoing>e_out</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="end" name="Verdict">
      <bpmn:incoming>e_out</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="e_in" sourceRef="start" targetRef="fork"/>
    <bpmn:sequenceFlow id="e_f0" sourceRef="fork" targetRef="d0"/>
    <bpmn:sequenceFlow id="e_j0" sourceRef="d0" targetRef="join"/>
    <bpmn:sequenceFlow id="e_f1" sourceRef="fork" targetRef="d1"/>
    <bpmn:sequenceFlow id="e_j1" sourceRef="d1" targetRef="join"/>
    <bpmn:sequenceFlow id="e_f2" sourceRef="fork" targetRef="d2"/>
    <bpmn:sequenceFlow id="e_j2" sourceRef="d2" targetRef="join"/>
    <bpmn:sequenceFlow id="e_more" sourceRef="join" targetRef="more"/>
    <bpmn:sequenceFlow id="e_loop" sourceRef="more" targetRef="fork" name="another round">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">round &lt; 2</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="e_judge" sourceRef="more" targetRef="judge" name="conclude">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">round == 2</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="e_out" sourceRef="judge" targetRef="end"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="diagram_three-voice-debate">
    <bpmndi:BPMNPlane id="plane_three-voice-debate" bpmnElement="three-voice-debate">
      <bpmndi:BPMNShape id="shape_start" bpmnElement="start">
        <dc:Bounds x="40.0" y="140.0" width="36.0" height="36.0"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_fork" bpmnElement="fork">
        <dc:Bounds x="160.0" y="133.0" width="50.0" height="50.0"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_d0" bpmnElement="d0">
        <dc:Bounds x="320.0" y="20.0" width="130.0" height="64.0"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_d1" bpmnElement="d1">
        <dc:Bounds x="320.0" y="110.0" width="130.0" height="64.0"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_d2" bpmnElement="d2">
        <dc:Bounds x="320.0" y="200.0" width="130.0" height="64.0"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_join" bpmnElement="join">
        <dc:Bounds x="480.0" y="133.0" width="50.0" height="50.0"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_more" bpmnElement="more">
        <dc:Bounds x="608.0" y="133.0" width="50.0" height="50.0"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_judge" bpmnElement="judge">
        <dc:Bounds x="720.0" y="200.0" width="130.0" height="64.0"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_end" bpmnElement="end">
        <dc:Bounds x="896.0" y="140.0" width="36.0" height="36.0"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="edge_e_in" bpmnElement="e_in"/>
      <bpmndi:BPMNEdge id="edge_e_f0" bpmnElement="e_f0"/>
      <bpmndi:BPMNEdge id="edge_e_j0" bpmnElement="e_j0"/>
      <bpmndi:BPMNEdge id="edge_e_f1" bpmnElement="e_f1"/>
      <bpmndi:BPMNEdge id="edge_e_j1" bpmnElement="e_j1"/>
      <bpmndi:BPMNEdge id="edge_e_f2" bpmnElement="e_f2"/>
      <bpmndi:BPMNEdge id="edge_e_j2" bpmnElement="e_j2"/>
      <bpmndi:BPMNEdge id="edge_e_more" bpmnElement="e_more"/>
      <bpmndi:BPMNEdge id="edge_e_loop" bpmnElement="e_loop"/>
      <bpmndi:BPMNEdge id="edge_e_judge" bpmnElement="e_judge"/>
      <bpmndi:BPMNEdge id="edge_e_out" bpmnElement="e_out"/>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
