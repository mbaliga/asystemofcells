<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:aarso="https://aarso.dev/bpmn" id="defs_self-critique" targetNamespace="https://aarso.dev/loops">
  <bpmn:process id="self-critique" name="Self-critique" isExecutable="false">
    <bpmn:startEvent id="start" name="Objective">
      <bpmn:extensionElements><aarso:meta source="Hand-authored example, docs/design/bpmn-dialect.md" pattern="refine-loop" distilledBy="hand-authored" distilledOn="2026-07-27" summary="One model attempts, scores its own attempt, and retries with written feedback until it passes or runs out of trials."/></bpmn:extensionElements>
      <bpmn:outgoing>e_in</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="actor" name="Actor">
      <bpmn:extensionElements><aarso:meta role="Actor" systemPrompt="Attempt the task. Produce a complete answer, not a plan."/></bpmn:extensionElements>
      <bpmn:incoming>e_in</bpmn:incoming>
      <bpmn:incoming>e_loop</bpmn:incoming>
      <bpmn:outgoing>e_ev</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="eval" name="Evaluator">
      <bpmn:extensionElements><aarso:meta role="Evaluator" systemPrompt="Score the attempt against the objective. Name what is wrong before what is right." diversity="encouraged"/></bpmn:extensionElements>
      <bpmn:incoming>e_ev</bpmn:incoming>
      <bpmn:outgoing>e_gw</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="gw" name="Succeeded?">
      <bpmn:incoming>e_gw</bpmn:incoming>
      <bpmn:outgoing>e_yes</bpmn:outgoing>
      <bpmn:outgoing>e_no</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="reflect" name="Reflector">
      <bpmn:extensionElements><aarso:meta role="Reflector" systemPrompt="Write one paragraph of verbal feedback the Actor can act on next attempt." memory="verbal"/></bpmn:extensionElements>
      <bpmn:incoming>e_no</bpmn:incoming>
      <bpmn:outgoing>e_loop</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="end" name="Solution">
      <bpmn:incoming>e_yes</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="e_in" sourceRef="start" targetRef="actor"/>
    <bpmn:sequenceFlow id="e_ev" sourceRef="actor" targetRef="eval"/>
    <bpmn:sequenceFlow id="e_gw" sourceRef="eval" targetRef="gw"/>
    <bpmn:sequenceFlow id="e_yes" sourceRef="gw" targetRef="end" name="yes">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">evaluation == success</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="e_no" sourceRef="gw" targetRef="reflect" name="no">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">evaluation == fail</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="e_loop" sourceRef="reflect" targetRef="actor" name="retry">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">trials &lt; 3</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="diagram_self-critique">
    <bpmndi:BPMNPlane id="plane_self-critique" bpmnElement="self-critique">
      <bpmndi:BPMNShape id="shape_start" bpmnElement="start">
        <dc:Bounds x="40.0" y="140.0" width="36.0" height="36.0"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_actor" bpmnElement="actor">
        <dc:Bounds x="160.0" y="110.0" width="130.0" height="64.0"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_eval" bpmnElement="eval">
        <dc:Bounds x="320.0" y="110.0" width="130.0" height="64.0"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_gw" bpmnElement="gw">
        <dc:Bounds x="480.0" y="133.0" width="50.0" height="50.0"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_reflect" bpmnElement="reflect">
        <dc:Bounds x="320.0" y="200.0" width="130.0" height="64.0"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_end" bpmnElement="end">
        <dc:Bounds x="640.0" y="140.0" width="36.0" height="36.0"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="edge_e_in" bpmnElement="e_in"/>
      <bpmndi:BPMNEdge id="edge_e_ev" bpmnElement="e_ev"/>
      <bpmndi:BPMNEdge id="edge_e_gw" bpmnElement="e_gw"/>
      <bpmndi:BPMNEdge id="edge_e_yes" bpmnElement="e_yes"/>
      <bpmndi:BPMNEdge id="edge_e_no" bpmnElement="e_no"/>
      <bpmndi:BPMNEdge id="edge_e_loop" bpmnElement="e_loop"/>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
