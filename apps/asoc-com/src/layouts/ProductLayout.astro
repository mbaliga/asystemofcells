---
/*
 * The product page shell.
 *
 * It holds no product content of its own. What a given page contains, and in
 * what order, comes from src/lib/productPages.js; this file only maps block
 * types to components, renders the chrome, and puts the page slot where the
 * composition says it goes. That split is the point: the previous version was a
 * fixed hero + two house feature rows + a house FAQ, so all fourteen products
 * were the same page with the nouns changed.
 *
 * Removed here, deliberately: the .screen-crop gradient stand-ins (they were
 * CSS pretending to be screenshots), the .pending-note block, the two rows of
 * house boilerplate, and the three FAQ items that are already on /faq verbatim.
 *
 * Visual system lives in src/styles/product.css, one type scale and one rhythm
 * for every block component.
 */
import BaseLayout from './BaseLayout.astro'
import { getPageBlocks, getJsonLd, displayName } from '../lib/productPages.js'
import ProductHero from '../components/product/ProductHero.astro'
import Statement from '../components/product/Statement.astro'
import ArtPlate from '../components/product/ArtPlate.astro'
import CardGrid from '../components/product/CardGrid.astro'
import FactsRow from '../components/product/FactsRow.astro'
import LinksRow from '../components/product/LinksRow.astro'
import TokenGrid from '../components/product/TokenGrid.astro'
import TypeSpecimen from '../components/product/TypeSpecimen.astro'
import RoundGallery from '../components/product/RoundGallery.astro'
import '../styles/product.css'

const BLOCK = {
  hero: ProductHero,
  statement: Statement,
  art: ArtPlate,
  cards: CardGrid,
  facts: FactsRow,
  links: LinksRow,
  tokens: TokenGrid,
  specimen: TypeSpecimen,
  gallery: RoundGallery,
}

const { cell, title: pageTitle, description } = Astro.props
const name = displayName(cell.slug)
const blocks = getPageBlocks(cell)
const jsonLd = getJsonLd(cell)

// A product with its own scoped privacy policy (roster privacyUrl, e.g. Nooz's
// /nooz/privacy) links to that; everyone else shares the site-wide policy.
const privacyHref = cell.privacyUrl || '/privacy'

// Astro renders <slot /> where it is written, so the block list is split at the
// slot marker rather than looped over with a slot inside the loop.
const slotAt = blocks.findIndex((b) => b.type === 'slot')
const before = slotAt === -1 ? blocks : blocks.slice(0, slotAt)
const after = slotAt === -1 ? [] : blocks.slice(slotAt + 1)

// The back link sits over whatever the first section is, so it needs to know
// whether that section is dark before it picks a colour.
const topTone = blocks[0]?.tone || 'bg'

// Landmark note. BaseLayout only wraps its slot in <main id="main"> on the
// chrome path, and a product page takes the noChrome path, so this file
// declares the landmark and the skip link itself: exactly one <main> per page,
// the footer outside it so the contentinfo landmark is not nested inside the
// main one, and a skip target that is a real id rather than a bare '#'.
---
<BaseLayout
  title={pageTitle || `${name}: asystemofcells`}
  description={description || cell.oneLiner}
  canonical={`https://asystemofcells.com/${cell.slug}`}
  jsonLd={jsonLd}
  analytics
  noChrome
>
  <!-- The reveal-on-scroll hidden state is gated on this class, and the class is
       only set when IntersectionObserver exists. If the script never runs, or
       the browser is too old, .rv elements are simply visible. -->
  <script is:inline>
    if ('IntersectionObserver' in window) document.documentElement.classList.add('js-reveal')
  </script>

  <div class="product-page" data-top={topTone} style={`--accent:${cell.accent};`}>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="back-wrap wrap">
      <a class="back-link" href="/">&larr; asystemofcells</a>
    </div>

    <main id="main">
      {before.map((block) => {
        const Block = BLOCK[block.type]
        return Block ? <Block {...block} /> : null
      })}

      <slot />

      {after.map((block) => {
        const Block = BLOCK[block.type]
        return Block ? <Block {...block} /> : null
      })}
    </main>

    <footer class="site-foot">
      <div class="wrap foot-simple">
        <a class="foot-brand-name" href="/">asystemofcells</a>
        <nav class="foot-links">
          <a href="/about">About</a>
          <a href="/faq">FAQ</a>
          <a href={privacyHref}>Privacy policy</a>
          <a href="/contact">Contact</a>
        </nav>
        <span class="foot-rights">&copy; 2026 asystemofcells</span>
      </div>
    </footer>
  </div>

  <script is:inline>
    // Runs after the markup above is parsed, so there is no DOMContentLoaded
    // wait. Kept inline rather than bundled: if a bundled module failed to
    // load, every .rv element would stay at opacity 0 with no way back.
    ;(function () {
      if (!('IntersectionObserver' in window)) return
      var io = new IntersectionObserver(
        function (entries) {
          entries.forEach(function (entry) {
            if (!entry.isIntersecting) return
            entry.target.classList.add('in')
            io.unobserve(entry.target)
          })
        },
        { rootMargin: '0px 0px -8% 0px', threshold: 0.05 },
      )
      document.querySelectorAll('.product-page .rv').forEach(function (el) {
        io.observe(el)
      })
    })()
  </script>
</BaseLayout>
