---
// Structural pattern ported from the confirmed apple_style_reconstruction6.html
// reference (its "category" style-pages: music/fitness/arcade/tv/news/podcasts/
// books) — hero, alternating feature rows, FAQ, fixed simple footer. That file's
// own comment marks this as a DISTINCT visual system from the home carousel
// (Apple-native -apple-system stack, #fff surface), so this deliberately does
// NOT reuse home's Playfair/Space Mono/Archivo warm-card language, and does NOT
// reuse the old dark-violet Hyle kit components (SiteHeader/SiteFooter/CellCard) —
// those were the invented system the owner already rejected once for this site.
import BaseLayout from './BaseLayout.astro'
import { ctaLabel } from '@asoc/roster'

const { cell, title: pageTitle, description } = Astro.props
const TISSUE_LABEL = {
  'daily-cells': 'Daily cells',
  'ambient-cells': 'Ambient cells',
  'maker-cells': 'Maker cells',
  'connective-tissue': 'Connective tissue',
}
const displayName = cell.slug.split('-').map(w => w[0].toUpperCase() + w.slice(1)).join(' ')
const eyebrow = TISSUE_LABEL[cell.tissue] || cell.tissue
const cta = ctaLabel(cell.status)
const href = cell.hubUrl || '#'
const external = !!cell.hubUrl

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: displayName,
  applicationCategory: 'MobileApplication',
  operatingSystem: 'Android',
  description: cell.oneLiner,
}
---
<BaseLayout
  title={pageTitle || `${displayName}: a system of cells`}
  description={description || cell.oneLiner}
  canonical={`https://asystemofcells.com/${cell.slug}`}
  jsonLd={jsonLd}
  noChrome
>
  <div class="product-page" style={`--tile-1:${cell.accent}; --tile-2:color-mix(in srgb, ${cell.accent} 60%, black);`}>
    <a class="back-link" href="/">&larr; a system of cells</a>

    <section class="hero">
      <div class="hero-bg">
        <div class="hero-frame f1"></div>
        <div class="hero-frame f2"></div>
      </div>
      <div class="hero-content">
        <p class="eyebrow">{eyebrow}</p>
        <h1>{displayName}</h1>
        <p class="tagline">{cell.oneLiner}</p>
        <div class="btn-row">
          <a class="btn-primary" href={href} target={external ? '_blank' : undefined} rel={external ? 'noopener noreferrer' : undefined}>{cta}</a>
        </div>
        <span class={`status-pill status-pill--${cell.status}`}>{cell.status}</span>
      </div>
    </section>

    <slot />

    <section class="feature">
      <div class="wrap feature-grid">
        <div>
          <div class="f-eyebrow">On-device, always the default</div>
          <h2>Nothing runs in a cloud you did not choose.</h2>
          <p>Every app in this house computes on your phone first. Cloud is opt-in per use, never a hidden fallback, and every cloud provider is marked as what it is: a watched object.</p>
        </div>
        <div class="feature-visual"><div class="screen-crop" style="background:var(--tile-1)"></div></div>
      </div>
    </section>
    <section class="feature reverse">
      <div class="wrap feature-grid">
        <div>
          <div class="f-eyebrow">Zero telemetry</div>
          <h2>No analytics, no cookies, no trackers. Ever.</h2>
          <p>Not a setting you have to find and turn off. It was never wired in, in this app or anywhere else in the house.</p>
        </div>
        <div class="feature-visual"><div class="screen-crop" style="background:var(--tile-2)"></div></div>
      </div>
    </section>

    {cell.verify && cell.verify.length > 0 && (
      <section class="pending-note">
        <div class="wrap">
          <p><strong>Still filling this page in.</strong> {cell.verify.join(' · ')}</p>
        </div>
      </section>
    )}

    <section class="faq">
      <div class="wrap">
        <h2>Questions? Answers.</h2>
        <div class="faq-list">
          <div class="qa"><button class="q" type="button"><span>Is any of this open source?</span><span class="plus"></span></button><div class="a"><p>Most of the plumbing is. A few engines are licensed underneath free, open clients: the client is the funnel, the engine license is the product.</p></div></div>
          <div class="qa"><button class="q" type="button"><span>Why no tracking, anywhere?</span><span class="plus"></span></button><div class="a"><p>Because every layer being legible, including what leaves the device, is the whole point of this house.</p></div></div>
          <div class="qa"><button class="q" type="button"><span>Do you build for iOS?</span><span class="plus"></span></button><div class="a"><p>Android first. Some categories, like live wallpapers, are not available on iOS at all regardless of intent.</p></div></div>
        </div>
      </div>
    </section>

    <footer class="site-foot">
      <div class="wrap foot-simple">
        <a class="foot-brand-name" href="/">a system of cells</a>
        <nav class="foot-links">
          <a href="/#about">About</a>
          <a href="/#privacy">Privacy policy</a>
          <a href="/#contact">Contact</a>
        </nav>
        <span class="foot-rights">&copy; 2026 a system of cells</span>
      </div>
    </footer>
  </div>
</BaseLayout>

<script>
  document.querySelectorAll('.qa .q').forEach(btn => {
    btn.addEventListener('click', () => btn.closest('.qa')?.classList.toggle('open'))
  })
</script>

<style is:global>
  .product-page{
    --bg:#fff; --ink:#1d1d1f; --muted:#6e6e73; --line:#e4e4e6; --surface:#f5f5f7;
    --dark:#0b0b0c; --dark-ink:#f5f5f7; --dark-muted:#a1a1a6;
    --radius:18px; --ease:cubic-bezier(.4,0,.2,1);
    font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Helvetica,Arial,sans-serif;
    color:var(--ink); background:var(--bg); line-height:1.5; -webkit-font-smoothing:antialiased;
    padding-bottom:88px;
  }
  .product-page .wrap{ max-width:1100px; margin:0 auto; padding-inline:4vw; }
  .product-page a{ color:inherit; }

  .back-link{
    position:absolute; top:20px; left:4vw; z-index:10;
    font-size:13px; font-weight:600; color:var(--dark-ink); text-decoration:none; opacity:.8;
  }
  .back-link:hover{ opacity:1; }

  .hero{
    position:relative; min-height:70vh; display:flex; flex-direction:column;
    align-items:center; justify-content:center; text-align:center;
    background:var(--dark); color:var(--dark-ink); overflow:hidden; padding:10vh 6vw;
  }
  .hero-bg{ position:absolute; inset:0; z-index:0; }
  .hero-frame{ position:absolute; inset:0; opacity:0; animation:heroFade 11s infinite; }
  .hero-frame.f1{ background:linear-gradient(150deg,var(--tile-1), color-mix(in srgb, var(--tile-1) 35%, black)); animation-delay:0s; }
  .hero-frame.f2{ background:linear-gradient(150deg,var(--tile-2), color-mix(in srgb, var(--tile-2) 35%, black)); animation-delay:5.5s; }
  @keyframes heroFade{ 0%{opacity:0} 8%{opacity:1} 42%{opacity:1} 50%{opacity:0} 100%{opacity:0} }
  .hero::after{ content:''; position:absolute; inset:0; z-index:1; background:linear-gradient(0deg, rgba(11,11,12,.7) 0%, rgba(11,11,12,.2) 55%, rgba(11,11,12,.05) 100%); }
  .hero-content{ position:relative; z-index:2; max-width:720px; }
  .hero .eyebrow{ font-size:13px; font-weight:600; color:var(--dark-muted); margin-bottom:12px; text-transform:uppercase; letter-spacing:.04em; }
  .hero h1{ font-size:clamp(2.2rem,6vw,4.4rem); font-weight:600; letter-spacing:-.025em; line-height:1.03; margin-bottom:16px; }
  .hero p.tagline{ font-size:clamp(1rem,1.5vw,1.2rem); color:#d9d9de; max-width:52ch; margin:0 auto 22px; }
  .hero .btn-row{ display:flex; gap:10px; justify-content:center; flex-wrap:wrap; margin-top:4px; }
  .hero .btn-primary{ font-size:14px; font-weight:600; border:none; border-radius:980px; padding:12px 24px; cursor:pointer; display:inline-block; text-decoration:none; background:#fff; color:var(--ink); }
  .status-pill{ display:inline-block; margin-top:18px; font-family:ui-monospace,monospace; font-size:11px; letter-spacing:.08em; text-transform:uppercase; padding:4px 10px; border-radius:999px; border:1px solid rgba(255,255,255,.3); color:var(--dark-muted); }
  .status-pill--live{ color:#3ddc84; border-color:#3ddc84; }
  .status-pill--beta{ color:#08fed5; border-color:#08fed5; }

  .feature{ padding:10vh 0; overflow:hidden; }
  .feature-grid{ display:grid; grid-template-columns:1fr 1fr; gap:6vw; align-items:center; }
  .feature.reverse .feature-grid{ direction:rtl; }
  .feature.reverse .feature-grid > *{ direction:ltr; }
  .feature .f-eyebrow{ font-size:13px; font-weight:600; color:var(--muted); text-transform:uppercase; letter-spacing:.04em; margin-bottom:12px; }
  .feature h2{ font-size:clamp(1.5rem,3vw,2.3rem); font-weight:600; letter-spacing:-.02em; line-height:1.1; margin-bottom:14px; }
  .feature p{ font-size:15px; color:var(--muted); max-width:44ch; line-height:1.6; }
  .feature-visual{ display:flex; justify-content:center; }
  .screen-crop{ width:100%; max-width:280px; aspect-ratio:9/16; border-radius:28px; margin-inline:auto; box-shadow:0 30px 60px -26px rgba(0,0,0,.4); opacity:.85; }

  .pending-note{ padding:2vh 0 6vh; }
  .pending-note .wrap{ background:var(--surface); border:1px dashed var(--line); border-radius:var(--radius); padding:16px 20px; }
  .pending-note p{ margin:0; font-size:13px; color:var(--muted); }

  .faq{ background:var(--surface); padding:10vh 0; }
  .faq h2{ font-size:clamp(1.5rem,3vw,2.2rem); font-weight:600; letter-spacing:-.02em; margin-bottom:5vh; text-align:center; }
  .faq-list{ max-width:760px; margin:0 auto; }
  .qa{ border-top:1px solid var(--line); }
  .qa:last-child{ border-bottom:1px solid var(--line); }
  .qa button.q{ width:100%; display:flex; align-items:center; justify-content:space-between; gap:16px; background:none; border:none; text-align:left; padding:18px 4px; cursor:pointer; font-size:15px; font-weight:500; color:var(--ink); }
  .qa .plus{ flex:0 0 auto; width:18px; height:18px; position:relative; }
  .qa .plus::before, .qa .plus::after{ content:''; position:absolute; background:var(--ink); transition:transform .3s var(--ease); }
  .qa .plus::before{ top:50%; left:0; width:100%; height:1.6px; transform:translateY(-50%); }
  .qa .plus::after{ left:50%; top:0; height:100%; width:1.6px; transform:translateX(-50%); }
  .qa.open .plus::after{ transform:translateX(-50%) rotate(90deg); opacity:0; }
  .qa .a{ max-height:0; overflow:hidden; transition:max-height .4s var(--ease); }
  .qa.open .a{ max-height:200px; }
  .qa .a p{ padding:0 4px 18px; color:var(--muted); font-size:14px; line-height:1.6; max-width:60ch; }

  .site-foot{
    position:fixed; left:0; right:0; bottom:0; z-index:60;
    height:52px; overflow:hidden; background:var(--bg); border-top:1px solid var(--line);
  }
  .site-foot .wrap{ height:100%; display:flex; align-items:center; }
  .foot-simple{ width:100%; display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:16px; }
  .foot-brand-name{ font-size:15px; font-weight:600; letter-spacing:-.01em; text-decoration:none; color:var(--ink); }
  .foot-links{ display:flex; align-items:center; gap:20px; flex-wrap:wrap; }
  .foot-links a{ font-size:13px; color:var(--muted); text-decoration:none; }
  .foot-links a:hover{ color:var(--ink); }
  .foot-rights{ font-size:12px; color:var(--muted); }

  @media(max-width:820px){
    .feature-grid{ grid-template-columns:1fr; text-align:center; }
    .feature.reverse .feature-grid{ direction:ltr; }
    .feature p{ margin-inline:auto; }
  }
</style>
