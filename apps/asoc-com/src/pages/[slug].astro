---
import ProductLayout from '../layouts/ProductLayout.astro'
import NoozSections from '../components/products/NoozSections.astro'
import { getRoster } from '@asoc/roster'

export function getStaticPaths() {
  return getRoster()
    .filter(cell => !cell.isHub)
    .map(cell => ({ params: { slug: cell.slug }, props: { cell } }))
}

const { cell } = Astro.props
---
<ProductLayout cell={cell}>
  {cell.slug === 'nooz' && <NoozSections />}
</ProductLayout>
