---
import ProductLayout from '../layouts/ProductLayout.astro'
import NoozSections from '../components/products/NoozSections.astro'
import { getRoster } from '@asoc/roster'

export function getStaticPaths() {
  return getRoster()
    .filter(cell => !cell.isHub)
    .map(cell => ({ params: { slug: cell.slug }, props: { cell } }))
}

const { cell } = Astro.props
---
{/* Everything structural about a page lives in src/lib/productPages.js. This
    slot is only for a product whose sections are hand-written markup rather
    than block data, which today means Nooz and its nine screenshot rows;
    productPages.js decides where in the page the slot lands. */}
<ProductLayout cell={cell}>
  {cell.slug === 'nooz' && <NoozSections />}
</ProductLayout>
