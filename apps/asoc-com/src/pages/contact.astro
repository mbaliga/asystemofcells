---
import SimplePageLayout from '../layouts/SimplePageLayout.astro'

const EMAIL = 'support@asystemofcells.com'
---
<SimplePageLayout
  title="Contact: asystemofcells"
  description="Get in touch about asystemofcells apps - bugs, feature requests, or anything else."
  canonical="https://asystemofcells.com/contact"
>
  <p class="eyebrow">Contact</p>
  <h1>Get in touch.</h1>

  <p>
    Bug reports, feature requests, or anything else - email
    <a class="inline-link" href={`mailto:${EMAIL}`}> {EMAIL}</a>.
  </p>
  <p>
    On WhatsApp, the username will be <strong>asystemofcells</strong> once
    WhatsApp makes usernames available. Until then, email is the channel.
  </p>
  <p>
    One address covers every app in the house - there is no separate support
    desk per product.
  </p>
</SimplePageLayout>
