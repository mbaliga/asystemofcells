  /* One group per section: a heading, then its cards (or the honest empty
     line), then a link to the section's own page. */
  .flow-fallback__group {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
    gap: 12px;
    align-content: start;
  }
  .flow-fallback__heading {
    grid-column: 1 / -1;
    margin: 0;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 400;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--home-muted);
  }
  .flow-fallback__empty {
    grid-column: 1 / -1;
