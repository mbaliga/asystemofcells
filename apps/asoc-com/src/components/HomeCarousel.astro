<script type="application/json" id="rosterData" set:html={JSON.stringify(items)} />
<script type="application/json" id="flowLanes" set:html={JSON.stringify({ lanes: LANES, dir: DIR, nrm: NRM, stepH: STEP_H })} />

<script>
  // The conveyor + reel engine. Roster and lane data come in via the JSON
  // islands above so the same numbers the server laid out with drive the
  // motion here.
  const items = JSON.parse(document.getElementById('rosterData').textContent)
  const total = items.length
  const { lanes: LANES, dir: DIR, nrm: NRM, stepH: STEP_H } = JSON.parse(
    document.getElementById('flowLanes').textContent,
  )

  const reducedQuery = window.matchMedia('(prefers-reduced-motion: reduce)')
  const mobileQuery = window.matchMedia('(max-width: 880px)')

  const sceneDesktopEl = document.getElementById('sceneDesktop')
  const sceneMobileEl = document.getElementById('sceneMobile')

  function applyLink(el, item) {
    el.href = item.href
    el.setAttribute('aria-label', `${item.tissue}: ${item.name}`)
    if (item.external) {
      el.setAttribute('target', '_blank')
      el.setAttribute('rel', 'noopener noreferrer')
    } else {
      el.removeAttribute('target')
      el.removeAttribute('rel')
    }
  }

  // ======================================================================
  // Desktop: the conveyor
  // ======================================================================
  const stageEl = document.getElementById('flowStage')
  const cardEls = Array.from(stageEl.querySelectorAll('.flow-card'))
  const focusNameEl = document.getElementById('flowFocusName')

  // One step every 5/7s: the reference's 5s loop is seven steps.
  const PERIOD = 5000 / 7
  // The step's motion profile, as measured off the reference frame by
  // frame (u = fraction of the step elapsed, y = fraction of the move done):
  // a slow start, a whip through the middle (half the distance by u=0.23),
  // then a long settling tail into a hold. Piecewise-linear between these
  // points; the source itself is only 60fps.
  const EASE = [
    [0, 0], [0.05, 0.008], [0.09, 0.03], [0.13, 0.083], [0.18, 0.225], [0.2, 0.35], [0.21, 0.37],
    [0.225, 0.49], [0.235, 0.51], [0.25, 0.6], [0.27, 0.674], [0.28, 0.69], [0.32, 0.785],
    [0.37, 0.855], [0.43, 0.915], [0.47, 0.935], [0.55, 0.978], [0.62, 0.99], [0.7, 0.997],
    [0.8, 1], [1, 1],
  ]
  function easeStep(u) {
    if (u <= 0) return 0
    if (u >= 1) return 1
    let i = 1
    while (EASE[i][0] < u) i++
    const [u0, y0] = EASE[i - 1]
    const [u1, y1] = EASE[i]
    return y0 + ((y1 - y0) * (u - u0)) / (u1 - u0)
  }

  let laneCount = 9
  let cardH = 300
  const laneLap = new Array(LANES.length).fill(null)
  const laneItem = new Array(LANES.length).fill(null)
  let focusedLane = -1
  let swapTimer = null

  // How many lanes this viewport needs: enough that the point where a lane
  // wraps from the far top-left back to the far bottom-right (slot +n/2 ->
  // -n/2) is always past the stage edge plus a card, so the wrap is never
  // seen. Odd, like the reference's seven, and never more lanes than roster
  // items (two lanes would then show the same item at once).
  function layout() {
    const w = stageEl.clientWidth
    const h = stageEl.clientHeight
    cardH = cardEls[0].offsetHeight / LANES[0].scale || cardH
    const halfExtent = (w / 2) * Math.abs(DIR.x) + (h / 2) * Math.abs(DIR.y)
    const need = 2 * Math.ceil((halfExtent + 0.7 * cardH) / (STEP_H * cardH)) + 1
    const n = Math.max(7, Math.min(LANES.length, need, total - (total % 2 === 0 ? 1 : 0)))
    if (n !== laneCount) {
      laneCount = n
      laneLap.fill(null)
    }
    cardEls.forEach((el, k) => {
      el.style.display = k < laneCount ? '' : 'none'
    })
  }

  function setFocus(k) {
    focusedLane = k
    const name = laneItem[k].name
    focusNameEl.classList.add('is-swapping')
    clearTimeout(swapTimer)
    swapTimer = setTimeout(() => {
      focusNameEl.textContent = name
      focusNameEl.classList.remove('is-swapping')
    }, 150)
  }

  // s = the train's progress in slots (whole steps taken + the eased
  // fraction of the current one). Lane k sits at slot -k (+ its nudge) + s,
  // wrapped into [-n/2, n/2); each time it wraps (off-screen, far top-left
  // to far bottom-right) it takes the next roster item, n further on, so
  // the centre slot sees the roster in order and no two lanes share an item.
  function render(s) {
    const n = laneCount
    let bestK = 0
    let bestAbs = Infinity
    for (let k = 0; k < n; k++) {
      const L = LANES[k]
      const el = cardEls[k]
      const raw = -k + L.frac + s
      const lap = Math.floor((raw + n / 2) / n)
      const along = raw - lap * n
      if (lap !== laneLap[k]) {
        laneLap[k] = lap
        const item = items[(((k + lap * n) % total) + total) % total]
        laneItem[k] = item
        applyLink(el, item)
        el.style.setProperty('--accent', item.color)
      }
      el.style.setProperty('--kx', (STEP_H * along * DIR.x + L.lat * NRM.x).toFixed(4))
      el.style.setProperty('--ky', (STEP_H * along * DIR.y + L.lat * NRM.y).toFixed(4))
      el.style.setProperty('--r', `${(L.tilt + L.rate * along).toFixed(2)}deg`)
      const a = Math.abs(along)
      if (a < bestAbs) {
        bestAbs = a
        bestK = k
      }
    }
    if (bestK !== focusedLane) setFocus(bestK)
  }

  // One clock for the whole train. It only advances while the conveyor is
  // actually the thing on screen, nothing is hovered, and the tab is
  // visible - so hovering freezes every lane together (a moving target
  // can't be clicked; a train that keeps going around a frozen card would
  // break the rigid pattern), and a backgrounded tab resumes where it
  // stopped rather than jumping ahead.
  let elapsed = 0
  let lastTs = null
  let hoverPaused = false
  let rafId = 0
  function frame(ts) {
    if (lastTs != null) {
      const dt = ts - lastTs
      if (!hoverPaused && !document.hidden && dt < 500) elapsed += dt
    }
    lastTs = ts
    const steps = Math.floor(elapsed / PERIOD)
    render(steps + easeStep((elapsed - steps * PERIOD) / PERIOD))
    rafId = requestAnimationFrame(frame)
  }
  function conveyorShouldRun() {
    return !mobileQuery.matches && !reducedQuery.matches
  }
  function startConveyor() {
    if (rafId) return
    layout()
    lastTs = null
    rafId = requestAnimationFrame(frame)
  }
  function stopConveyor() {
    if (!rafId) return
    cancelAnimationFrame(rafId)
    rafId = 0
  }
  function syncConveyor() {
    if (conveyorShouldRun()) startConveyor()
    else stopConveyor()
  }

  stageEl.addEventListener('pointerover', (e) => {
    hoverPaused = !!e.target.closest('.flow-card')
  })
  stageEl.addEventListener('pointerleave', () => {
    hoverPaused = false
  })
  new ResizeObserver(() => {
    if (rafId) layout()
  }).observe(stageEl)

  // ======================================================================
  // Mobile: the reel, and the drop it runs through
  // ======================================================================
  const reelEl = document.getElementById('reel')
  const trackEl = document.getElementById('reelTrack')
  const cellCanvas = document.getElementById('reelCell')
  const cellCtx = cellCanvas.getContext('2d')
  const bgAEl = document.getElementById('reelBgA')
  const bgBEl = document.getElementById('reelBgB')

  // Three copies of the list so the stack wraps seamlessly: the middle copy
  // is the real one (real links, in the tab order); the copies either side
  // are decorative clones the position slides through before being shifted
  // back a whole copy - which is invisible, since the copies are identical.
  const baseSlots = Array.from(trackEl.children)
  function cloneSlot(el) {
    const c = el.cloneNode(true)
    c.setAttribute('aria-hidden', 'true')
    c.classList.remove('is-near')
    c.querySelectorAll('a').forEach((a) => {
      a.tabIndex = -1
    })
    return c
  }
  trackEl.prepend(...baseSlots.map(cloneSlot))
  trackEl.append(...baseSlots.map(cloneSlot))
  const slotEls = Array.from(trackEl.children)

  // Reference: one name every 1.25s.
  const REEL_PERIOD = 1250
  // The list's spring, in slot units: stiff enough to arrive in well under
  // a second, damped past critical so it never overshoots - it pours into
  // place rather than snapping. (zeta > 1 = overdamped.)
  const LIST_K = 34
  const LIST_ZETA = 1.12
  // While a finger is down the list chases it through a low-pass, not
  // 1:1 - that lag is the viscosity you feel.
  const DRAG_FOLLOW = 9

  let pitch = 140
  let pos = total // continuous position, in slots; the centre line sits on slot `pos`
  let target = total
  let vel = 0
  let near = -1
  let bgVisible = bgAEl
  let bgItem = null
  let interactUntil = 0
  let lastAuto = 0
  let reelRaf = 0
  let reelLast = null
  let paintedLo = 0
  let paintedHi = -1

  // --- the drop: a soft-body membrane ----------------------------------
  // A ring of points, each on a spring to its rest position on an ellipse
  // wrapped around the centre name, sprung to its neighbours so the skin
  // stays smooth, underdamped so it wobbles a couple of times before it
  // settles, and dragged by the list's velocity - most at the top and
  // bottom, where the passing names pull on it - so it stretches along
  // with them and springs back. The ellipse's width chases each new
  // centre name, so the drop re-wraps rather than jumps.
  const CELL_N = 28
  const CELL_K = 180
  const CELL_KN = 120
  const CELL_C = 2 * 0.3 * Math.sqrt(CELL_K)
  const CELL_DRAG = 5.5
  const cell = Array.from({ length: CELL_N }, () => ({ x: 0, y: 0, vx: 0, vy: 0 }))
  let cellA = 90
  let cellB = 32
  let cellATarget = 90
  let cellBTarget = 32
  let cellAccent = items[0].color
  let cellTime = 0
  let cellDpr = 1

  function layoutReel() {
    pitch = reelEl.clientHeight / 6
    trackEl.style.setProperty('--pitch', `${pitch}px`)
    cellDpr = Math.min(2, window.devicePixelRatio || 1)
    const w = reelEl.clientWidth
    const h = pitch * 3
    cellCanvas.width = Math.round(w * cellDpr)
    cellCanvas.height = Math.round(h * cellDpr)
    cellCanvas.style.height = `${h}px`
    cellCtx.setTransform(cellDpr, 0, 0, cellDpr, 0, 0)
    // Rest shape from the centre name's real box.
    fitCell()
  }

  function fitCell() {
    const slot = slotEls[near]
    const name = slot && slot.querySelector('.pill__name')
    if (!name) return
    const r = name.getBoundingClientRect()
    cellATarget = r.width / 2 + Math.max(22, pitch * 0.18)
    cellBTarget = r.height / 2 + Math.max(14, pitch * 0.12)
  }

  function hexToRgb(hex) {
    const h = hex.replace('#', '')
    const n = parseInt(h.length === 3 ? h.replace(/./g, (c) => c + c) : h, 16)
    return [(n >> 16) & 255, (n >> 8) & 255, n & 255]
  }

  function stepCell(dt, listVelPx, animate) {
    cellTime += dt
    cellA += (cellATarget - cellA) * (1 - Math.exp(-dt * 7))
    cellB += (cellBTarget - cellB) * (1 - Math.exp(-dt * 7))
    for (let i = 0; i < CELL_N; i++) {
      const th = (i / CELL_N) * Math.PI * 2
      const c = Math.cos(th)
      const s = Math.sin(th)
      const r = (cellA * cellB) / Math.sqrt(cellB * cellB * c * c + cellA * cellA * s * s)
      const breathe = animate ? 1 + 0.022 * Math.sin(cellTime * 1.1 + th * 3) + 0.014 * Math.sin(cellTime * 1.9 - th * 2) : 1
      const rx = r * c * breathe
      const ry = r * s * breathe + (s > 0 ? 5 * s * s : 0) // a little sag at the bottom
      const p = cell[i]
      const prev = cell[(i + CELL_N - 1) % CELL_N]
      const next = cell[(i + 1) % CELL_N]
      let fx = CELL_K * (rx - p.x) + CELL_KN * ((prev.x + next.x) / 2 - p.x) - CELL_C * p.vx
      let fy = CELL_K * (ry - p.y) + CELL_KN * ((prev.y + next.y) / 2 - p.y) - CELL_C * p.vy
      if (animate) fy -= CELL_DRAG * listVelPx * (0.35 + 0.65 * Math.abs(s))
      p.vx += fx * dt
      p.vy += fy * dt
      p.x += p.vx * dt
      p.y += p.vy * dt
    }
  }

  function drawCell() {
    const w = cellCanvas.width / cellDpr
    const h = cellCanvas.height / cellDpr
    const cx = w / 2
    const cy = h / 2
    const ctx = cellCtx
    ctx.clearRect(0, 0, w, h)
    ctx.beginPath()
    for (let i = 0; i < CELL_N; i++) {
      const p0 = cell[(i + CELL_N - 1) % CELL_N]
      const p1 = cell[i]
      const p2 = cell[(i + 1) % CELL_N]
      const p3 = cell[(i + 2) % CELL_N]
      if (i === 0) ctx.moveTo(cx + p1.x, cy + p1.y)
      ctx.bezierCurveTo(
        cx + p1.x + (p2.x - p0.x) / 6,
        cy + p1.y + (p2.y - p0.y) / 6,
        cx + p2.x - (p3.x - p1.x) / 6,
        cy + p2.y - (p3.y - p1.y) / 6,
        cx + p2.x,
        cy + p2.y,
      )
    }
    ctx.closePath()
    const [ar, ag, ab] = hexToRgb(cellAccent)
    // Body: a translucent film with a key light from the upper-left and
    // the accent gathering at the lower-right edge - the name reads through
    // it. Drawn with a soft shadow so it sits on the backdrop.
    ctx.save()
    ctx.shadowColor = 'rgba(0, 0, 0, 0.3)'
    ctx.shadowBlur = 26
    ctx.shadowOffsetY = 10
    const body = ctx.createRadialGradient(cx - cellA * 0.4, cy - cellB * 0.7, 0, cx, cy, cellA * 1.25)
    body.addColorStop(0, 'rgba(255, 255, 255, 0.22)')
    body.addColorStop(0.42, 'rgba(255, 255, 255, 0.09)')
    body.addColorStop(1, `rgba(${ar}, ${ag}, ${ab}, 0.3)`)
    ctx.fillStyle = body
    ctx.fill()
    ctx.restore()
    // Meniscus: a soft, diffuse rim - wet, not glass.
    ctx.save()
    ctx.clip()
    ctx.shadowColor = 'rgba(255, 255, 255, 0.35)'
    ctx.shadowBlur = 14
    ctx.lineWidth = 1.6
    ctx.strokeStyle = 'rgba(255, 255, 255, 0.24)'
    ctx.stroke()
    // Depth: the underside darkens.
    const under = ctx.createRadialGradient(cx, cy + cellB * 0.9, 0, cx, cy + cellB * 0.6, cellA * 0.95)
    under.addColorStop(0, 'rgba(0, 0, 0, 0.18)')
    under.addColorStop(1, 'rgba(0, 0, 0, 0)')
    ctx.fillStyle = under
    ctx.fillRect(0, 0, w, h)
    // Specular: one soft, spread highlight, upper-left, off the letters.
    ctx.shadowColor = 'rgba(255, 255, 255, 0.5)'
    ctx.shadowBlur = 16
    ctx.fillStyle = 'rgba(255, 255, 255, 0.3)'
    ctx.beginPath()
    ctx.ellipse(cx - cellA * 0.5, cy - cellB * 0.48, cellA * 0.22, cellB * 0.17, -0.35, 0, Math.PI * 2)
    ctx.fill()
    ctx.restore()
  }

  // --- the list ----------------------------------------------------------
  function setBackdrop(item) {
    if (item === bgItem) return
    bgItem = item
    cellAccent = item.color
    const show = bgVisible === bgAEl ? bgBEl : bgAEl
    show.style.setProperty('--bg-accent', item.color)
    show.style.opacity = '1'
    bgVisible.style.opacity = '0'
    bgVisible = show
  }

  function setNear(n) {
    if (n === near) return
    if (near >= 0) slotEls[near].classList.remove('is-near')
    near = n
    slotEls[n].classList.add('is-near')
    setBackdrop(items[((n % total) + total) % total])
    fitCell()
  }

  function opacityFor(d) {
    if (d <= 1) return 1 - 0.5 * d
    if (d <= 4) return 0.5 - 0.12 * (d - 1)
    return 0.12
  }

  function paintList() {
    const lo = Math.max(0, Math.floor(pos) - 6)
    const hi = Math.min(slotEls.length - 1, Math.ceil(pos) + 6)
    for (let i = paintedLo; i <= paintedHi; i++) if (i < lo || i > hi) slotEls[i].style.opacity = ''
    for (let i = lo; i <= hi; i++) slotEls[i].style.opacity = opacityFor(Math.abs(i - pos)).toFixed(3)
    paintedLo = lo
    paintedHi = hi
    trackEl.style.transform = `translateY(${(-(pos + 0.5) * pitch).toFixed(2)}px)`
  }

  // Keep pos inside the middle copy by shifting a whole copy at a time -
  // the copies are identical, so this never shows.
  function wrapPos() {
    if (pos >= 2 * total) {
      pos -= total
      target -= total
      dragStartPos -= total
      if (near >= 0) setNear(near - total)
    } else if (pos < total) {
      pos += total
      target += total
      dragStartPos += total
      if (near >= 0) setNear(near + total)
    }
  }

  let dragging = false
  let dragStartY = 0
  let dragStartPos = 0
  let dragY = 0
  let dragPrevY = 0
  let dragPrevT = 0
  let dragVel = 0 // px per ms, screen-down positive
  let suppressClick = false

  function reelFrame(ts) {
    reelRaf = requestAnimationFrame(reelFrame)
    if (reelLast == null) reelLast = ts
    const dt = Math.min(0.05, (ts - reelLast) / 1000)
    reelLast = ts
    const animate = !reducedQuery.matches
    if (!document.hidden && animate && !dragging && ts > interactUntil && ts - lastAuto > REEL_PERIOD) {
      target += 1
      lastAuto = ts
    }
    if (dragging) {
      const want = dragStartPos + (dragStartY - dragY) / pitch
      vel = (want - pos) * DRAG_FOLLOW
      pos += vel * dt
    } else {
      const c = 2 * LIST_ZETA * Math.sqrt(LIST_K)
      vel += (LIST_K * (target - pos) - c * vel) * dt
      pos += vel * dt
      if (Math.abs(target - pos) < 0.0005 && Math.abs(vel) < 0.002) {
        pos = target
        vel = 0
      }
    }
    wrapPos()
    setNear(Math.round(pos))
    paintList()
    stepCell(dt, vel * pitch, animate)
    drawCell()
  }

  function startReel() {
    if (reelRaf) return
    layoutReel()
    reelLast = null
    lastAuto = performance.now()
    reelRaf = requestAnimationFrame(reelFrame)
  }
  function stopReel() {
    if (!reelRaf) return
    cancelAnimationFrame(reelRaf)
    reelRaf = 0
  }

  function touched(ts) {
    interactUntil = ts + 4000
    lastAuto = interactUntil - REEL_PERIOD + 700
  }

  // Swipes drive the list by hand (touch-action: none on .reel hands every
  // vertical drag to these instead of the page): while the finger is down
  // the list follows it with lag; on release it settles onto the nearest
  // slot, or one further along if the finger was still moving. A tap still
  // clicks the name's link; a drag that ends on one must not.
  // No pointer capture here: a captured pointer's click lands on the
  // capturing element, which would swallow a tap on a name's link. The
  // window-level listeners catch a finger that lifts off the reel instead.
  reelEl.addEventListener('pointerdown', (e) => {
    dragging = true
    dragStartY = dragY = dragPrevY = e.clientY
    dragStartPos = pos
    dragPrevT = e.timeStamp
    dragVel = 0
    touched(performance.now())
  })
  window.addEventListener('pointermove', (e) => {
    if (!dragging) return
    dragY = e.clientY
    const dtms = e.timeStamp - dragPrevT
    if (dtms > 0) dragVel = (dragY - dragPrevY) / dtms
    dragPrevY = dragY
    dragPrevT = e.timeStamp
  })
  function endDrag() {
    if (!dragging) return
    dragging = false
    const moved = dragStartY - dragY
    // Throw: a still-moving finger carries it one more slot at most - thick
    // liquid doesn't fling - and a finger that paused before lifting
    // carries nothing (its last measured velocity is stale).
    if (performance.now() - dragPrevT > 80) dragVel = 0
    const carry = Math.max(-1, Math.min(1, (-dragVel * 1000) / pitch / 6))
    const base = Math.round(pos)
    target = Math.max(base - 1, Math.min(base + 1, Math.round(pos + carry)))
    suppressClick = Math.abs(moved) > 10
    touched(performance.now())
  }
  window.addEventListener('pointerup', endDrag)
  window.addEventListener('pointercancel', endDrag)
  reelEl.addEventListener(
    'click',
    (e) => {
      if (suppressClick) {
        e.preventDefault()
        suppressClick = false
      }
    },
    true,
  )
  let wheelAcc = 0
  let wheelLock = 0
  reelEl.addEventListener(
    'wheel',
    (e) => {
      e.preventDefault()
      const now = performance.now()
      touched(now)
      if (now < wheelLock) return
      wheelAcc += e.deltaY
      if (Math.abs(wheelAcc) > 40) {
        target = Math.round(pos) + (wheelAcc > 0 ? 1 : -1)
        wheelAcc = 0
        wheelLock = now + 450
      }
    },
    { passive: false },
  )
  // Keyboard: tabbing onto a name centres it and holds the auto-advance.
  trackEl.addEventListener('focusin', (e) => {
    const slot = e.target.closest('.pill-slot')
    if (!slot || slot.getAttribute('aria-hidden') === 'true') return
    interactUntil = performance.now() + 6000
    lastAuto = interactUntil
    target = total + Number(slot.dataset.index)
  })
  new ResizeObserver(() => {
    if (reelRaf) layoutReel()
  }).observe(reelEl)

  // ======================================================================
  // Which scene is live
  // ======================================================================
  function syncScenes() {
    const isMobile = mobileQuery.matches
    sceneDesktopEl.setAttribute('aria-hidden', String(isMobile))
    sceneMobileEl.setAttribute('aria-hidden', String(!isMobile))
    syncConveyor()
    if (isMobile) startReel()
    else stopReel()
  }
  mobileQuery.addEventListener('change', syncScenes)
  reducedQuery.addEventListener('change', syncScenes)
  document.addEventListener('visibilitychange', () => {
    if (!document.hidden) {
      lastTs = null
      reelLast = null
    }
  })
  syncScenes()
</script>

<script>
  // Search - client-side fuzzy match over the same roster data, no backend.
  // No server, no third-party API - Fuse.js fuzzy-matches the roster data
  // that's already bundled into this page at build time, entirely client-side.
  import Fuse from 'fuse.js'

  const items = JSON.parse(document.getElementById('rosterData').textContent)

  const searchBtn = document.getElementById('homeSearchBtn')
  const searchOverlay = document.getElementById('searchOverlay')
  const searchInput = document.getElementById('searchInput')
  const searchResultsEl = document.getElementById('searchResults')
  const searchCloseBtn = document.getElementById('searchClose')

  const fuse = new Fuse(items, {
    keys: [
      { name: 'name', weight: 2 },
      { name: 'tissue', weight: 1 },
      { name: 'oneLiner', weight: 1 },
    ],
    threshold: 0.35,
    ignoreLocation: true,
  })

  let activeIndex = -1

  function renderResults(query) {
    const results = query.trim() ? fuse.search(query, { limit: 8 }).map((r) => r.item) : items.slice(0, 8)
    activeIndex = -1
    if (results.length === 0) {
      searchResultsEl.innerHTML = `<li class="search-empty">No apps match "${query}"</li>`
      return
    }
    searchResultsEl.innerHTML = results
      .map(
        (it, i) => `
      <li>
        <a class="search-result" data-index="${i}" href="${it.href}"${it.external ? ' target="_blank" rel="noopener noreferrer"' : ''}>
          <span class="search-result-swatch" style="background:${it.color}"></span>
          <span class="search-result-text">
            <span class="search-result-name">${it.name}</span>
            <span class="search-result-meta">${it.tissue} &middot; ${it.status}</span>
          </span>
        </a>
      </li>`,
      )
      .join('')
  }

  function openSearch() {
    searchOverlay.classList.add('open')
    searchOverlay.setAttribute('aria-hidden', 'false')
    renderResults('')
    searchInput.value = ''
    searchInput.focus()
  }

  function closeSearch() {
    searchOverlay.classList.remove('open')
    searchOverlay.setAttribute('aria-hidden', 'true')
    searchBtn.focus()
  }

  searchBtn.addEventListener('click', openSearch)
  searchCloseBtn.addEventListener('click', closeSearch)
  searchOverlay.addEventListener('click', (e) => {
    if (e.target === searchOverlay) closeSearch()
  })
  searchInput.addEventListener('input', () => renderResults(searchInput.value))

  document.addEventListener('keydown', (e) => {
    if ((e.key === '/' || (e.key === 'k' && (e.metaKey || e.ctrlKey))) && !searchOverlay.classList.contains('open')) {
      const tag = document.activeElement?.tagName
      if (tag === 'INPUT' || tag === 'TEXTAREA') return
      e.preventDefault()
      openSearch()
    } else if (e.key === 'Escape' && searchOverlay.classList.contains('open')) {
      closeSearch()
    } else if (searchOverlay.classList.contains('open') && (e.key === 'ArrowDown' || e.key === 'ArrowUp')) {
      const results = Array.from(searchResultsEl.querySelectorAll('.search-result'))
      if (!results.length) return
      e.preventDefault()
      results[activeIndex]?.classList.remove('active')
      activeIndex =
        e.key === 'ArrowDown' ? (activeIndex + 1) % results.length : (activeIndex - 1 + results.length) % results.length
      results[activeIndex].classList.add('active')
      results[activeIndex].scrollIntoView({ block: 'nearest' })
    } else if (searchOverlay.classList.contains('open') && e.key === 'Enter' && activeIndex >= 0) {
      const results = Array.from(searchResultsEl.querySelectorAll('.search-result'))
      results[activeIndex]?.click()
    }
  })
</script>
