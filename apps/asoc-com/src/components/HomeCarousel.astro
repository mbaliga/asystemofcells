---
// component: HomeCarousel
//
// The asystemofcells.com landing mechanism, v4 - "the conveyor" on desktop,
// "the reel" on mobile. Both are infinite loops, both traced frame-by-frame
// from the owner's reference clips; the measurements are quoted inline where
// they're used. Real roster data on both.
//
// Desktop - the conveyor. A rigid train of blank glossy cards steps up-left
// along one diagonal. Measured from the reference (1080x1350, 60fps, 5s
// seamless loop): every step moves *everything* by the same vector (-26.7%W,
// -14.6%H), i.e. 34.3deg above horizontal and ~0.85x one card height; the
// train steps every 5/7s (7 steps = 7 objects = 7 slots per loop); each step
// is an ease-in / whip / long tail (half the move is done by 23% of the step,
// settled by ~70%, then a hold); cards keep their size (no scaling) and each
// rotates ~-9..-13deg per slot as it travels, from its own tilt at the
// centre (-14..+14deg). Cards are 4:5, square-cornered, flat glossy, on a
// flat black. The stage is the whole viewport; the only chrome floats over
// it in the two corners the train never crosses - the current centre-slot
// product's name top-right, the link list and wordmark bottom-left - plus a
// small copyright centre-bottom. The motion is driven from JS (one clock,
// one rAF) rather than per-card CSS animations because the whole train has
// to step in lockstep, pause together on hover, and "in focus" is then
// plain arithmetic (the lane nearest slot 0).
//
// Mobile - the reel. A vertical list of names, one per screen-sixth, the
// one on the centre line bright and the rest dimming by distance,
// auto-advancing one name every 1.25s (measured: 10 items over a 12.5s
// loop) with a crossfading full-bleed backdrop behind. The centre name is
// caught in a drop of liquid - a soft-body membrane (a ring of spring-
// coupled points on a canvas) anchored on the centre line that the passing
// names drag viscously and that wobbles back, re-wrapping to each new name.
// The list itself moves like something thick: it lags the finger and
// settles with a heavy, overshoot-free spring rather than snapping.
// Swipe/wheel step it by hand; touching it pauses the auto-advance.
//
// No texture/grain anywhere any more: flat colour, soft light, crisp edges.
import { getRoster, TISSUES } from '@asoc/roster'

const tissueLabel = Object.fromEntries(TISSUES.map((t) => [t.slug, t.label]))
const statusLabel = { live: 'Live', beta: 'Beta', soon: 'Soon' }

function titleCase(slug) {
  return slug
    .split('-')
    .map((w) => w.charAt(0).toUpperCase() + w.slice(1))
    .join(' ')
}

const items = getRoster().map((cell) => ({
  key: cell.slug,
  name: titleCase(cell.slug),
  status: statusLabel[cell.status] || cell.status,
  tissue: tissueLabel[cell.tissue] || cell.tissue,
  oneLiner: cell.oneLiner,
  color: cell.accent,
  href: cell.isHub ? cell.hubUrl : `/${cell.slug}`,
  external: !!cell.isHub,
}))

// A non-product tile for the in-browser generators. It rides the same
// conveyor/reel as any cell and points at the /tools hub, not a roster slug.
items.push({
  key: 'tools',
  name: 'Tools',
  status: 'Open',
  tissue: 'Maker cells',
  oneLiner: 'In-browser generators: grainy gradient backgrounds and the ASOC cells mark. On-device, nothing uploaded.',
  color: '#8e7bff',
  href: '/tools',
  external: false,
})

const total = items.length
const first = items[0]

// --- the train ---------------------------------------------------------
// Unit step direction (up-left, 34.3deg above horizontal) and its
// perpendicular (right-up), from the measured per-step vector.
const DIR = { x: -0.8258, y: -0.5639 }
const NRM = { x: 0.5639, y: -0.8258 }
// One slot along the line = 0.85 card heights (measured 350px per step
// against a 410px card).
const STEP_H = 0.85
// Lane k rides slot -k (plus `frac`, an along-track nudge so pairs overlap
// the way the reference's do), offset `lat` card-heights off the line, at
// `tilt` degrees when on the centre slot and turning `rate` degrees per
// slot. `aspect`/`scale` size it against one card height. The first seven
// are the reference's seven objects as measured (blue square, small 3D hand,
// poster, photo, square letter card, yellow card, square portrait); the rest
// continue the same rhythm for viewports wide enough to need more slots
// (see the JS `layout()` for how many actually run).
const LANES = [
  { frac: 0, lat: 0, tilt: 1, rate: -12.8, aspect: 0.78, scale: 1.0, z: 3 },
  { frac: 0, lat: 0.03, tilt: -14, rate: -9, aspect: 0.78, scale: 0.64, z: 4 },
  { frac: 0, lat: -0.1, tilt: -1, rate: -8, aspect: 0.79, scale: 1.02, z: 2 },
  { frac: 0, lat: -0.09, tilt: 11, rate: -10, aspect: 0.77, scale: 1.07, z: 3 },
  { frac: 0.34, lat: -0.04, tilt: 8, rate: -9, aspect: 1.0, scale: 0.72, z: 5 },
  { frac: 0, lat: 0, tilt: 14, rate: -9.8, aspect: 0.83, scale: 0.97, z: 4 },
  { frac: 0.35, lat: 0.39, tilt: 10, rate: -10, aspect: 0.95, scale: 0.8, z: 5 },
  { frac: 0, lat: -0.06, tilt: -6, rate: -11, aspect: 0.78, scale: 1.0, z: 3 },
  { frac: 0.3, lat: 0.22, tilt: 16, rate: -9, aspect: 0.78, scale: 0.82, z: 5 },
  { frac: 0, lat: -0.12, tilt: 3, rate: -10, aspect: 0.8, scale: 1.04, z: 2 },
  { frac: 0, lat: 0.05, tilt: -10, rate: -8.5, aspect: 1.0, scale: 0.7, z: 4 },
  { frac: 0.36, lat: -0.3, tilt: 12, rate: -10, aspect: 0.78, scale: 0.9, z: 5 },
  { frac: 0, lat: 0.02, tilt: 6, rate: -12, aspect: 0.78, scale: 1.0, z: 3 },
]
// What a typical desktop needs; the JS re-derives this from the real
// viewport before the first frame and only ever shows that many lanes.
const SERVER_LANES = 9

// Lane k's slot at t=0, wrapped into [-n/2, n/2), and the roster item it
// starts on: slot 0 gets items[0], the slots behind it (bottom-right) count
// up, the slots already past centre (top-left) count back from the end of
// the roster, so the centre slot sees the roster in order over time.
function laneStart(k, n) {
  const raw = -k + LANES[k].frac
  const lap = Math.floor((raw + n / 2) / n)
  return { along: raw - lap * n, item: items[(((k + lap * n) % total) + total) % total] }
}
const lanes = LANES.map((lane, k) => {
  const { along, item } = laneStart(k, SERVER_LANES)
  const kx = STEP_H * along * DIR.x + lane.lat * NRM.x
  const ky = STEP_H * along * DIR.y + lane.lat * NRM.y
  return {
    ...lane,
    item,
    style: `--kx:${kx.toFixed(4)}; --ky:${ky.toFixed(4)}; --r:${(lane.tilt + lane.rate * along).toFixed(2)}deg; --scale:${lane.scale}; --aspect:${lane.aspect}; --accent:${item.color}; z-index:${lane.z};${k >= SERVER_LANES ? ' display:none;' : ''}`,
  }
})
---

<div class="home-outer" data-page="home">
  <div class="home-card">
    <!-- ============================================================ -->
    <!-- Desktop: the conveyor. Blank cards on one diagonal, stepping   -->
    <!-- in lockstep; the name of whichever is on the centre slot is    -->
    <!-- written top-right. JS drives the positions (see the engine    -->
    <!-- below); prefers-reduced-motion swaps the whole thing for a     -->
    <!-- static grid of every item.                                     -->
    <!-- ============================================================ -->
    <div class="scene scene--desktop" id="sceneDesktop" aria-hidden="false">
      <div class="flow-stage" id="flowStage" aria-hidden="true">
        {lanes.map((lane, k) => (
          <a
            class="flow-card"
            data-lane={k}
            href={lane.item.href}
            target={lane.item.external ? '_blank' : undefined}
            rel={lane.item.external ? 'noopener noreferrer' : undefined}
            aria-label={`${lane.item.tissue}: ${lane.item.name}`}
            tabindex="-1"
            style={lane.style}
          ></a>
        ))}
      </div>

      <!-- The two fixed points: the brand wordmark bottom-left (in
           .home-foot) and, here, the current centre-slot product top-right.
           Visual-only duplicates of the card's accessible name, which stays
           reachable via .flow-fallback/search regardless of motion. -->
      <div class="flow-focus" aria-hidden="true">
        <span class="flow-focus__name" id="flowFocusName">{first.name}</span>
      </div>

      <!-- Every item, in plain roster order, as real tab-focusable links -
           visually hidden (standard sr-only clip) while the conveyor is
           what's shown, revealed as a panel the moment a keyboard user tabs
           into it, and the visible page outright under reduced motion. -->
      <div class="flow-fallback">
        {items.map((it) => (
          <a
            class="flow-fallback__card"
            href={it.href}
            target={it.external ? '_blank' : undefined}
            rel={it.external ? 'noopener noreferrer' : undefined}
            style={`--fb-accent:${it.color}`}
          >
            <span class="flow-fallback__name">{it.name}</span>
            <span class="flow-fallback__tissue">{it.tissue}</span>
          </a>
        ))}
      </div>
    </div>

    <!-- ============================================================ -->
    <!-- Mobile: the reel. A full-bleed backdrop (two layers so it can   -->
    <!-- crossfade) behind a vertical stack of names that auto-advances, -->
    <!-- the centre one caught in a liquid drop (the canvas). Every name -->
    <!-- is a real link; JS adds the stepping, the drop, the dimming-by- -->
    <!-- distance and the wrap-around clones.                            -->
    <!-- ============================================================ -->
    <div class="scene scene--mobile" id="sceneMobile" aria-hidden="true">
      <div class="reel-bg reel-bg--a" id="reelBgA" style={`--bg-accent:${first.color}`}></div>
      <div class="reel-bg reel-bg--b" id="reelBgB" style={`--bg-accent:${first.color}`}></div>
      <div class="reel" id="reel">
        <ul class="reel-track" id="reelTrack">
          {items.map((it, i) => (
            <li class={`pill-slot${i === 0 ? ' is-near' : ''}`} data-index={i}>
              <a
                class="pill"
                href={it.href}
                target={it.external ? '_blank' : undefined}
                rel={it.external ? 'noopener noreferrer' : undefined}
              >
                <span class="pill__name">{it.name}</span>
                <span class="pill__num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              </a>
            </li>
          ))}
        </ul>
        <canvas class="reel-cell" id="reelCell" aria-hidden="true"></canvas>
      </div>
    </div>

    <!-- Floating chrome, over the stage (nothing sits in its own band):
         links as a list stacked over the wordmark bottom-left, the
         copyright centre-bottom. -->
    <footer class="home-foot">
      <div class="home-foot__left">
        <ul class="home-links">
          <li><a href="/about">About</a></li>
          <li><a href="/faq">FAQ</a></li>
          <li><a href="/tools">Tools</a></li>
          <li><a href="/hyle-fonts">Fonts</a></li>
          <li><a href="/privacy">Privacy policy</a></li>
          <li><a href="/contact">Contact</a></li>
          <li><button class="home-search-btn" type="button" id="homeSearchBtn">Search</button></li>
        </ul>
        <span class="home-brand-wordmark">asystemofcells</span>
      </div>
      <span class="home-rights">&copy; 2026 ASYSTEMOFCELLS</span>
    </footer>
  </div>
</div>

<div class="search-overlay" id="searchOverlay" data-page="home" aria-hidden="true">
  <div class="search-panel" role="dialog" aria-modal="true" aria-label="Search apps">
    <div class="search-input-row">
      <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
      <input type="text" id="searchInput" class="search-input" placeholder="Search apps" autocomplete="off" />
      <button type="button" id="searchClose" class="search-close" aria-label="Close search">Esc</button>
    </div>
    <ul class="search-results" id="searchResults"></ul>
  </div>
</div>

<style is:global>
  /* Global (not Astro-scoped): several elements below are re-targeted or
     cloned client-side (lanes retint per lap, the reel clones its pills) and
     the search results list is built via innerHTML - none of which would
     carry Astro's data-astro-cid scoping attribute. Namespaced instead:
     every selector is under [data-page="home"] or a home-/flow-/reel-/pill-
     prefixed class, so nothing collides with packages/kit. */
  [data-page='home'] {
    --home-bg: #050506;
    --home-ink: #f0ede6;
    --home-muted: rgba(240, 237, 230, 0.58);
    --home-ease: cubic-bezier(0.4, 0, 0.2, 1);
    --home-panel: #16161a;
    --home-hairline: rgba(240, 237, 230, 0.14);
  }

  .home-outer {
    min-height: 100vh;
    display: flex;
    font-family: var(--font-ui);
    color: var(--home-ink);
    overflow: hidden;
  }

  .home-card {
    position: relative;
    width: 100%;
    background: var(--home-bg);
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  /* ---------------------------------------------------------- desktop --- */

  .scene--desktop {
    flex: 1;
    position: relative;
    z-index: 3;
    display: block;
    /* One card height: ~31% of the reference's 4:5 frame, which is ~39% of
       its width - so on landscape screens the height wins and on narrow ones
       the width does. Everything in the conveyor is sized off this. */
    --card-h: clamp(200px, min(38vh, 42vw), 440px);
  }

  .flow-stage {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  /* One blank card. Position/rotation come in as --kx/--ky (multiples of
     one card height along/off the line) and --r; the server sets the t=0
     layout inline and the JS overwrites all three every frame. Glossy but
     flat: the accent as one smooth surface, a soft key light from the
     upper-left, a slight fall-off to the lower-right, a faint sheen
     streak, crisp square corners and a soft shadow for the overlaps. */
  .flow-card {
    position: absolute;
    left: 50%;
    top: 50%;
    height: calc(var(--card-h) * var(--scale));
    width: calc(var(--card-h) * var(--scale) * var(--aspect));
    transform: translate(calc(-50% + var(--card-h) * var(--kx)), calc(-50% + var(--card-h) * var(--ky)))
      rotate(var(--r));
    background:
      linear-gradient(155deg, rgba(255, 255, 255, 0.24) 0%, rgba(255, 255, 255, 0.06) 32%, rgba(255, 255, 255, 0) 55%),
      linear-gradient(335deg, rgba(0, 0, 0, 0.3) 0%, rgba(0, 0, 0, 0) 48%),
      var(--accent);
    box-shadow:
      0 28px 56px -16px rgba(0, 0, 0, 0.75),
      inset 0 0 0 1px rgba(255, 255, 255, 0.07);
    text-decoration: none;
    will-change: transform;
  }
  .flow-card::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      112deg,
      rgba(255, 255, 255, 0) 40%,
      rgba(255, 255, 255, 0.09) 47%,
      rgba(255, 255, 255, 0.03) 53%,
      rgba(255, 255, 255, 0) 60%
    );
    pointer-events: none;
  }
  .flow-card:focus-visible {
    outline: 2px solid var(--home-ink);
    outline-offset: 3px;
  }

  .flow-focus {
    position: absolute;
    top: clamp(14px, 2.2vw, 28px);
    right: clamp(16px, 3.2%, 40px);
    z-index: 6;
    pointer-events: none;
  }
  .flow-focus__name {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: clamp(9px, 0.85vw, 11px);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--home-muted);
    transition: opacity 150ms linear;
  }
  .flow-focus__name.is-swapping {
    opacity: 0;
  }

  .flow-fallback {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
  /* Scoped to no-preference: under reduced motion .flow-fallback is already
     the plain static grid below, and :focus-within's higher specificity
     would otherwise pop it into a floating panel the moment a link inside
     it is focused. */
  @media (prefers-reduced-motion: no-preference) {
    .flow-fallback:focus-within {
      position: fixed;
      inset: auto 4vw 92px 4vw;
      width: auto;
      height: auto;
      max-height: 55vh;
      margin: 0;
      overflow: auto;
      clip: auto;
      white-space: normal;
      z-index: 30;
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
      gap: 12px;
      padding: 16px;
      background: var(--home-panel);
      border: 1px solid var(--home-hairline);
      box-shadow: 0 30px 70px rgba(0, 0, 0, 0.6);
    }
  }
  .flow-fallback__card {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 14px;
    border: 1px solid var(--home-hairline);
    border-top: 3px solid var(--fb-accent, var(--home-ink));
    text-decoration: none;
    color: var(--home-ink);
  }
  .flow-fallback__name {
    font-family: var(--font-ui);
    font-weight: 600;
    font-size: 15px;
  }
  .flow-fallback__tissue {
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--home-muted);
  }

  @media (prefers-reduced-motion: reduce) {
    .flow-stage {
      display: none;
    }
    .flow-focus {
      display: none;
    }
    .flow-fallback {
      position: static;
      width: auto;
      height: auto;
      padding: 6vh 4vw;
      margin: 0;
      overflow: visible;
      clip: auto;
      white-space: normal;
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
      gap: 14px;
      align-content: center;
    }
  }

  /* ----------------------------------------------------------- mobile --- */

  .scene--mobile {
    display: none;
  }

  @media (max-width: 880px) {
    .scene--desktop {
      display: none;
    }
    .scene--mobile {
      display: block;
      flex: 1;
      position: relative;
      z-index: 3;
      overflow: hidden;
    }

    /* The full-bleed backdrop: the item's accent as one lit, glossy studio
       sweep (brighter where the key light lands upper-left, falling to a
       deep shade at the bottom). Two layers, the top one fading in over the
       other, so an item change is a crossfade rather than a cut. */
    .reel-bg {
      position: absolute;
      inset: 0;
      background: var(--bg-accent);
      background:
        radial-gradient(90% 70% at 30% 20%, rgba(255, 255, 255, 0.26), rgba(255, 255, 255, 0) 62%),
        linear-gradient(180deg, color-mix(in srgb, var(--bg-accent), #000 14%) 0%, color-mix(in srgb, var(--bg-accent), #000 66%) 100%);
      transition: opacity 420ms var(--home-ease);
    }
    .reel-bg--b {
      opacity: 0;
    }

    .reel {
      position: absolute;
      inset: 0;
      overflow: hidden;
      touch-action: none;
      user-select: none;
      -webkit-user-select: none;
    }
    /* The stack: one name per screen-sixth (measured: pitch = 1/6 of the
       frame height, the focused one on the centre line). JS positions the
       track every frame from its spring; --pitch's 1/6-of-viewport default
       only covers the first paint, before JS measures the real reel. */
    .reel-track {
      position: absolute;
      top: 50%;
      left: 0;
      right: 0;
      margin: 0;
      padding: 0;
      list-style: none;
      --pitch: 16.6667vh;
      transform: translateY(calc(var(--pitch) * -0.5));
      will-change: transform;
    }
    .pill-slot {
      height: var(--pitch);
      display: flex;
      align-items: center;
      justify-content: center;
      opacity: 0.12;
    }
    .pill-slot.is-near {
      opacity: 1;
    }
    /* Plain names, no box: the drop (the canvas over the track) is what
       holds the centre one. Generous padding keeps the tap target tall
       without drawing anything. */
    .pill {
      position: relative;
      display: inline-block;
      padding: 0.35em 0.9em;
      color: #fff;
      text-decoration: none;
      font-family: var(--font-ui);
      font-weight: 400;
      font-size: clamp(20px, 3.8vh, 34px);
      line-height: 1.1;
      letter-spacing: -0.01em;
      white-space: nowrap;
      max-width: 88vw;
    }
    .pill-slot.is-near .pill {
      font-weight: 500;
    }
    .pill__num {
      position: absolute;
      top: 0.1em;
      right: -0.1em;
      font-family: var(--font-mono);
      font-weight: 400;
      font-size: 0.3em;
      letter-spacing: 0.06em;
      opacity: 0.55;
    }
    .pill__name {
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .pill:focus-visible {
      outline: 2px solid #fff;
      outline-offset: 4px;
    }
    /* The drop: a canvas the height of three pitches, centred on the
       centre line, above the names (they read through it) and never in
       the way of a tap. */
    .reel-cell {
      position: absolute;
      left: 0;
      top: 50%;
      width: 100%;
      height: calc(var(--pitch, 16.6667vh) * 3);
      transform: translateY(-50%);
      z-index: 3;
      pointer-events: none;
    }

    @media (prefers-reduced-motion: reduce) {
      .reel-bg {
        transition: none;
      }
    }
  }

  /* ------------------------------------------------------------ footer -- */

  /* Floats over the stage (the stage is the whole viewport; nothing gets
     its own band). Three columns: the link list + wordmark bottom-left,
     the copyright centre-bottom, nothing right - the current product's
     name already lives top-right. Only the words themselves take the
     pointer, so the train underneath stays hoverable around them. */
  .home-foot {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 5;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: end;
    padding: 0 3.4% 2.4%;
    pointer-events: none;
  }
  .home-foot__left {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 16px;
  }
  .home-links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 7px;
  }
  .home-links a,
  .home-search-btn {
    pointer-events: auto;
    font-family: var(--font-mono);
    font-size: clamp(9px, 0.72vw, 11px);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--home-muted);
    text-decoration: none;
    background: none;
    border: 0;
    padding: 0;
    cursor: pointer;
    transition: color 0.15s;
  }
  .home-links a:hover,
  .home-search-btn:hover,
  .home-search-btn:focus-visible {
    color: var(--home-ink);
  }
  .home-brand-wordmark {
    pointer-events: auto;
    font-family: var(--font-ui);
    font-weight: 700;
    font-size: clamp(15px, 2vw, 26px);
    line-height: 0.95;
    letter-spacing: 0.01em;
    white-space: nowrap;
  }
  .home-rights {
    grid-column: 2;
    justify-self: center;
    pointer-events: auto;
    font-family: var(--font-mono);
    font-size: clamp(7px, 0.7vw, 9px);
    letter-spacing: 0.14em;
    color: var(--home-muted);
