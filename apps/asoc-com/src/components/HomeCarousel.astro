  }
  .home-search-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 20px;
    height: 20px;
    background: none;
    border: 0;
    padding: 0;
    cursor: pointer;
    color: var(--home-muted);
    transition: color 0.15s;
  }
  .home-search-btn:hover,
  .home-search-btn:focus-visible {
