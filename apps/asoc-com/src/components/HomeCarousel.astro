</style>

<script type="application/json" id="rosterData" set:html={JSON.stringify(items)} />

<script>
  // The constellation + reel engine. A real ES module (not define:vars) so it
  // can import the texture engine directly; roster data comes in via the JSON
  // island above rather than a build-time inject, matching the search script
  // below it.
  import { mountTextureBackdrop, hexToRgb, rgbToHex } from '@asoc/kit/texture.js'

  const items = JSON.parse(document.getElementById('rosterData').textContent)
  const total = items.length

  const homePageEl = document.querySelector('[data-page="home"]')
  // Read rather than re-hardcode: --home-bg (the CSS-side void colour) and
  // this JS-side gradient floor need to be the same colour for the "glow
  // fades to true black at the edges" seam to actually hold. Falls back to
  // the CSS's own initial value only if the property somehow isn't there.
  const STAGE_VOID = (homePageEl && getComputedStyle(homePageEl).getPropertyValue('--home-bg').trim()) || '#050506'

  // The ambient stage/reel backdrops go near-black, not the bright
  // accent-to-white ramp the cards themselves use - paletteFromAccent always
  // ends in white, which read as a bright warm wash covering the whole void
  // instead of an AMOLED stage the cards float in. Mixing the accent down
  // toward the stage's own near-black keeps a coloured glow at the centre
  // that still fades to true black at the edges. `strength` controls how much
  // of the accent survives the mix - the reel gets a slightly richer glow
  // than the desktop stage, since it has no coloured cards of its own to
  // carry colour.
  function ambientPalette(hex, strength) {
    const c = hexToRgb(hex)
    const core = rgbToHex({ r: c.r * strength, g: c.g * strength, b: c.b * strength })
    return [core, STAGE_VOID]
  }

  const sceneDesktopEl = document.getElementById('sceneDesktop')
  const flowStageEl = document.getElementById('flowStage')
  const flowCardEls = Array.from(flowStageEl.querySelectorAll('.flow-card'))

  const reelEl = document.getElementById('reel')
  const pillEls = reelEl ? Array.from(reelEl.querySelectorAll('.pill')) : []
  const reelOneLinerEl = document.getElementById('reelOneLiner')
  const reelStatusEl = document.getElementById('reelStatus')

  let homeCurrent = 0

  function first() {
    return items[0]
  }

  // --- backdrops -------------------------------------------------------
  // One dim, fixed ambient glow behind the desktop flow (the cards
  // themselves carry the colour there, and there's no single "current item"
  // any more to retint it to - every lane is showing something different at
  // once), one richer full-bleed wash behind the mobile reel that does
  // retint (there are no coloured cards to carry it on that screen). Each
  // flow-card gets its own small static backdrop too, retinted (not
  // remounted) each time its lane's loop brings a new item around.

  // `motion: 'drift'` unconditionally, not gated on prefers-reduced-motion
  // here - mountTextureBackdrop already checks that live internally
  // (texture.js's own reduced.addEventListener('change', ...)), so it stays
  // correct even if the OS preference changes mid-session without a reload.
  mountTextureBackdrop(flowStageEl, {
    palette: ambientPalette('#8e7bff', 0.35),
    fill: 'radial',
    stops: [0, 0.5],
    texType: 'grain',
    grain: 20,
    scale: 12,
    vig: 22,
    motion: 'drift',
    speed: 16,
  })

  const sceneMobileEl = document.getElementById('sceneMobile')
  const mobileBackdrop = mountTextureBackdrop(sceneMobileEl, {
    palette: ambientPalette(first().color, 0.55),
    fill: 'radial',
    stops: [0, 0.64],
    texType: 'grain',
    grain: 30,
    scale: 10,
    vig: 16,
    motion: 'drift',
    speed: 20,
  })

  // --- desktop: the flow - each lane cycles its own content forever -----
  //
  // The motion itself is pure CSS (see @keyframes flow) and never touched
  // from here. JS only does two things per lane: paint its current item's
  // colour onto its own small backdrop canvas, and - once per lap, on
  // `animationiteration`, which fires exactly when a lane is back at its
  // invisible/cropped spawn point - swap in the next item so every lane
  // keeps cycling through the whole roster instead of looping on one card
  // forever.
  const laneBackdrops = flowCardEls.map((el) => {
    const idx = Number(el.dataset.lane)
    return {
      idx,
      backdrop: mountTextureBackdrop(el, {
        accent: items[idx % total].color,
        fill: 'linear',
        angle: 150,
        texType: 'grain',
        grain: 34,
        scale: 9,
        vig: 0,
        motion: 'none',
      }),
    }
  })

  function applyLane(el, item) {
    el.href = item.href
    el.setAttribute('aria-label', `${item.tissue}: ${item.name}`)
    if (item.external) {
      el.setAttribute('target', '_blank')
      el.setAttribute('rel', 'noopener noreferrer')
    } else {
      el.removeAttribute('target')
      el.removeAttribute('rel')
    }
    const tagEl = el.querySelector('.flow-card__tag')
    const statusEl = el.querySelector('.flow-card__status')
    const nameEl = el.querySelector('.flow-card__name')
    if (tagEl) tagEl.textContent = item.tissue
    if (statusEl) statusEl.textContent = item.status
    if (nameEl) nameEl.textContent = item.name
  }

  // No prefers-reduced-motion gate needed here: under reduced motion
  // .flow-stage is display:none (see the CSS media query), so the CSS
  // animation never runs and animationiteration simply never fires - this
  // stays correct even if the OS preference changes live mid-session.
  flowCardEls.forEach((el, i) => {
    let lap = 0
    el.addEventListener('animationiteration', () => {
      lap += 1
      // Lane i has already shown items[i % total] (its server-rendered
      // start); each subsequent lap advances by the lane count so every
      // lane's sequence is disjoint and, between them, covers the roster.
      const nextIdx = (i + lap * flowCardEls.length) % total
      applyLane(el, items[nextIdx])
      laneBackdrops[i].backdrop.setAccent(items[nextIdx].color)
    })
  })

  // --- mobile: focus-by-distance-from-centre on the pill reel -----------

  if (reelEl && pillEls.length) {
    let reelTicking = false
    let reelSettleTimer = null

    // Only the single nearest pill is "focused" - a threshold-based check
    // here (anything within one pill-height of centre) could tag two
    // adjacent pills at once when the scroll settles between them.
    function applyPillFocusVisual(idx) {
      pillEls.forEach((pill) => pill.classList.toggle('pill--focused', Number(pill.dataset.index) === idx))
    }

    // The state/caption/backdrop commit is split out from the (per-frame)
    // visual dimming above so it can be debounced: #reelCaption is
    // aria-live="polite", and most screen readers queue rather than drop
    // polite announcements, so committing text on every frame during a fast
    // scroll would read out a backlog of already-stale items well after the
    // user stopped scrolling. This is also reused by the focusin handler
    // below for keyboard navigation, where the commit should be immediate.
    function commitReelFocus(idx) {
      homeCurrent = idx
      const item = items[idx]
      mobileBackdrop.setPalette(ambientPalette(item.color, 0.55))
      if (reelOneLinerEl) reelOneLinerEl.textContent = item.oneLiner
      if (reelStatusEl) reelStatusEl.textContent = item.status
    }

    function updateReelFocus() {
      reelTicking = false
      const viewportMid = window.innerHeight / 2
      let nearest = pillEls[0]
      let nearestDist = Infinity
      pillEls.forEach((pill) => {
        const r = pill.getBoundingClientRect()
        const mid = r.top + r.height / 2
        const dist = Math.abs(mid - viewportMid)
        if (dist < nearestDist) {
          nearestDist = dist
          nearest = pill
        }
      })
      const idx = Number(nearest.dataset.index)
      applyPillFocusVisual(idx)
      if (idx === homeCurrent) return
      clearTimeout(reelSettleTimer)
      reelSettleTimer = setTimeout(() => commitReelFocus(idx), 220)
    }

    reelEl.addEventListener(
      'scroll',
      () => {
        if (!reelTicking) {
          reelTicking = true
          requestAnimationFrame(updateReelFocus)
        }
      },
      { passive: true },
    )
    // Tabbing between two pills that are both already fully on-screen
    // doesn't trigger a scroll event (the browser only auto-scrolls a
    // focused element into view when it isn't already visible), so without
    // this the caption/backdrop could keep describing a stale, previously
    // scroll-centred pill while a keyboard user is visually focused on a
    // different one.
    reelEl.addEventListener('focusin', (e) => {
      const pill = e.target.closest('.pill')
      if (!pill) return
      const idx = Number(pill.dataset.index)
      clearTimeout(reelSettleTimer)
      applyPillFocusVisual(idx)
      commitReelFocus(idx)
    })
    updateReelFocus()
  }

  // --- breakpoint sync: both scenes are always in the DOM; only CSS ------
  // `display` (the 880px media query) decides which one is shown. The
  // ARIA-hidden state needs to track that explicitly rather than assume it
  // never changes mid-session (a window resize, a foldable rotating, a
  // dev-tools width drag) - the template's static attributes only describe
  // the very first paint, and guess desktop-first even then. The flow's own
  // lanes need no reconciliation on top of that (each keeps looping
  // independently regardless of which scene is visible); the reel's
  // scroll-into-view on becoming visible is still worth doing so it's not
  // left mid-scroll from whatever the viewport happened to be showing.
  const breakpointQuery = window.matchMedia('(max-width: 880px)')

  function syncSceneAria(isMobile) {
    sceneDesktopEl.setAttribute('aria-hidden', String(isMobile))
    sceneMobileEl.setAttribute('aria-hidden', String(!isMobile))
  }
  syncSceneAria(breakpointQuery.matches)

  breakpointQuery.addEventListener('change', (e) => {
    syncSceneAria(e.matches)
    if (e.matches) {
      const target = pillEls[homeCurrent]
      if (target) target.scrollIntoView({ block: 'center', behavior: 'auto' })
    }
  })
</script>

<script>
  // Search - client-side fuzzy match over the same roster data, no backend.
  // No server, no third-party API - Fuse.js fuzzy-matches the roster data
  // that's already bundled into this page at build time, entirely client-side.
  import Fuse from 'fuse.js'

  const items = JSON.parse(document.getElementById('rosterData').textContent)

  const searchBtn = document.getElementById('homeSearchBtn')
  const searchOverlay = document.getElementById('searchOverlay')
  const searchInput = document.getElementById('searchInput')
  const searchResultsEl = document.getElementById('searchResults')
  const searchCloseBtn = document.getElementById('searchClose')

  const fuse = new Fuse(items, {
    keys: [
      { name: 'name', weight: 2 },
      { name: 'tissue', weight: 1 },
      { name: 'oneLiner', weight: 1 },
    ],
    threshold: 0.35,
    ignoreLocation: true,
  })

  let activeIndex = -1

  function renderResults(query) {
    const results = query.trim() ? fuse.search(query, { limit: 8 }).map((r) => r.item) : items.slice(0, 8)
    activeIndex = -1
    if (results.length === 0) {
      searchResultsEl.innerHTML = `<li class="search-empty">No apps match "${query}"</li>`
      return
    }
    searchResultsEl.innerHTML = results
      .map(
        (it, i) => `
      <li>
        <a class="search-result" data-index="${i}" href="${it.href}"${it.external ? ' target="_blank" rel="noopener noreferrer"' : ''}>
          <span class="search-result-swatch" style="background:${it.color}"></span>
          <span class="search-result-text">
            <span class="search-result-name">${it.name}</span>
            <span class="search-result-meta">${it.tissue} &middot; ${it.status}</span>
          </span>
        </a>
      </li>`,
      )
      .join('')
  }

  function openSearch() {
    searchOverlay.classList.add('open')
    searchOverlay.setAttribute('aria-hidden', 'false')
    renderResults('')
    searchInput.value = ''
    searchInput.focus()
  }

  function closeSearch() {
    searchOverlay.classList.remove('open')
    searchOverlay.setAttribute('aria-hidden', 'true')
    searchBtn.focus()
  }

  searchBtn.addEventListener('click', openSearch)
  searchCloseBtn.addEventListener('click', closeSearch)
  searchOverlay.addEventListener('click', (e) => {
    if (e.target === searchOverlay) closeSearch()
  })
  searchInput.addEventListener('input', () => renderResults(searchInput.value))

  document.addEventListener('keydown', (e) => {
    if ((e.key === '/' || (e.key === 'k' && (e.metaKey || e.ctrlKey))) && !searchOverlay.classList.contains('open')) {
      const tag = document.activeElement?.tagName
      if (tag === 'INPUT' || tag === 'TEXTAREA') return
      e.preventDefault()
      openSearch()
    } else if (e.key === 'Escape' && searchOverlay.classList.contains('open')) {
      closeSearch()
    } else if (searchOverlay.classList.contains('open') && (e.key === 'ArrowDown' || e.key === 'ArrowUp')) {
      const results = Array.from(searchResultsEl.querySelectorAll('.search-result'))
      if (!results.length) return
      e.preventDefault()
      results[activeIndex]?.classList.remove('active')
      activeIndex =
        e.key === 'ArrowDown' ? (activeIndex + 1) % results.length : (activeIndex - 1 + results.length) % results.length
      results[activeIndex].classList.add('active')
      results[activeIndex].scrollIntoView({ block: 'nearest' })
    } else if (searchOverlay.classList.contains('open') && e.key === 'Enter' && activeIndex >= 0) {
      const results = Array.from(searchResultsEl.querySelectorAll('.search-result'))
      results[activeIndex]?.click()
    }
  })
</script>
