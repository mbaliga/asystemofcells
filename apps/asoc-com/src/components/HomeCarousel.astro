---
// component: HomeCarousel
//
// The asystemofcells.com landing mechanism, v2 - "the constellation" on
// desktop, "the reel" on mobile. Same roster data, same step-through
// interaction model as the v1 wheel-scrubbed plinth card, restyled toward the
// owner's immersive-portfolio reference: on desktop a scattered, tilted stack
// of glass-like cards on a near-black stage (one focused "hero" slot + four
// upcoming satellites, all real roster entries, all painted by the house
// texture engine instead of stock photography); on mobile a full-bleed
// backdrop with a vertically scroll-snapped stack of name pills that dim by
// distance from the focal centre line.
//
// Both scenes share one state machine (`homeCurrent`, wheel/keyboard/scroll
// all just move it) and one accent-driven backdrop system, so the two are
// reskins of the same mechanism rather than two apps bolted together.
//
// Data is the real roster (packages/roster) - see the mapping below for which
// real field stands in for each slot.
import { getRoster, TISSUES } from '@asoc/roster'

const tissueLabel = Object.fromEntries(TISSUES.map((t) => [t.slug, t.label]))
const statusLabel = { live: 'Live', beta: 'Beta', soon: 'Soon' }

function titleCase(slug) {
  return slug
    .split('-')
    .map((w) => w.charAt(0).toUpperCase() + w.slice(1))
    .join(' ')
}

const items = getRoster().map((cell) => ({
  key: cell.slug,
  name: titleCase(cell.slug),
  // No real version numbers exist in the roster - status stands in for the
  // small meta line the reference used a version string for.
  status: statusLabel[cell.status] || cell.status,
  tissue: tissueLabel[cell.tissue] || cell.tissue,
  oneLiner: cell.oneLiner,
  color: cell.accent,
  href: cell.isHub ? cell.hubUrl : `/${cell.slug}`,
  external: !!cell.isHub,
}))

// A non-product tile for the in-browser generators. It rides the same
// constellation/reel (and can be stepped to like any other cell) and points
// at the /tools hub, not a roster slug.
items.push({
  key: 'tools',
  name: 'Tools',
  status: 'Open',
  tissue: 'Maker cells',
  oneLiner: 'In-browser generators: grainy gradient backgrounds and the ASOC cells mark. On-device, nothing uploaded.',
  color: '#8e7bff',
  href: '/tools',
  external: false,
})

const total = items.length
const first = items[0]
// Desktop satellite slots preview the next four items after the focused one,
// wrapping via modulo - the same infinite-loop indexing the v1 thumbnail
// strip used, just landing on four fixed stage positions instead of a row.
const satelliteSlots = [1, 2, 3, 4].map((offset) => ({ offset, item: items[offset % total] }))
const pad2 = (n) => String(n).padStart(2, '0')
---

<div class="home-outer" data-page="home">
  <div class="home-card">
    <!-- ============================================================ -->
    <!-- Desktop: the constellation - a fixed arrangement of five card -->
    <!-- slots (hero + four satellites). Slot geometry never moves;    -->
    <!-- only which roster item occupies each slot changes on step.    -->
    <!-- ============================================================ -->
    <div class="scene scene--desktop" id="sceneDesktop" aria-hidden="false">
      <div class="stage" id="stage" role="group" aria-label="Featured cells - scroll or use arrow keys to step through">
        <span class="stage-index" id="stageIndex" aria-hidden="true">{pad2(1)} / {pad2(total)}</span>

        <a
          class="card card--hero"
          id="cardHero"
          href={first.href}
          target={first.external ? '_blank' : undefined}
          rel={first.external ? 'noopener noreferrer' : undefined}
          aria-label={`${first.name}: ${first.oneLiner}`}
        >
          <span class="card__tag" id="heroTag">{first.tissue}</span>
          <span class="card__status" id="heroStatus">{first.status}</span>
          <span class="card__foot">
            <span class="card__name" id="heroName">{first.name}</span>
            <span class="card__cta" aria-hidden="true">Explore &rarr;</span>
          </span>
        </a>

        {satelliteSlots.map(({ offset, item }) => (
          <a
            class="card card--sat"
            data-slot={offset}
            id={`cardSat${offset}`}
            href={item.href}
            target={item.external ? '_blank' : undefined}
            rel={item.external ? 'noopener noreferrer' : undefined}
            aria-label={item.name}
          >
            <span class="card__tag">{item.tissue}</span>
            <span class="card__name">{item.name}</span>
          </a>
        ))}
      </div>
    </div>

    <!-- ============================================================ -->
    <!-- Mobile: the reel - full-bleed backdrop + a scroll-snapped     -->
    <!-- vertical stack of every roster item as a name pill. Every     -->
    <!-- pill is a real link (works with no JS); JS only adds the      -->
    <!-- focus-by-distance dimming and keeps the backdrop in sync.     -->
    <!-- ============================================================ -->
    <div class="scene scene--mobile" id="sceneMobile" aria-hidden="true">
      <div class="reel" id="reel">
        <div class="reel-spacer" aria-hidden="true"></div>
        {items.map((it, i) => (
          <a
            class="pill"
            data-index={i}
            data-color={it.color}
            href={it.href}
            target={it.external ? '_blank' : undefined}
            rel={it.external ? 'noopener noreferrer' : undefined}
          >
            <span class="pill__name">{it.name}</span>
            <span class="pill__tissue">{it.tissue}</span>
          </a>
        ))}
        <div class="reel-spacer" aria-hidden="true"></div>
      </div>
      <div class="reel-caption" id="reelCaption" aria-live="polite">
        <p class="reel-oneliner" id="reelOneLiner">{first.oneLiner}</p>
        <span class="reel-status" id="reelStatus">{first.status}</span>
      </div>
    </div>

    <div class="home-foot">
      <div class="home-brand">
        <span class="home-brand-wordmark">asystemofcells</span>
      </div>
      <div class="home-meta">
        <div class="home-legal-links">
          <a href="/about">About</a>
          <a href="/faq">FAQ</a>
          <a href="/tools">Tools</a>
          <a href="/hyle-fonts">Fonts</a>
          <a href="/privacy">Privacy policy</a>
          <a href="/contact">Contact</a>
          <span class="home-rights">&copy; 2026 ASYSTEMOFCELLS</span>
          <button class="home-search-btn" type="button" id="homeSearchBtn" aria-label="Search">
            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
          </button>
        </div>
      </div>
    </div>
  </div>
</div>

<div class="search-overlay" id="searchOverlay" data-page="home" aria-hidden="true">
  <div class="search-panel" role="dialog" aria-modal="true" aria-label="Search apps">
    <div class="search-input-row">
      <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
      <input type="text" id="searchInput" class="search-input" placeholder="Search apps" autocomplete="off" />
      <button type="button" id="searchClose" class="search-close" aria-label="Close search">Esc</button>
    </div>
    <ul class="search-results" id="searchResults"></ul>
  </div>
</div>

<style is:global>
  /* Global (not Astro-scoped): several elements below are re-rendered or
     re-targeted client-side (card slots retint on every step), and the
     search results list is built via innerHTML - neither receives Astro's
     auto-injected data-astro-cid scoping attribute. Namespaced instead the
     same way v1 did it: every selector is under [data-page="home"] or a
     home-, card__- or pill__-prefixed class, so nothing collides with
     packages/kit's tokens.css or component classes. */
  @property --home-accent {
    syntax: '<color>';
    inherits: true;
    initial-value: #8e7bff;
  }
  @property --float-y {
    syntax: '<length>';
    inherits: false;
    initial-value: 0px;
  }

  [data-page='home'] {
    /* Near-black, not the flat #0b0b0c token - the stage wants to read as a
       void the cards float in, one shade off true black so the vignette has
       somewhere to go. */
    --home-bg: #050506;
    --home-ink: #f0ede6;
    --home-muted: rgba(240, 237, 230, 0.58);
    --home-ease: cubic-bezier(0.4, 0, 0.2, 1);
    --home-accent: #8e7bff;
    --home-panel: #16161a;
    --home-hairline: rgba(240, 237, 230, 0.14);
  }

  .home-outer {
    min-height: 100vh;
    display: flex;
    font-family: var(--font-ui);
    color: var(--home-ink);
    overflow: hidden;
  }

  .home-card {
    position: relative;
    width: 100%;
    background: var(--home-bg);
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  /* ---------------------------------------------------------- desktop --- */

  .scene--desktop {
    flex: 1;
    position: relative;
    z-index: 3;
    display: block;
  }

  .stage {
    position: absolute;
    inset: 0;
    perspective: 1400px;
  }

  .stage-index {
    position: absolute;
    top: clamp(14px, 2.2vw, 28px);
    right: clamp(16px, 3.2%, 40px);
    z-index: 6;
    font-family: var(--font-mono);
    font-size: clamp(9px, 0.85vw, 11px);
    letter-spacing: 0.14em;
    color: var(--home-muted);
  }

  .card {
    position: absolute;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    aspect-ratio: 3 / 4;
    border-radius: 6px;
    overflow: hidden;
    text-decoration: none;
    color: var(--home-ink);
    box-shadow: 0 30px 60px -20px rgba(0, 0, 0, 0.75);
    background-color: #1a1a1a; /* pre-canvas fallback so a slow paint never shows a see-through hole */
    transform: translate(calc(var(--px, 0) * var(--parallax, 0px)), calc(var(--py, 0) * var(--parallax, 0px)))
      rotate(var(--tilt, 0deg)) translateY(var(--float-y, 0px));
    animation: cardFloat var(--float-dur, 7s) ease-in-out infinite alternate;
    animation-delay: var(--float-delay, 0s);
    transition: box-shadow var(--home-ease) 200ms;
  }
  .card:hover,
  .card:focus-visible {
    box-shadow: 0 40px 80px -18px rgba(0, 0, 0, 0.85);
  }
  /* The card texture always ramps to a pale end (paletteFromAccent's third
     stop is white) - which end of the card that lands on depends on the
     accent's hue, so the name label needs a guaranteed-dark scrim under it
     rather than relying on text-shadow against an unpredictable background. */
  .card::after {
    content: '';
    position: absolute;
    inset: auto 0 0 0;
    height: 46%;
    z-index: 1;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.55), rgba(0, 0, 0, 0));
    pointer-events: none;
  }
  .card:focus-visible {
    outline: 2px solid var(--home-ink);
    outline-offset: 3px;
  }
  @keyframes cardFloat {
    from { --float-y: 0px; }
    to { --float-y: -10px; }
  }

  .card--hero {
    width: clamp(230px, 25vw, 380px);
    top: 15%;
    left: 6%;
    --tilt: -3deg;
    --parallax: 10px;
    --float-dur: 8s;
    z-index: 5;
  }
  .card--sat {
    width: clamp(108px, 12.5vw, 190px);
    z-index: 2;
  }
  .card--sat[data-slot='1'] { top: 3%; left: 37%; --tilt: 6deg; --parallax: 5px; --float-dur: 6.5s; --float-delay: -1.2s; z-index: 2; }
  .card--sat[data-slot='2'] { top: 33%; left: 53%; --tilt: -6deg; --parallax: 7px; --float-dur: 7.5s; --float-delay: -3.4s; z-index: 4; width: clamp(130px, 14.5vw, 220px); }
  .card--sat[data-slot='3'] { top: 6%; left: 71%; --tilt: 9deg; --parallax: 4px; --float-dur: 6s; --float-delay: -0.6s; z-index: 1; }
  .card--sat[data-slot='4'] { top: 47%; left: 84%; --tilt: -10deg; --parallax: 6px; --float-dur: 7s; --float-delay: -2.1s; z-index: 3; }

  .card__tag {
    position: relative;
    z-index: 2;
    align-self: flex-start;
    margin: 10px;
    font-family: var(--font-mono);
    font-size: 7px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    padding: 4px 7px;
    background: rgba(0, 0, 0, 0.4);
    color: #f3f2ef;
    border-radius: 2px;
    pointer-events: none;
  }
  .card--hero .card__tag { font-size: 8px; padding: 5px 9px; }

  .card__status {
    position: absolute;
    z-index: 2;
    top: 10px;
    right: 10px;
    font-family: var(--font-mono);
    font-size: 8px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 5px 10px;
    border-radius: 999px;
    background: var(--home-ink);
    color: #16161a;
    pointer-events: none;
    animation: pillBob 3.2s ease-in-out infinite alternate;
  }
  @keyframes pillBob {
    from { transform: translateY(0); }
    to { transform: translateY(-4px); }
  }

  .card__foot {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    margin: 12px;
  }
  .card__name {
    font-family: var(--font-display);
    font-weight: 600;
    color: #f3f2ef;
    text-shadow: 0 1px 4px rgba(0, 0, 0, 0.5);
  }
  .card--hero .card__name { font-size: clamp(16px, 1.9vw, 23px); }
  .card--sat .card__name {
    position: absolute;
    z-index: 2;
    left: 10px;
    bottom: 10px;
    right: 10px;
    font-size: clamp(11px, 1.1vw, 14px);
  }
  .card--hero .card__cta {
    font-family: var(--font-ui);
    font-size: clamp(9px, 0.9vw, 11px);
    font-weight: 600;
    letter-spacing: 0.02em;
    background: #f3f2ef;
    color: #16161a;
    padding: 8px 14px;
    border-radius: 999px;
    white-space: nowrap;
  }

  @media (prefers-reduced-motion: reduce) {
    .card { animation: none; }
    .card__status { animation: none; }
  }

  /* ----------------------------------------------------------- mobile --- */

  .scene--mobile { display: none; }

  @media (max-width: 880px) {
    .scene--desktop { display: none; }
    .scene--mobile {
      display: block;
      flex: 1;
      position: relative;
      z-index: 3;
      overflow: hidden;
    }
    .reel {
      position: absolute;
      inset: 0;
      overflow-y: auto;
      overflow-x: hidden;
      scroll-snap-type: y proximity;
      -webkit-overflow-scrolling: touch;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 14px;
      padding-inline: 8vw;
    }
    .reel-spacer { flex: 0 0 auto; height: 40vh; scroll-snap-align: none; }
    .pill {
      flex: 0 0 auto;
      scroll-snap-align: center;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 2px;
      text-decoration: none;
      color: var(--home-ink);
      opacity: 0.4;
      transform: scale(0.86);
      transition: opacity 260ms var(--home-ease), transform 260ms var(--home-ease);
      padding: 6px 10px;
    }
    .pill--focused { opacity: 1; transform: scale(1); }
    .pill__name {
      font-family: var(--font-display);
      font-weight: 600;
      font-size: clamp(20px, 7.2vw, 30px);
      white-space: nowrap;
    }
    .pill__tissue {
      font-family: var(--font-mono);
      font-size: 9px;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--home-muted);
    }
    .pill--focused .pill__tissue { color: var(--home-ink); }
    .pill:focus-visible { outline: 2px solid var(--home-ink); outline-offset: 4px; opacity: 1; transform: scale(1); }

    @media (prefers-reduced-motion: reduce) {
      .pill { transition: none; }
    }

    .reel-caption {
      position: absolute;
      left: 0;
      right: 0;
      bottom: 0;
      z-index: 4;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      padding: 56px 8vw 16px;
      background: linear-gradient(to top, var(--home-bg) 42%, rgba(5, 5, 6, 0));
      pointer-events: none;
    }
    .reel-oneliner {
      margin: 0;
      max-width: 64%;
      font-size: 12px;
      line-height: 1.5;
      color: var(--home-muted);
      display: -webkit-box;
      -webkit-line-clamp: 1;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }
    .reel-status {
      flex: 0 0 auto;
      font-family: var(--font-mono);
      font-size: 9px;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      padding: 5px 10px;
      border-radius: 999px;
      background: var(--home-ink);
      color: #16161a;
    }
  }

  /* ------------------------------------------------------------ footer -- */

  .home-foot {
    z-index: 5;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    padding: 1.8% 3.4% 2.4%;
    gap: 2%;
  }
  .home-brand {
    display: flex;
    align-items: center;
    gap: 9px;
  }
  .home-brand-wordmark {
    font-family: var(--font-ui);
    font-weight: 700;
    font-size: clamp(15px, 2vw, 26px);
    line-height: 0.95;
    letter-spacing: 0.01em;
    white-space: nowrap;
  }
  .home-meta {
    display: flex;
    align-items: center;
  }
  .home-legal-links {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 18px;
    flex-wrap: wrap;
  }
  .home-legal-links a {
    font-family: var(--font-mono);
    font-size: clamp(5px, 0.7vw, 9px);
    letter-spacing: 0.1em;
    color: var(--home-muted);
    text-decoration: none;
  }
  .home-legal-links a:hover {
    color: var(--home-ink);
  }
  .home-rights {
    font-family: var(--font-mono);
    font-size: clamp(5px, 0.7vw, 9px);
    letter-spacing: 0.14em;
    color: var(--home-muted);
    white-space: nowrap;
  }
  .home-search-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 18px;
    height: 18px;
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    color: var(--home-muted);
    transition: color 0.15s;
  }
  .home-search-btn:hover,
  .home-search-btn:focus-visible {
    color: var(--home-ink);
  }
  .home-search-btn svg {
    width: 13px;
    height: 13px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
  }

  @media (max-width: 720px) {
    .home-legal-links { gap: 10px; }
  }

  /* ------------------------------------------------------------- search - */

  .search-overlay {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: none;
    align-items: flex-start;
    justify-content: center;
    padding: 12vh 5vw 0;
    background: rgba(0, 0, 0, 0.65);
    backdrop-filter: blur(6px);
  }
  .search-overlay.open {
    display: flex;
  }
  .search-panel {
    width: min(560px, 100%);
    max-height: 70vh;
    display: flex;
    flex-direction: column;
    background: var(--home-panel);
    border: 1px solid var(--home-hairline);
    border-radius: 14px;
    box-shadow: 0 30px 70px rgba(0, 0, 0, 0.6);
    overflow: hidden;
    font-family: var(--font-ui);
  }
  .search-input-row {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 16px 18px;
    border-bottom: 1px solid var(--home-hairline);
  }
  .search-input-row svg {
    flex: 0 0 auto;
    width: 18px;
    height: 18px;
    fill: none;
    stroke: var(--home-muted);
    stroke-width: 1.8;
  }
  .search-input {
    flex: 1;
    border: none;
    background: none;
    outline: none;
    font-family: inherit;
    font-size: 16px;
    color: var(--home-ink);
  }
  .search-input::placeholder {
    color: var(--home-muted);
  }
  .search-close {
    flex: 0 0 auto;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.06em;
    color: var(--home-muted);
    background: rgba(255, 255, 255, 0.08);
    border: none;
    border-radius: 4px;
    padding: 4px 8px;
    cursor: pointer;
  }
  .search-close:hover {
    color: var(--home-ink);
  }
  .search-results {
    list-style: none;
    margin: 0;
    padding: 8px;
    overflow-y: auto;
  }
  .search-results:empty {
    display: none;
  }
  .search-result {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 10px;
    border-radius: 8px;
    text-decoration: none;
    color: var(--home-ink);
  }
  .search-result:hover,
  .search-result.active {
    background: rgba(255, 255, 255, 0.08);
  }
  .search-result-swatch {
    flex: 0 0 auto;
    width: 32px;
    height: 32px;
    border-radius: 7px;
  }
  .search-result-text {
    min-width: 0;
  }
  .search-result-name {
    display: block;
    font-weight: 600;
    font-size: 14px;
  }
  .search-result-meta {
    display: block;
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--home-muted);
    margin-top: 2px;
  }
  .search-empty {
    padding: 24px 10px;
    text-align: center;
    font-size: 13px;
    color: var(--home-muted);
  }
</style>

<script type="application/json" id="rosterData" set:html={JSON.stringify(items)} />

<script>
  // The constellation + reel engine. A real ES module (not define:vars) so it
  // can import the texture engine directly; roster data comes in via the JSON
  // island above rather than a build-time inject, matching the search script
  // below it.
  import { mountTextureBackdrop, hexToRgb, rgbToHex } from '@asoc/kit/texture.js'

  const items = JSON.parse(document.getElementById('rosterData').textContent)
  const total = items.length

  // The ambient stage/reel backdrops go near-black, not the bright
  // accent-to-white ramp the cards themselves use - paletteFromAccent always
  // ends in white, which read as a bright warm wash covering the whole void
  // instead of an AMOLED stage the cards float in. Mixing the accent down
  // toward the stage's own near-black keeps a coloured glow at the centre
  // that still fades to true black at the edges. `strength` controls how much
  // of the accent survives the mix - the reel gets a slightly richer glow
  // than the desktop stage, since it has no coloured cards of its own to
  // carry colour.
  function ambientPalette(hex, strength) {
    const c = hexToRgb(hex)
    const core = rgbToHex({ r: c.r * strength, g: c.g * strength, b: c.b * strength })
    return [core, '#050506']
  }

  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches
  const canHover = window.matchMedia('(hover: hover) and (pointer: fine)').matches
  const fadeMs = reducedMotion ? 0 : 220

  const stageEl = document.getElementById('stage')
  const stageIndexEl = document.getElementById('stageIndex')
  const heroEl = document.getElementById('cardHero')
  const heroTagEl = document.getElementById('heroTag')
  const heroStatusEl = document.getElementById('heroStatus')
  const heroNameEl = document.getElementById('heroName')
  const satEls = [1, 2, 3, 4].map((n) => document.getElementById(`cardSat${n}`))

  const reelEl = document.getElementById('reel')
  const pillEls = reelEl ? Array.from(reelEl.querySelectorAll('.pill')) : []
  const reelOneLinerEl = document.getElementById('reelOneLiner')
  const reelStatusEl = document.getElementById('reelStatus')

  let homeCurrent = 0
  let homeAnimating = false

  const pad2 = (n) => String(n).padStart(2, '0')

  // --- backdrops -------------------------------------------------------
  // One dim ambient glow behind the desktop stage (the cards themselves
  // carry the colour there), one richer full-bleed wash behind the mobile
  // reel (there are no coloured cards to carry it on that screen). A card
  // gets its own small backdrop too, retinted (not remounted) on every step.

  const desktopBackdrop = mountTextureBackdrop(stageEl, {
    palette: ambientPalette(first().color, 0.4),
    fill: 'radial',
    stops: [0, 0.5],
    texType: 'grain',
    grain: 20,
    scale: 12,
    vig: 22,
    motion: reducedMotion ? 'none' : 'drift',
    speed: 16,
  })

  const mobileStage = document.getElementById('sceneMobile')
  const mobileBackdrop = mountTextureBackdrop(mobileStage, {
    palette: ambientPalette(first().color, 0.55),
    fill: 'radial',
    stops: [0, 0.64],
    texType: 'grain',
    grain: 30,
    scale: 10,
    vig: 16,
    motion: reducedMotion ? 'none' : 'drift',
    speed: 20,
  })

  const heroBackdrop = mountTextureBackdrop(heroEl, {
    accent: first().color,
    fill: 'linear',
    angle: 150,
    texType: 'grain',
    grain: 34,
    scale: 9,
    vig: 0,
    motion: 'none',
  })
  const satBackdrops = satEls.map((el, i) => {
    const item = items[(1 + i) % total]
    return mountTextureBackdrop(el, {
      accent: item.color,
      fill: 'linear',
      angle: 150,
      texType: 'grain',
      grain: 34,
      scale: 9,
      vig: 0,
      motion: 'none',
    })
  })

  function first() {
    return items[0]
  }

  // --- desktop: apply the current index to the five fixed slots --------

  function applyStage(idx) {
    const hero = items[idx]
    heroEl.href = hero.href
    heroEl.setAttribute('aria-label', `${hero.name}: ${hero.oneLiner}`)
    if (hero.external) {
      heroEl.setAttribute('target', '_blank')
      heroEl.setAttribute('rel', 'noopener noreferrer')
    } else {
      heroEl.removeAttribute('target')
      heroEl.removeAttribute('rel')
    }
    heroTagEl.textContent = hero.tissue
    heroStatusEl.textContent = hero.status
    heroNameEl.textContent = hero.name
    heroBackdrop.setAccent(hero.color)
    desktopBackdrop.setPalette(ambientPalette(hero.color, 0.4))

    satEls.forEach((el, i) => {
      const item = items[(idx + i + 1) % total]
      el.href = item.href
      el.setAttribute('aria-label', item.name)
      if (item.external) {
        el.setAttribute('target', '_blank')
        el.setAttribute('rel', 'noopener noreferrer')
      } else {
        el.removeAttribute('target')
        el.removeAttribute('rel')
      }
      const tagEl = el.querySelector('.card__tag')
      const nameEl = el.querySelector('.card__name')
      if (tagEl) tagEl.textContent = item.tissue
      if (nameEl) nameEl.textContent = item.name
      satBackdrops[i].setAccent(item.color)
    })

    stageIndexEl.textContent = `${pad2(idx + 1)} / ${pad2(total)}`
  }

  function cycleTo(idx) {
    if (homeAnimating || idx === homeCurrent) return
    homeAnimating = true
    homeCurrent = idx

    if (fadeMs === 0) {
      applyStage(idx)
      homeAnimating = false
      return
    }

    stageEl.style.transition = `opacity ${fadeMs}ms ease`
    stageEl.style.opacity = '0.55'
    setTimeout(() => {
      applyStage(idx)
      stageEl.style.opacity = '1'
      setTimeout(() => {
        homeAnimating = false
      }, fadeMs)
    }, fadeMs)
  }

  let homeWheelAccum = 0
  const HOME_STEP_THRESHOLD = 60
  stageEl.addEventListener(
    'wheel',
    (e) => {
      e.preventDefault()
      if (homeAnimating) return
      homeWheelAccum += Math.abs(e.deltaY) >= Math.abs(e.deltaX) ? e.deltaY : e.deltaX
      if (Math.abs(homeWheelAccum) > HOME_STEP_THRESHOLD) {
        const next = homeWheelAccum > 0 ? (homeCurrent + 1) % total : (homeCurrent - 1 + total) % total
        homeWheelAccum = 0
        cycleTo(next)
      }
    },
    { passive: false },
  )

  stageEl.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowRight' || e.key === 'ArrowDown') {
      e.preventDefault()
      cycleTo((homeCurrent + 1) % total)
    } else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') {
      e.preventDefault()
      cycleTo((homeCurrent - 1 + total) % total)
    }
  })

  // Mouse parallax: cards drift a few px opposite the cursor, depth-weighted
  // per card via the --parallax custom property each already declares.
  if (canHover && !reducedMotion) {
    stageEl.addEventListener('mousemove', (e) => {
      const r = stageEl.getBoundingClientRect()
      const px = (e.clientX - r.left) / r.width - 0.5
      const py = (e.clientY - r.top) / r.height - 0.5
      stageEl.style.setProperty('--px', px.toFixed(3))
      stageEl.style.setProperty('--py', py.toFixed(3))
    })
    stageEl.addEventListener('mouseleave', () => {
      stageEl.style.setProperty('--px', '0')
      stageEl.style.setProperty('--py', '0')
    })
  }

  // --- mobile: focus-by-distance-from-centre on the pill reel -----------

  if (reelEl && pillEls.length) {
    let reelTicking = false

    function updateReelFocus() {
      reelTicking = false
      const viewportMid = window.innerHeight / 2
      let nearest = pillEls[0]
      let nearestDist = Infinity
      pillEls.forEach((pill) => {
        const r = pill.getBoundingClientRect()
        const mid = r.top + r.height / 2
        const dist = Math.abs(mid - viewportMid)
        if (dist < nearestDist) {
          nearestDist = dist
          nearest = pill
        }
      })
      // Only the single nearest pill is "focused" - a threshold-based check
      // here (anything within one pill-height of centre) could tag two
      // adjacent pills at once when the scroll settles between them.
      pillEls.forEach((pill) => pill.classList.toggle('pill--focused', pill === nearest))
      const idx = Number(nearest.dataset.index)
      if (idx !== homeCurrent) {
        homeCurrent = idx
        const item = items[idx]
        mobileBackdrop.setPalette(ambientPalette(item.color, 0.55))
        if (reelOneLinerEl) reelOneLinerEl.textContent = item.oneLiner
        if (reelStatusEl) reelStatusEl.textContent = item.status
      }
    }

    reelEl.addEventListener(
      'scroll',
      () => {
        if (!reelTicking) {
          reelTicking = true
          requestAnimationFrame(updateReelFocus)
        }
      },
      { passive: true },
    )
    updateReelFocus()
  }

  applyStage(0)
</script>

<script>
  // Search - client-side fuzzy match over the same roster data, no backend.
  // No server, no third-party API - Fuse.js fuzzy-matches the roster data
  // that's already bundled into this page at build time, entirely client-side.
  import Fuse from 'fuse.js'

  const items = JSON.parse(document.getElementById('rosterData').textContent)

  const searchBtn = document.getElementById('homeSearchBtn')
  const searchOverlay = document.getElementById('searchOverlay')
  const searchInput = document.getElementById('searchInput')
  const searchResultsEl = document.getElementById('searchResults')
  const searchCloseBtn = document.getElementById('searchClose')

  const fuse = new Fuse(items, {
    keys: [
      { name: 'name', weight: 2 },
      { name: 'tissue', weight: 1 },
      { name: 'oneLiner', weight: 1 },
    ],
    threshold: 0.35,
    ignoreLocation: true,
  })

  let activeIndex = -1

  function renderResults(query) {
    const results = query.trim() ? fuse.search(query, { limit: 8 }).map((r) => r.item) : items.slice(0, 8)
    activeIndex = -1
    if (results.length === 0) {
      searchResultsEl.innerHTML = `<li class="search-empty">No apps match "${query}"</li>`
      return
    }
    searchResultsEl.innerHTML = results
      .map(
        (it, i) => `
      <li>
        <a class="search-result" data-index="${i}" href="${it.href}"${it.external ? ' target="_blank" rel="noopener noreferrer"' : ''}>
          <span class="search-result-swatch" style="background:${it.color}"></span>
          <span class="search-result-text">
            <span class="search-result-name">${it.name}</span>
            <span class="search-result-meta">${it.tissue} &middot; ${it.status}</span>
          </span>
        </a>
      </li>`,
      )
      .join('')
  }

  function openSearch() {
    searchOverlay.classList.add('open')
    searchOverlay.setAttribute('aria-hidden', 'false')
    renderResults('')
    searchInput.value = ''
    searchInput.focus()
  }

  function closeSearch() {
    searchOverlay.classList.remove('open')
    searchOverlay.setAttribute('aria-hidden', 'true')
    searchBtn.focus()
  }

  searchBtn.addEventListener('click', openSearch)
  searchCloseBtn.addEventListener('click', closeSearch)
  searchOverlay.addEventListener('click', (e) => {
    if (e.target === searchOverlay) closeSearch()
  })
  searchInput.addEventListener('input', () => renderResults(searchInput.value))

  document.addEventListener('keydown', (e) => {
    if ((e.key === '/' || (e.key === 'k' && (e.metaKey || e.ctrlKey))) && !searchOverlay.classList.contains('open')) {
      const tag = document.activeElement?.tagName
      if (tag === 'INPUT' || tag === 'TEXTAREA') return
      e.preventDefault()
      openSearch()
    } else if (e.key === 'Escape' && searchOverlay.classList.contains('open')) {
      closeSearch()
    } else if (searchOverlay.classList.contains('open') && (e.key === 'ArrowDown' || e.key === 'ArrowUp')) {
      const results = Array.from(searchResultsEl.querySelectorAll('.search-result'))
      if (!results.length) return
      e.preventDefault()
      results[activeIndex]?.classList.remove('active')
      activeIndex =
        e.key === 'ArrowDown' ? (activeIndex + 1) % results.length : (activeIndex - 1 + results.length) % results.length
      results[activeIndex].classList.add('active')
      results[activeIndex].scrollIntoView({ block: 'nearest' })
    } else if (searchOverlay.classList.contains('open') && e.key === 'Enter' && activeIndex >= 0) {
      const results = Array.from(searchResultsEl.querySelectorAll('.search-result'))
      results[activeIndex]?.click()
    }
  })
</script>
