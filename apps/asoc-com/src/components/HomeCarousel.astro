  }
  .home-links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 7px;
  }
  .home-links a {
    pointer-events: auto;
    font-family: var(--font-mono);
    font-size: clamp(9px, 0.72vw, 11px);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--home-muted);
    text-decoration: none;
    background: none;
    border: 0;
    padding: 0;
    cursor: pointer;
    transition: color 0.15s;
  }
  .home-links a:hover {
    color: var(--home-ink);
  }
  .home-brand {
    display: flex;
    align-items: center;
    gap: 12px;
    pointer-events: auto;
  }
  .home-brand-wordmark {
    font-family: var(--font-ui);
    font-weight: 700;
    font-size: clamp(15px, 2vw, 26px);
    line-height: 0.95;
    letter-spacing: 0.01em;
