  /* ----------------------------------------------------------- mobile --- */

  .scene--mobile {
    display: none;
  }

  @media (max-width: 880px) {
    .scene--desktop {
      display: none;
    }
    .scene--mobile {
      display: block;
      flex: 1;
      position: relative;
      z-index: 3;
      overflow: hidden;
    }

    /* The full-bleed backdrop: the item's accent as one lit, glossy studio
       sweep (brighter where the key light lands upper-left, falling to a
       deep shade at the bottom). Two layers, the top one fading in over the
       other, so an item change is a crossfade rather than a cut. */
    .reel-bg {
      position: absolute;
      inset: 0;
      background: var(--bg-accent);
      background:
        radial-gradient(90% 70% at 30% 20%, rgba(255, 255, 255, 0.26), rgba(255, 255, 255, 0) 62%),
        linear-gradient(180deg, color-mix(in srgb, var(--bg-accent), #000 14%) 0%, color-mix(in srgb, var(--bg-accent), #000 66%) 100%);
      transition: opacity 420ms var(--home-ease);
    }
    .reel-bg--b {
      opacity: 0;
    }

    .reel {
      position: absolute;
      inset: 0;
      overflow: hidden;
      touch-action: none;
      user-select: none;
      -webkit-user-select: none;
      transition:
        opacity 190ms var(--home-ease),
        transform 190ms var(--home-ease);
    }
    /* Changing section: the list slides off one way as it fades, the new
       one arrives from the other (JS sets --swap-dir to +1 or -1 by nav
       direction). */
    .reel.is-swapping {
      opacity: 0;
      transform: translateY(calc(var(--swap-dir, 1) * -6vh));
    }
    /* The stack: one name per screen-sixth (measured: pitch = 1/6 of the
       frame height, the focused one on the centre line). JS positions the
       track every frame from its spring; --pitch's 1/6-of-viewport default
       only covers the first paint, before JS measures the real reel. */
    .reel-track {
      position: absolute;
      top: 50%;
      left: 0;
      right: 0;
      margin: 0;
      padding: 0;
      list-style: none;
      --pitch: 16.6667vh;
      transform: translateY(calc(var(--pitch) * -0.5));
      will-change: transform;
    }
    .pill-slot {
      height: var(--pitch);
      display: flex;
      align-items: center;
      justify-content: center;
      opacity: 0.12;
    }
    .pill-slot.is-near {
      opacity: 1;
    }
    /* Plain names, no box: the drop (the canvas over the track) is what
       holds the centre one. Generous padding keeps the tap target tall
       without drawing anything. */
    .pill {
      position: relative;
      display: inline-block;
      padding: 0.35em 0.9em;
      color: #fff;
      text-decoration: none;
      font-family: var(--font-ui);
      font-weight: 400;
      font-size: clamp(20px, 3.8vh, 34px);
      line-height: 1.1;
      letter-spacing: -0.01em;
      /* Section entries have longer names than apps: let a name wrap onto a
         second line (balanced, centred) rather than run off the edge. */
      white-space: normal;
      text-align: center;
      text-wrap: balance;
      max-width: 84vw;
    }
    .pill-slot.is-near .pill {
      font-weight: 500;
    }
    .pill__name {
      display: -webkit-box;
      -webkit-box-orient: vertical;
      -webkit-line-clamp: 2;
      line-clamp: 2;
      overflow: hidden;
    }
    .pill:focus-visible {
      outline: 2px solid #fff;
      outline-offset: 4px;
    }
    /* The drop: a canvas the height of three pitches, centred on the
       centre line, above the names (they read through it) and never in
       the way of a tap. */
    .reel-cell {
      position: absolute;
      left: 0;
      top: 50%;
      width: 100%;
      height: calc(var(--pitch, 16.6667vh) * 3);
      transform: translateY(-50%);
      z-index: 3;
      pointer-events: none;
    }

    @media (prefers-reduced-motion: reduce) {
      .reel-bg,
      .reel {
        transition: none;
      }
    }
  }

  /* ------------------------------------------------------------ footer -- */

  /* Floats over the stage (the stage is the whole viewport; nothing gets
     its own band). Three columns: the link list + wordmark bottom-left,
     the copyright centre-bottom, nothing right - the current product's
     name already lives top-right. Only the words themselves take the
     pointer, so the train underneath stays hoverable around them. */
  .home-foot {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 5;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: end;
    padding: 0 3.4% 2.4%;
    pointer-events: none;
  }
  .home-foot__left {
    display: flex;
