<script type="application/json" id="rosterData" set:html={JSON.stringify(searchItems)} />
<script type="application/json" id="sectionsData" set:html={JSON.stringify({ order: sectionOrder, sections: sectionData })} />
<script type="application/json" id="flowLanes" set:html={JSON.stringify({ lanes: LANES, dir: DIR, nrm: NRM, stepH: STEP_H })} />

<script>
  // The conveyor + reel engine. Roster and lane data come in via the JSON
  // islands above so the same numbers the server laid out with drive the
  // motion here.
  const { order: SECTION_ORDER, sections: SECTIONS_DATA } = JSON.parse(document.getElementById('sectionsData').textContent)
  // The mobile reel's list: starts as Apps (what the server rendered) and is
  // swapped wholesale when the section changes. The desktop conveyor keeps
  // its own (cItems, below) so the two scenes can be on different sections
  // for the moment between a resize and the next frame.
  let items = SECTIONS_DATA.apps.items
  let total = items.length
  const { lanes: LANES, dir: DIR, nrm: NRM, stepH: STEP_H } = JSON.parse(
    document.getElementById('flowLanes').textContent,
  )

  const reducedQuery = window.matchMedia('(prefers-reduced-motion: reduce)')
  const mobileQuery = window.matchMedia('(max-width: 880px)')

  const sceneDesktopEl = document.getElementById('sceneDesktop')
  const sceneMobileEl = document.getElementById('sceneMobile')

  function applyLink(el, item) {
    // An empty section's tiles are plain glass: no destination, so no href
    // (never '#').
    if (item.empty) el.removeAttribute('href')
    else el.href = item.href
    el.setAttribute('aria-label', `${item.kicker}: ${item.name}`)
    if (item.external) {
      el.setAttribute('target', '_blank')
      el.setAttribute('rel', 'noopener noreferrer')
    } else {
      el.removeAttribute('target')
      el.removeAttribute('rel')
    }
  }

  // ======================================================================
  // Desktop: the conveyor
  // ======================================================================
  const stageEl = document.getElementById('flowStage')
  const cardEls = Array.from(stageEl.querySelectorAll('.flow-card'))
  const focusEl = document.getElementById('flowFocus')
  const focusNameEl = document.getElementById('flowFocusName')
  const focusKickerEl = document.getElementById('flowFocusKicker')
  const focusStatusEl = document.getElementById('flowFocusStatus')
  const focusLineEl = document.getElementById('flowFocusLine')
  const focusLinkEl = document.getElementById('flowFocusLink')
  const focusMoreEl = document.getElementById('flowFocusMore')

  // One step every 5/7s: the reference's 5s loop is seven steps.
  const PERIOD = 5000 / 7
  // The step's motion profile, as measured off the reference frame by
  // frame (u = fraction of the step elapsed, y = fraction of the move done):
  // a slow start, a whip through the middle (half the distance by u=0.23),
  // then a long settling tail into a hold. Piecewise-linear between these
  // points; the source itself is only 60fps.
  const EASE = [
    [0, 0], [0.05, 0.008], [0.09, 0.03], [0.13, 0.083], [0.18, 0.225], [0.2, 0.35], [0.21, 0.37],
    [0.225, 0.49], [0.235, 0.51], [0.25, 0.6], [0.27, 0.674], [0.28, 0.69], [0.32, 0.785],
    [0.37, 0.855], [0.43, 0.915], [0.47, 0.935], [0.55, 0.978], [0.62, 0.99], [0.7, 0.997],
    [0.8, 1], [1, 1],
  ]
  function easeStep(u) {
    if (u <= 0) return 0
    if (u >= 1) return 1
    let i = 1
    while (EASE[i][0] < u) i++
    const [u0, y0] = EASE[i - 1]
    const [u1, y1] = EASE[i]
    return y0 + ((y1 - y0) * (u - u0)) / (u1 - u0)
  }

  let laneCount = 9
  let cardH = 300
  const laneLap = new Array(LANES.length).fill(null)
  const laneItem = new Array(LANES.length).fill(null)
  let focusedLane = -1
  let swapTimer = null

  // What the lanes show, and how a lane's lap maps to an item. Lane k on lap
  // L shows cItems[(k + L*n - cBase) mod cTotal]; at rest the lane nearest the
  // centre has k + L*n equal to the train's integer position, so cBase is
  // simply "the position at which this section's item 0 sits at the centre".
  // Changing section changes cItems and cBase and nothing else - a lane
  // re-reads its item only when its lap changes (it wraps, off-screen), so
  // the cards on screen keep their old tint until they have left.
  let cItems = items
  let cTotal = cItems.length
  let cBase = 0
  let conveyorSection = 'apps'
  // Integer slots the whole train has been advanced by completed shifts
  // (always a multiple of n, so adding it changes nothing about the layout),
  // and each lane's extra advance while a shift is in flight.
  let shiftOffset = 0
  const extra = new Array(LANES.length).fill(0)
  let shift = null
  let queuedSection = null
  let curS = 0 // the clock's position in slots, as of the latest frame

  // The shift: the whole train runs one lap along its own track - old tiles
  // leave up-left, the new section's arrive from the bottom-right - and lands
  // exactly where it started (a lap is a whole number of slots), with every
  // lane carrying a tile of the new section. Lanes with a higher z are nearer
  // the viewer and finish sooner: that spread of speeds is the parallax. The
  // measured per-step whip is no use at this scale (a lap is ~10 steps in one
  // second), so this is a plain symmetric ease.
  const SHIFT_MS = 1100
  function easeInOutCubic(p) {
    return p < 0.5 ? 4 * p * p * p : 1 - Math.pow(-2 * p + 2, 3) / 2
  }

  // How many lanes this viewport needs: enough that the point where a lane
  // wraps from the far top-left back to the far bottom-right (slot +n/2 ->
  // -n/2) is always past the stage edge plus a card, so the wrap is never
  // seen. Odd, like the reference's seven, and never more lanes than roster
  // items (two lanes would then show the same item at once).
  function layout() {
    const w = stageEl.clientWidth
    const h = stageEl.clientHeight
    cardH = cardEls[0].offsetHeight / LANES[0].scale || cardH
    const halfExtent = (w / 2) * Math.abs(DIR.x) + (h / 2) * Math.abs(DIR.y)
    const need = 2 * Math.ceil((halfExtent + 0.7 * cardH) / (STEP_H * cardH)) + 1
    // Never fewer than the reference's seven, never more than there are
    // lanes - and, now that the item list changes with the section, never
    // dependent on how many items a section has (a short section simply
    // repeats its tiles; the lane count must not move mid-shift).
    const n = Math.max(7, Math.min(LANES.length, need))
    if (n !== laneCount) {
      laneCount = n
      laneLap.fill(null)
      // A lap is n slots; if n changed, a shift in flight no longer lands
      // on the rigid pattern, so drop it (the section is already set).
      if (shift) abortShift()
    }
    cardEls.forEach((el, k) => {
      el.style.display = k < laneCount ? '' : 'none'
    })
    // The name and details sit 1.55 card heights right of centre. If what is
    // left of the viewport to their right is too narrow to read, they move
    // up to the corner under the section names instead.
    const room = w * (0.5 - 0.034) - 1.55 * cardH
    sceneDesktopEl.classList.toggle('is-compact', room < 200)
  }

  function setLinkTarget(a, href, external) {
    a.href = href
    if (external) {
      a.setAttribute('target', '_blank')
      a.setAttribute('rel', 'noopener noreferrer')
    } else {
      a.removeAttribute('target')
      a.removeAttribute('rel')
    }
  }
  function setArrowLabel(a, label) {
    const arrow = document.createElement('span')
    arrow.setAttribute('aria-hidden', 'true')
    arrow.textContent = '\u2192'
    a.replaceChildren(document.createTextNode(`${label} `), arrow)
  }

  // Write an item into the name-and-details block.
  function writeFocus(item) {
    focusEl.style.setProperty('--focus-accent', item.color)
    focusNameEl.textContent = item.name
    focusKickerEl.textContent = item.kicker
    focusStatusEl.textContent = item.status || ''
    focusLineEl.textContent = item.oneLiner
    setLinkTarget(focusLinkEl, item.href, item.external)
    setArrowLabel(focusLinkEl, item.empty ? 'Contact' : 'View')
    const sec = SECTIONS_DATA[item.section]
    focusMoreEl.hidden = item.section === 'apps'
    if (item.section !== 'apps') {
      setLinkTarget(focusMoreEl, sec.href, false)
      setArrowLabel(focusMoreEl, `All ${sec.label.toLowerCase()}`)
    }
  }

  function setFocus(k) {
    focusedLane = k
    const item = laneItem[k]
    focusEl.classList.add('is-swapping')
    clearTimeout(swapTimer)
    swapTimer = setTimeout(() => {
      writeFocus(item)
      // While tiles are shifting the label stays hidden; landing re-reads it.
      if (!shift) focusEl.classList.remove('is-swapping')
    }, 110)
  }

  // s = the train's progress in slots (whole steps taken + the eased
  // fraction of the current one). Lane k sits at slot -k (+ its nudge) + s,
  // wrapped into [-n/2, n/2); each time it wraps (off-screen, far top-left
  // to far bottom-right) it takes the next roster item, n further on, so
  // the centre slot sees the roster in order and no two lanes share an item.
  function render(s) {
    const n = laneCount
    let bestK = 0
    let bestAbs = Infinity
    for (let k = 0; k < n; k++) {
      const L = LANES[k]
      const el = cardEls[k]
      const raw = -k + L.frac + s + shiftOffset + extra[k]
      const lap = Math.floor((raw + n / 2) / n)
      const along = raw - lap * n
      if (lap !== laneLap[k]) {
        laneLap[k] = lap
        const item = cItems[(((k + lap * n - cBase) % cTotal) + cTotal) % cTotal]
        laneItem[k] = item
        applyLink(el, item)
        el.style.setProperty('--accent', item.color)
      }
      el.style.setProperty('--kx', (STEP_H * along * DIR.x + L.lat * NRM.x).toFixed(4))
      el.style.setProperty('--ky', (STEP_H * along * DIR.y + L.lat * NRM.y).toFixed(4))
      el.style.setProperty('--r', `${(L.rate * along).toFixed(2)}deg`)
      const a = Math.abs(along)
      if (a < bestAbs) {
        bestAbs = a
        bestK = k
      }
    }
    if (bestK !== focusedLane && !shift) setFocus(bestK)
  }

  // --- changing section ---------------------------------------------------
  function abortShift() {
    extra.fill(0)
    shift = null
    stageEl.classList.remove('is-shifting')
    queuedSection = null
    focusedLane = -1
  }

  // Start flying to a section: swap the lists now (lanes pick the new one up
  // as they wrap) and let every lane run one lap, forward when the target is
  // to the right in the nav, backward when it is to the left.
  function startShift(slug) {
    const dir = SECTION_ORDER.indexOf(slug) > SECTION_ORDER.indexOf(conveyorSection) ? 1 : -1
    const n = laneCount
    cItems = SECTIONS_DATA[slug].items
    cTotal = cItems.length
    // Position (in whole slots) at which the lap lands; item 0 sits at the
    // centre there. The clock is held for the flight, so this is exact.
    cBase = Math.round(curS + shiftOffset) + dir * n
    hoverPaused = false
    stageEl.classList.add('is-shifting')
    focusEl.classList.add('is-swapping')
    shift = { dir, n, slug, start: null, dur: LANES.map((L) => SHIFT_MS * (1.15 - 0.1 * L.z)) }
  }

  function advanceShift(ts) {
    if (shift.start == null) shift.start = ts
    const t = ts - shift.start
    let done = true
    for (let k = 0; k < LANES.length; k++) {
      const p = Math.min(1, t / shift.dur[k])
      if (p < 1) done = false
      extra[k] = shift.dir * shift.n * easeInOutCubic(p)
    }
    if (done) landShift()
  }

  function landShift() {
    // A whole lap changes nothing about where lanes sit, so fold it into the
    // offset and zero the extras without a visible jump.
    shiftOffset += shift.dir * shift.n
    extra.fill(0)
    conveyorSection = shift.slug
    shift = null
    stageEl.classList.remove('is-shifting')
    focusedLane = -1 // the next render re-reads and reveals the label
    const queued = queuedSection
    queuedSection = null
    if (queued && queued !== conveyorSection) startShift(queued)
  }

  // No flight: used for the first paint of a #section URL, for reduced
  // motion, and to catch the conveyor up after the phone layout was live.
  function applySectionInstant(slug) {
    if (shift) abortShift()
    cItems = SECTIONS_DATA[slug].items
    cTotal = cItems.length
    cBase = Math.round(curS + shiftOffset)
    conveyorSection = slug
    laneLap.fill(null)
    focusedLane = -1
  }

  // One clock for the whole train. It only advances while the conveyor is
  // actually the thing on screen, nothing is hovered, and the tab is
  // visible - so hovering freezes every lane together (a moving target
  // can't be clicked; a train that keeps going around a frozen card would
  // break the rigid pattern), and a backgrounded tab resumes where it
  // stopped rather than jumping ahead.
  let elapsed = 0
  let lastTs = null
  let hoverPaused = false
  let rafId = 0
  function frame(ts) {
    if (lastTs != null) {
      const dt = ts - lastTs
      // The step clock is held while a shift flies, so the train lands in
      // exactly the phase it left and resumes from there.
      if (!hoverPaused && !document.hidden && !shift && dt < 500) elapsed += dt
    }
    lastTs = ts
    const steps = Math.floor(elapsed / PERIOD)
    curS = steps + easeStep((elapsed - steps * PERIOD) / PERIOD)
    if (shift) advanceShift(ts)
    render(curS)
    rafId = requestAnimationFrame(frame)
  }
  function conveyorShouldRun() {
    return !mobileQuery.matches && !reducedQuery.matches
  }
  function startConveyor() {
    if (rafId) return
    layout()
    lastTs = null
    rafId = requestAnimationFrame(frame)
  }
  function stopConveyor() {
    if (!rafId) return
    cancelAnimationFrame(rafId)
    rafId = 0
  }
  function syncConveyor() {
    if (conveyorShouldRun()) {
      if (conveyorSection !== currentSection) applySectionInstant(currentSection)
      startConveyor()
    } else stopConveyor()
  }

  stageEl.addEventListener('pointerover', (e) => {
    hoverPaused = !!e.target.closest('.flow-card')
  })
  stageEl.addEventListener('pointerleave', () => {
    hoverPaused = false
  })
  // The details link is the one interactive bit beside the train: hold the
  // clock while it is hovered or focused so the label can't change under a
  // click.
  for (const ev of ['pointerenter', 'focusin']) focusEl.addEventListener(ev, () => (hoverPaused = true))
  for (const ev of ['pointerleave', 'focusout']) focusEl.addEventListener(ev, () => (hoverPaused = false))
  new ResizeObserver(() => {
    if (rafId) layout()
  }).observe(stageEl)

  // ======================================================================
  // Mobile: the reel, and the drop it runs through
  // ======================================================================
  const reelEl = document.getElementById('reel')
  const trackEl = document.getElementById('reelTrack')
  const cellCanvas = document.getElementById('reelCell')
  const cellCtx = cellCanvas.getContext('2d')
  const bgAEl = document.getElementById('reelBgA')
  const bgBEl = document.getElementById('reelBgB')

  // Three copies of the list so the stack wraps seamlessly: the middle copy
  // is the real one (real links, in the tab order); the copies either side
  // are decorative clones the position slides through before being shifted
  // back a whole copy - which is invisible, since the copies are identical.
  const baseSlots = Array.from(trackEl.children)
  function cloneSlot(el) {
    const c = el.cloneNode(true)
    c.setAttribute('aria-hidden', 'true')
    c.classList.remove('is-near')
    c.querySelectorAll('a').forEach((a) => {
      a.tabIndex = -1
    })
    return c
  }
  trackEl.prepend(...baseSlots.map(cloneSlot))
  trackEl.append(...baseSlots.map(cloneSlot))
  let slotEls = Array.from(trackEl.children)
  let reelSection = 'apps'

  // Reference: one name every 1.25s.
  const REEL_PERIOD = 1250
  // The list's spring, in slot units: stiff enough to arrive in well under
  // a second, damped past critical so it never overshoots - it pours into
  // place rather than snapping. (zeta > 1 = overdamped.)
  const LIST_K = 34
  const LIST_ZETA = 1.12
  // While a finger is down the list chases it through a low-pass, not
  // 1:1 - that lag is the viscosity you feel.
  const DRAG_FOLLOW = 9

  let pitch = 140
  let pos = total // continuous position, in slots; the centre line sits on slot `pos`
  let target = total
  let vel = 0
  let near = -1
  let bgVisible = bgAEl
  let bgItem = null
  let interactUntil = 0
  let lastAuto = 0
  let reelRaf = 0
  let reelLast = null
  let paintedLo = 0
  let paintedHi = -1

  // --- the drop: a soft-body membrane ----------------------------------
  // A ring of points, each on a spring to its rest position on an ellipse
  // wrapped around the centre name, sprung to its neighbours so the skin
  // stays smooth, underdamped so it wobbles a couple of times before it
  // settles, and dragged by the list's velocity - most at the top and
  // bottom, where the passing names pull on it - so it stretches along
  // with them and springs back. The ellipse's width chases each new
  // centre name, so the drop re-wraps rather than jumps.
  const CELL_N = 28
  const CELL_K = 180
  const CELL_KN = 120
  const CELL_C = 2 * 0.3 * Math.sqrt(CELL_K)
  const CELL_DRAG = 5.5
  const cell = Array.from({ length: CELL_N }, () => ({ x: 0, y: 0, vx: 0, vy: 0 }))
  let cellA = 90
  let cellB = 32
  let cellATarget = 90
  let cellBTarget = 32
  let cellAccent = items[0].color
  let cellTime = 0
  let cellDpr = 1

  function layoutReel() {
    pitch = reelEl.clientHeight / 6
    trackEl.style.setProperty('--pitch', `${pitch}px`)
    cellDpr = Math.min(2, window.devicePixelRatio || 1)
    const w = reelEl.clientWidth
    const h = pitch * 3
    cellCanvas.width = Math.round(w * cellDpr)
    cellCanvas.height = Math.round(h * cellDpr)
    cellCanvas.style.height = `${h}px`
    cellCtx.setTransform(cellDpr, 0, 0, cellDpr, 0, 0)
    // Rest shape from the centre name's real box.
    fitCell()
  }

  function fitCell() {
    const slot = slotEls[near]
    const name = slot && slot.querySelector('.pill__name')
    if (!name) return
    const r = name.getBoundingClientRect()
    cellATarget = r.width / 2 + Math.max(22, pitch * 0.18)
    cellBTarget = r.height / 2 + Math.max(14, pitch * 0.12)
  }

  function hexToRgb(hex) {
    const h = hex.replace('#', '')
    const n = parseInt(h.length === 3 ? h.replace(/./g, (c) => c + c) : h, 16)
    return [(n >> 16) & 255, (n >> 8) & 255, n & 255]
  }

  function stepCell(dt, listVelPx, animate) {
    cellTime += dt
    cellA += (cellATarget - cellA) * (1 - Math.exp(-dt * 7))
    cellB += (cellBTarget - cellB) * (1 - Math.exp(-dt * 7))
    for (let i = 0; i < CELL_N; i++) {
      const th = (i / CELL_N) * Math.PI * 2
      const c = Math.cos(th)
      const s = Math.sin(th)
      const r = (cellA * cellB) / Math.sqrt(cellB * cellB * c * c + cellA * cellA * s * s)
      const breathe = animate ? 1 + 0.022 * Math.sin(cellTime * 1.1 + th * 3) + 0.014 * Math.sin(cellTime * 1.9 - th * 2) : 1
      const rx = r * c * breathe
      const ry = r * s * breathe + (s > 0 ? 5 * s * s : 0) // a little sag at the bottom
      const p = cell[i]
      const prev = cell[(i + CELL_N - 1) % CELL_N]
      const next = cell[(i + 1) % CELL_N]
      let fx = CELL_K * (rx - p.x) + CELL_KN * ((prev.x + next.x) / 2 - p.x) - CELL_C * p.vx
      let fy = CELL_K * (ry - p.y) + CELL_KN * ((prev.y + next.y) / 2 - p.y) - CELL_C * p.vy
      if (animate) fy -= CELL_DRAG * listVelPx * (0.35 + 0.65 * Math.abs(s))
      p.vx += fx * dt
      p.vy += fy * dt
      p.x += p.vx * dt
      p.y += p.vy * dt
    }
  }

  function drawCell() {
    const w = cellCanvas.width / cellDpr
    const h = cellCanvas.height / cellDpr
    const cx = w / 2
    const cy = h / 2
    const ctx = cellCtx
    ctx.clearRect(0, 0, w, h)
    ctx.beginPath()
    for (let i = 0; i < CELL_N; i++) {
      const p0 = cell[(i + CELL_N - 1) % CELL_N]
      const p1 = cell[i]
      const p2 = cell[(i + 1) % CELL_N]
      const p3 = cell[(i + 2) % CELL_N]
      if (i === 0) ctx.moveTo(cx + p1.x, cy + p1.y)
      ctx.bezierCurveTo(
        cx + p1.x + (p2.x - p0.x) / 6,
        cy + p1.y + (p2.y - p0.y) / 6,
        cx + p2.x - (p3.x - p1.x) / 6,
        cy + p2.y - (p3.y - p1.y) / 6,
        cx + p2.x,
        cy + p2.y,
      )
    }
    ctx.closePath()
    const [ar, ag, ab] = hexToRgb(cellAccent)
    // Body: a translucent film with a key light from the upper-left and
    // the accent gathering at the lower-right edge - the name reads through
    // it. Drawn with a soft shadow so it sits on the backdrop.
    ctx.save()
    ctx.shadowColor = 'rgba(0, 0, 0, 0.3)'
    ctx.shadowBlur = 26
    ctx.shadowOffsetY = 10
    const body = ctx.createRadialGradient(cx - cellA * 0.4, cy - cellB * 0.7, 0, cx, cy, cellA * 1.25)
    body.addColorStop(0, 'rgba(255, 255, 255, 0.22)')
    body.addColorStop(0.42, 'rgba(255, 255, 255, 0.09)')
    body.addColorStop(1, `rgba(${ar}, ${ag}, ${ab}, 0.3)`)
    ctx.fillStyle = body
    ctx.fill()
    ctx.restore()
    // Meniscus: a soft, diffuse rim - wet, not glass.
    ctx.save()
    ctx.clip()
    ctx.shadowColor = 'rgba(255, 255, 255, 0.35)'
    ctx.shadowBlur = 14
    ctx.lineWidth = 1.6
    ctx.strokeStyle = 'rgba(255, 255, 255, 0.24)'
    ctx.stroke()
    // Depth: the underside darkens.
    const under = ctx.createRadialGradient(cx, cy + cellB * 0.9, 0, cx, cy + cellB * 0.6, cellA * 0.95)
    under.addColorStop(0, 'rgba(0, 0, 0, 0.18)')
    under.addColorStop(1, 'rgba(0, 0, 0, 0)')
    ctx.fillStyle = under
    ctx.fillRect(0, 0, w, h)
    // Specular: one soft, spread highlight, upper-left, off the letters.
    ctx.shadowColor = 'rgba(255, 255, 255, 0.5)'
    ctx.shadowBlur = 16
    ctx.fillStyle = 'rgba(255, 255, 255, 0.3)'
    ctx.beginPath()
    ctx.ellipse(cx - cellA * 0.5, cy - cellB * 0.48, cellA * 0.22, cellB * 0.17, -0.35, 0, Math.PI * 2)
    ctx.fill()
    ctx.restore()
  }

  // --- changing section ---------------------------------------------------
  function buildSlot(it, i) {
    const li = document.createElement('li')
    li.className = 'pill-slot'
    li.dataset.index = String(i)
    const a = document.createElement('a')
    a.className = 'pill'
    a.href = it.href
    if (it.external) {
      a.target = '_blank'
      a.rel = 'noopener noreferrer'
    }
    const name = document.createElement('span')
    name.className = 'pill__name'
    name.textContent = it.name
    a.append(name)
    li.append(a)
    return li
  }

  // Replace the whole stack with a section's names, keeping the three-copy
  // layout, and put the centre line on its first one.
  function rebuildReel(slug) {
    items = SECTIONS_DATA[slug].items
    total = items.length
    reelSection = slug
    const real = items.map(buildSlot)
    trackEl.replaceChildren(...real.map(cloneSlot), ...real, ...real.map(cloneSlot))
    slotEls = Array.from(trackEl.children)
    pos = target = dragStartPos = total
    vel = 0
    near = -1
    paintedLo = 0
    paintedHi = -1
    lastAuto = performance.now()
    setNear(total)
    paintList()
  }

  let reelSwapTimer = 0
  // The live way to change section on the phone: the list slides off in the
  // direction of travel as it fades, then the new section's list arrives
  // from the other side. Latest request wins.
  function swapReel(slug, animate) {
    if (!reelRaf) return // the reel isn't what's showing; startReel catches up
    if (!animate) {
      rebuildReel(slug)
      return
    }
    const dir = SECTION_ORDER.indexOf(slug) >= SECTION_ORDER.indexOf(reelSection) ? 1 : -1
    reelEl.style.setProperty('--swap-dir', String(dir))
    reelEl.classList.add('is-swapping')
    clearTimeout(reelSwapTimer)
    reelSwapTimer = setTimeout(() => {
      rebuildReel(currentSection)
      // Come in from the opposite side: move there with no transition, then
      // release.
      reelEl.style.transition = 'none'
      reelEl.style.setProperty('--swap-dir', String(-dir))
      void reelEl.offsetWidth
      reelEl.style.transition = ''
      reelEl.classList.remove('is-swapping')
    }, 200)
  }

  // --- the list ----------------------------------------------------------
  function setBackdrop(item) {
    if (item === bgItem) return
    bgItem = item
    cellAccent = item.color
    const show = bgVisible === bgAEl ? bgBEl : bgAEl
    show.style.setProperty('--bg-accent', item.color)
    show.style.opacity = '1'
    bgVisible.style.opacity = '0'
    bgVisible = show
  }

  function setNear(n) {
    if (n === near) return
    if (near >= 0) slotEls[near].classList.remove('is-near')
    near = n
    slotEls[n].classList.add('is-near')
    setBackdrop(items[((n % total) + total) % total])
    fitCell()
  }

  function opacityFor(d) {
    if (d <= 1) return 1 - 0.5 * d
    if (d <= 4) return 0.5 - 0.12 * (d - 1)
    return 0.12
  }

  function paintList() {
    const lo = Math.max(0, Math.floor(pos) - 6)
    const hi = Math.min(slotEls.length - 1, Math.ceil(pos) + 6)
    for (let i = paintedLo; i <= paintedHi; i++) if (i < lo || i > hi) slotEls[i].style.opacity = ''
    for (let i = lo; i <= hi; i++) slotEls[i].style.opacity = opacityFor(Math.abs(i - pos)).toFixed(3)
    paintedLo = lo
    paintedHi = hi
    trackEl.style.transform = `translateY(${(-(pos + 0.5) * pitch).toFixed(2)}px)`
  }

  // Keep pos inside the middle copy by shifting a whole copy at a time -
  // the copies are identical, so this never shows.
  function wrapPos() {
    if (pos >= 2 * total) {
      pos -= total
      target -= total
      dragStartPos -= total
      if (near >= 0) setNear(near - total)
    } else if (pos < total) {
      pos += total
      target += total
      dragStartPos += total
      if (near >= 0) setNear(near + total)
    }
  }

  let dragging = false
  let dragStartY = 0
  let dragStartPos = 0
  let dragY = 0
  let dragPrevY = 0
  let dragPrevT = 0
  let dragVel = 0 // px per ms, screen-down positive
  let suppressClick = false

  function reelFrame(ts) {
    reelRaf = requestAnimationFrame(reelFrame)
    if (reelLast == null) reelLast = ts
    const dt = Math.min(0.05, (ts - reelLast) / 1000)
    reelLast = ts
    const animate = !reducedQuery.matches
    if (!document.hidden && animate && !dragging && ts > interactUntil && ts - lastAuto > REEL_PERIOD) {
      target += 1
      lastAuto = ts
    }
    if (dragging) {
      const want = dragStartPos + (dragStartY - dragY) / pitch
      vel = (want - pos) * DRAG_FOLLOW
      pos += vel * dt
    } else {
      const c = 2 * LIST_ZETA * Math.sqrt(LIST_K)
      vel += (LIST_K * (target - pos) - c * vel) * dt
      pos += vel * dt
      if (Math.abs(target - pos) < 0.0005 && Math.abs(vel) < 0.002) {
        pos = target
        vel = 0
      }
    }
    wrapPos()
    setNear(Math.round(pos))
    paintList()
    stepCell(dt, vel * pitch, animate)
    drawCell()
  }

  function startReel() {
    if (reelRaf) return
    // The section may have changed while the reel was off screen.
    if (reelSection !== currentSection) rebuildReel(currentSection)
    layoutReel()
    reelLast = null
    lastAuto = performance.now()
    reelRaf = requestAnimationFrame(reelFrame)
  }
  function stopReel() {
    if (!reelRaf) return
    cancelAnimationFrame(reelRaf)
    reelRaf = 0
  }

  function touched(ts) {
    interactUntil = ts + 4000
    lastAuto = interactUntil - REEL_PERIOD + 700
  }

  // Swipes drive the list by hand (touch-action: none on .reel hands every
  // vertical drag to these instead of the page): while the finger is down
  // the list follows it with lag; on release it settles onto the nearest
  // slot, or one further along if the finger was still moving. A tap still
  // clicks the name's link; a drag that ends on one must not.
  // No pointer capture here: a captured pointer's click lands on the
  // capturing element, which would swallow a tap on a name's link. The
  // window-level listeners catch a finger that lifts off the reel instead.
  reelEl.addEventListener('pointerdown', (e) => {
    dragging = true
    dragStartY = dragY = dragPrevY = e.clientY
    dragStartPos = pos
    dragPrevT = e.timeStamp
    dragVel = 0
    touched(performance.now())
  })
  window.addEventListener('pointermove', (e) => {
    if (!dragging) return
    dragY = e.clientY
    const dtms = e.timeStamp - dragPrevT
    if (dtms > 0) dragVel = (dragY - dragPrevY) / dtms
    dragPrevY = dragY
    dragPrevT = e.timeStamp
  })
  function endDrag() {
    if (!dragging) return
    dragging = false
    const moved = dragStartY - dragY
    // Throw: a still-moving finger carries it one more slot at most - thick
    // liquid doesn't fling - and a finger that paused before lifting
    // carries nothing (its last measured velocity is stale).
    if (performance.now() - dragPrevT > 80) dragVel = 0
    const carry = Math.max(-1, Math.min(1, (-dragVel * 1000) / pitch / 6))
    const base = Math.round(pos)
    target = Math.max(base - 1, Math.min(base + 1, Math.round(pos + carry)))
    suppressClick = Math.abs(moved) > 10
    touched(performance.now())
  }
  window.addEventListener('pointerup', endDrag)
  window.addEventListener('pointercancel', endDrag)
  reelEl.addEventListener(
    'click',
    (e) => {
      if (suppressClick) {
        e.preventDefault()
        suppressClick = false
      }
    },
    true,
  )
  let wheelAcc = 0
  let wheelLock = 0
  reelEl.addEventListener(
    'wheel',
    (e) => {
      e.preventDefault()
      const now = performance.now()
      touched(now)
      if (now < wheelLock) return
      wheelAcc += e.deltaY
      if (Math.abs(wheelAcc) > 40) {
        target = Math.round(pos) + (wheelAcc > 0 ? 1 : -1)
        wheelAcc = 0
        wheelLock = now + 450
      }
    },
    { passive: false },
  )
  // Keyboard: tabbing onto a name centres it and holds the auto-advance.
  trackEl.addEventListener('focusin', (e) => {
    const slot = e.target.closest('.pill-slot')
    if (!slot || slot.getAttribute('aria-hidden') === 'true') return
    interactUntil = performance.now() + 6000
    lastAuto = interactUntil
    target = total + Number(slot.dataset.index)
  })
  new ResizeObserver(() => {
    if (reelRaf) layoutReel()
  }).observe(reelEl)

  // ======================================================================
  // Which section is showing
  // ======================================================================
  // The nav links are real pages, so everything here is an enhancement:
  // without JS, or under reduced motion, a click simply navigates.
  let currentSection = 'apps'
  const navEl = document.getElementById('homeSections')
  const navLinks = Array.from(navEl.querySelectorAll('[data-section]'))

  function markNav(slug) {
    for (const a of navLinks) {
      if (a.dataset.section === slug) a.setAttribute('aria-current', 'true')
      else a.removeAttribute('aria-current')
    }
  }

  function goSection(slug, { animate = true, updateUrl = true } = {}) {
    if (!SECTIONS_DATA[slug] || slug === currentSection) return
    currentSection = slug
    markNav(slug)
    if (updateUrl) history.replaceState(null, '', slug === 'apps' ? location.pathname + location.search : `#${slug}`)
    if (mobileQuery.matches) return swapReel(slug, animate)
    // The conveyor isn't running (first paint, or it is stopped): syncConveyor
    // sets it straight when it starts.
    if (!rafId) return
    if (!animate || reducedQuery.matches) return applySectionInstant(slug)
    // Latest request wins; it starts the frame the current flight lands.
    if (shift) {
      queuedSection = slug
      return
    }
    if (slug !== conveyorSection) startShift(slug)
  }

  navEl.addEventListener('click', (e) => {
    const a = e.target.closest('[data-section]')
    if (!a) return
    // Reduced motion, or a modified click (new tab etc.): plain navigation.
    if (reducedQuery.matches || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return
    e.preventDefault()
    goSection(a.dataset.section)
  })
  window.addEventListener('hashchange', () => {
    const slug = location.hash.slice(1)
    goSection(SECTIONS_DATA[slug] ? slug : 'apps', { updateUrl: false })
  })
  // A shared #section link lands on that section with no flight.
  {
    const slug = location.hash.slice(1)
    if (SECTIONS_DATA[slug] && slug !== 'apps') goSection(slug, { animate: false, updateUrl: false })
  }

  // ======================================================================
  // Which scene is live
  // ======================================================================
  function syncScenes() {
    const isMobile = mobileQuery.matches
    sceneDesktopEl.setAttribute('aria-hidden', String(isMobile))
    sceneMobileEl.setAttribute('aria-hidden', String(!isMobile))
    syncConveyor()
    if (isMobile) startReel()
    else stopReel()
  }
  mobileQuery.addEventListener('change', syncScenes)
  reducedQuery.addEventListener('change', syncScenes)
  document.addEventListener('visibilitychange', () => {
    if (!document.hidden) {
      lastTs = null
      reelLast = null
    }
  })
  syncScenes()
</script>

<script>
  // Search - client-side fuzzy match over the same roster data, no backend.
  // No server, no third-party API - Fuse.js fuzzy-matches the roster data
  // that's already bundled into this page at build time, entirely client-side.
  import Fuse from 'fuse.js'

  const items = JSON.parse(document.getElementById('rosterData').textContent)

  const searchBtn = document.getElementById('homeSearchBtn')
  const searchOverlay = document.getElementById('searchOverlay')
  const searchInput = document.getElementById('searchInput')
  const searchResultsEl = document.getElementById('searchResults')
  const searchCloseBtn = document.getElementById('searchClose')

  const fuse = new Fuse(items, {
    keys: [
      { name: 'name', weight: 2 },
      { name: 'sectionLabel', weight: 1 },
      { name: 'kicker', weight: 1 },
      { name: 'oneLiner', weight: 1 },
    ],
    threshold: 0.35,
    ignoreLocation: true,
  })

  let activeIndex = -1

  // Text from the page's own data or the visitor's own typing goes into
  // innerHTML below, so it is escaped first.
  const esc = (t) => String(t).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c])

  function renderResults(query) {
    const results = query.trim() ? fuse.search(query, { limit: 8 }).map((r) => r.item) : items.slice(0, 8)
    activeIndex = -1
    if (results.length === 0) {
      searchResultsEl.innerHTML = `<li class="search-empty">No results for \u201c${esc(query)}\u201d</li>`
      return
    }
    searchResultsEl.innerHTML = results
      .map(
        (it, i) => `
      <li>
        <a class="search-result" data-index="${i}" href="${esc(it.href)}"${it.external ? ' target="_blank" rel="noopener noreferrer"' : ''}>
          <span class="search-result-swatch" style="background:${esc(it.color)}"></span>
          <span class="search-result-text">
            <span class="search-result-name">${esc(it.name)}</span>
            <span class="search-result-meta">${esc(it.sectionLabel)} &middot; ${esc(it.status || it.kicker)}</span>
          </span>
        </a>
      </li>`,
      )
      .join('')
  }

  function openSearch() {
    searchOverlay.classList.add('open')
    searchOverlay.setAttribute('aria-hidden', 'false')
    renderResults('')
    searchInput.value = ''
    searchInput.focus()
  }

  function closeSearch() {
    searchOverlay.classList.remove('open')
    searchOverlay.setAttribute('aria-hidden', 'true')
    searchBtn.focus()
  }

  searchBtn.addEventListener('click', openSearch)
  searchCloseBtn.addEventListener('click', closeSearch)
  searchOverlay.addEventListener('click', (e) => {
    if (e.target === searchOverlay) closeSearch()
  })
  searchInput.addEventListener('input', () => renderResults(searchInput.value))

  document.addEventListener('keydown', (e) => {
    if ((e.key === '/' || (e.key === 'k' && (e.metaKey || e.ctrlKey))) && !searchOverlay.classList.contains('open')) {
      const tag = document.activeElement?.tagName
      if (tag === 'INPUT' || tag === 'TEXTAREA') return
      e.preventDefault()
      openSearch()
    } else if (e.key === 'Escape' && searchOverlay.classList.contains('open')) {
      closeSearch()
    } else if (searchOverlay.classList.contains('open') && (e.key === 'ArrowDown' || e.key === 'ArrowUp')) {
      const results = Array.from(searchResultsEl.querySelectorAll('.search-result'))
      if (!results.length) return
      e.preventDefault()
      results[activeIndex]?.classList.remove('active')
      activeIndex =
        e.key === 'ArrowDown' ? (activeIndex + 1) % results.length : (activeIndex - 1 + results.length) % results.length
      results[activeIndex].classList.add('active')
      results[activeIndex].scrollIntoView({ block: 'nearest' })
    } else if (searchOverlay.classList.contains('open') && e.key === 'Enter' && activeIndex >= 0) {
      const results = Array.from(searchResultsEl.querySelectorAll('.search-result'))
      results[activeIndex]?.click()
    }
  })
</script>
