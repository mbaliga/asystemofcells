---
// component: HomeCarousel
//
// The asystemofcells.com landing mechanism, v3 - "the flow" on desktop, "the
// reel" on mobile. Real roster data on both.
//
// v3 replaces v2's desktop "constellation" (fixed hero + four satellite
// slots, content swapped on a discrete wheel/keyboard step) with a
// continuous diagonal conveyor traced frame-by-frame from the owner's
// reference clips: cards spawn small near the bottom-right, drift up-left
// while growing, and exit large near the top-left, several overlapping at
// once along hand-varied paths (not one straight line - see FLOW_LANES).
// It's ambient/continuous rather than step-driven because that's what the
// reference actually is: nothing in it demonstrates a discrete "step
// forward" interaction, it's a looping showreel. Each lane is a real link
// that recycles to the next roster item every time its own loop restarts
// (invisible, since it's cropped to nothing at that point in the path), so
// over time every item flies past. Hover/focus pauses a card's own lane so
// it's actually clickable; prefers-reduced-motion swaps the whole flow for
// a plain static grid of every item, motion-free and immediately complete
// (a keyboard/AT user isn't required to wait for a specific item's lane to
// come around - search, further down, is the other complete, motion-free
// path to any item at any time).
//
// The mobile reel is unchanged from v2: a full-bleed backdrop behind a
// vertically scroll-snapped stack of name pills that dim by distance from
// the focal centre line.
//
// Data is the real roster (packages/roster) - see the mapping below for which
// real field stands in for each slot.
import { getRoster, TISSUES } from '@asoc/roster'

const tissueLabel = Object.fromEntries(TISSUES.map((t) => [t.slug, t.label]))
const statusLabel = { live: 'Live', beta: 'Beta', soon: 'Soon' }

function titleCase(slug) {
  return slug
    .split('-')
    .map((w) => w.charAt(0).toUpperCase() + w.slice(1))
    .join(' ')
}

const items = getRoster().map((cell) => ({
  key: cell.slug,
  name: titleCase(cell.slug),
  // No real version numbers exist in the roster - status stands in for the
  // small meta line the reference used a version string for.
  status: statusLabel[cell.status] || cell.status,
  tissue: tissueLabel[cell.tissue] || cell.tissue,
  oneLiner: cell.oneLiner,
  color: cell.accent,
  href: cell.isHub ? cell.hubUrl : `/${cell.slug}`,
  external: !!cell.isHub,
}))

// A non-product tile for the in-browser generators. It rides the same
// constellation/reel (and can be stepped to like any other cell) and points
// at the /tools hub, not a roster slug.
items.push({
  key: 'tools',
  name: 'Tools',
  status: 'Open',
  tissue: 'Maker cells',
  oneLiner: 'In-browser generators: grainy gradient backgrounds and the ASOC cells mark. On-device, nothing uploaded.',
  color: '#8e7bff',
  href: '/tools',
  external: false,
})

const total = items.length
const first = items[0]

// Seven hand-varied flight paths, traced against the reference clips rather
// than derived from one formula: each lane spawns small at its own point
// near the bottom-right, ends large near the top-left, but the paths fan out
// across the whole stage (short/long, upper/lower) instead of stacking on a
// single diagonal - the reference reads as a loose scatter of cards, not a
// queue on a line. All offsets are vw/vh from stage-centre; tilt is fixed
// for a lane's entire flight (the reference cards never visibly re-rotate
// mid-flight). Durations vary a little per lane so the loop doesn't feel
// metronomic.
const FLOW_LANES = [
  { sx: 34, sy: 30, ex: -40, ey: -36, sScale: 0.4, eScale: 1.25, tilt: -6, duration: 4.6 },
  { sx: 40, sy: 16, ex: -46, ey: -22, sScale: 0.36, eScale: 1.2, tilt: 8, duration: 5.0 },
  { sx: 20, sy: 36, ex: -30, ey: -44, sScale: 0.42, eScale: 1.3, tilt: -10, duration: 4.4 },
  { sx: 40, sy: 34, ex: -18, ey: -12, sScale: 0.4, eScale: 1.1, tilt: 5, duration: 5.2 },
  { sx: 14, sy: 40, ex: -46, ey: -8, sScale: 0.38, eScale: 1.28, tilt: -4, duration: 4.8 },
  { sx: 46, sy: 6, ex: -12, ey: -40, sScale: 0.4, eScale: 1.2, tilt: 11, duration: 5.4 },
  { sx: 26, sy: 22, ex: -38, ey: -30, sScale: 0.4, eScale: 1.22, tilt: -8, duration: 4.9 },
]
// Bounded the same way v2's satellite count was: with fewer items in the
// roster than lanes, fewer lanes just means fewer distinct cards on stage at
// once rather than two lanes silently showing the same item.
const LANE_COUNT = Math.min(FLOW_LANES.length, total)
// A fixed stagger (not each lane's own duration/count) so the spread across
// the cycle stays even even though durations vary per lane.
const FLOW_STAGGER = 0.7
const lanes = FLOW_LANES.slice(0, LANE_COUNT).map((lane, i) => ({
  ...lane,
  item: items[i % total],
  // Negative delays start each lane already mid-flight and spread across
  // the cycle at first paint, instead of every lane launching from spawn
  // in lockstep the moment the page loads.
  delay: -(i * FLOW_STAGGER),
}))
---

<div class="home-outer" data-page="home">
  <div class="home-card">
    <!-- ============================================================ -->
    <!-- Desktop: the flow - a continuous diagonal conveyor of cards.   -->
    <!-- Each lane's own CSS animation loops independently forever;     -->
    <!-- JS only retints/relinks a lane's content each time its loop    -->
    <!-- restarts. prefers-reduced-motion swaps this for a static grid  -->
    <!-- of every item (see .flow-fallback below) instead of animating. -->
    <!-- ============================================================ -->
    <div class="scene scene--desktop" id="sceneDesktop" aria-hidden="false">
      <div class="flow-stage" id="flowStage" aria-hidden="true">
        {lanes.map((lane, i) => (
          <a
            class="flow-card"
            id={`flowCard${i}`}
            data-lane={i}
            href={lane.item.href}
            target={lane.item.external ? '_blank' : undefined}
            rel={lane.item.external ? 'noopener noreferrer' : undefined}
            aria-label={`${lane.item.tissue}: ${lane.item.name}`}
            tabindex="-1"
            style={`--sx:${lane.sx}vw; --sy:${lane.sy}vh; --ex:${lane.ex}vw; --ey:${lane.ey}vh; --s-scale:${lane.sScale}; --e-scale:${lane.eScale}; --tilt:${lane.tilt}deg; animation-duration:${lane.duration}s; animation-delay:${lane.delay}s;`}
          >
            <span class="flow-card__tag">{lane.item.tissue}</span>
            <span class="flow-card__status">{lane.item.status}</span>
            <span class="flow-card__name">{lane.item.name}</span>
          </a>
        ))}
      </div>

      <!-- Every item, in plain roster order, real tab-focusable links -
           visually hidden (standard sr-only clip) whenever the flow is
           running so it isn't a second, redundant on-screen copy, but never
           gated on a lane's animation cycle actually reaching that item.
           Under prefers-reduced-motion this becomes the visible page
           instead of the flow (see the media query below). -->
      <div class="flow-fallback">
        {items.map((it) => (
          <a
            class="flow-fallback__card"
            href={it.href}
            target={it.external ? '_blank' : undefined}
            rel={it.external ? 'noopener noreferrer' : undefined}
            style={`--fb-accent:${it.color}`}
          >
            <span class="flow-fallback__tag">{it.tissue}</span>
            <span class="flow-fallback__name">{it.name}</span>
            <span class="flow-fallback__status">{it.status}</span>
          </a>
        ))}
      </div>
    </div>

    <!-- ============================================================ -->
    <!-- Mobile: the reel - full-bleed backdrop + a scroll-snapped     -->
    <!-- vertical stack of every roster item as a name pill. Every     -->
    <!-- pill is a real link (works with no JS); JS only adds the      -->
    <!-- focus-by-distance dimming and keeps the backdrop in sync.     -->
    <!-- ============================================================ -->
    <div class="scene scene--mobile" id="sceneMobile" aria-hidden="true">
      <div class="reel" id="reel">
        <div class="reel-spacer" aria-hidden="true"></div>
        {items.map((it, i) => (
          <a
            class="pill"
            data-index={i}
            data-color={it.color}
            href={it.href}
            target={it.external ? '_blank' : undefined}
            rel={it.external ? 'noopener noreferrer' : undefined}
          >
            <span class="pill__name">{it.name}</span>
            <span class="pill__tissue">{it.tissue}</span>
          </a>
        ))}
        <div class="reel-spacer" aria-hidden="true"></div>
      </div>
      <div class="reel-caption" id="reelCaption" aria-live="polite">
        <p class="reel-oneliner" id="reelOneLiner">{first.oneLiner}</p>
        <span class="reel-status" id="reelStatus">{first.status}</span>
      </div>
    </div>

    <div class="home-foot">
      <div class="home-brand">
        <span class="home-brand-wordmark">asystemofcells</span>
      </div>
      <div class="home-meta">
        <div class="home-legal-links">
          <a href="/about">About</a>
          <a href="/faq">FAQ</a>
          <a href="/tools">Tools</a>
          <a href="/hyle-fonts">Fonts</a>
          <a href="/privacy">Privacy policy</a>
          <a href="/contact">Contact</a>
          <span class="home-rights">&copy; 2026 ASYSTEMOFCELLS</span>
          <button class="home-search-btn" type="button" id="homeSearchBtn" aria-label="Search">
            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
          </button>
        </div>
      </div>
    </div>
  </div>
</div>

<div class="search-overlay" id="searchOverlay" data-page="home" aria-hidden="true">
  <div class="search-panel" role="dialog" aria-modal="true" aria-label="Search apps">
    <div class="search-input-row">
      <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
      <input type="text" id="searchInput" class="search-input" placeholder="Search apps" autocomplete="off" />
      <button type="button" id="searchClose" class="search-close" aria-label="Close search">Esc</button>
    </div>
    <ul class="search-results" id="searchResults"></ul>
  </div>
</div>

<style is:global>
  /* Global (not Astro-scoped): several elements below are re-rendered or
     re-targeted client-side (card slots retint on every step), and the
     search results list is built via innerHTML - neither receives Astro's
     auto-injected data-astro-cid scoping attribute. Namespaced instead the
     same way v1 did it: every selector is under [data-page="home"] or a
     home-, card__- or pill__-prefixed class, so nothing collides with
     packages/kit's tokens.css or component classes. */
  @property --home-accent {
    syntax: '<color>';
    inherits: true;
    initial-value: #8e7bff;
  }
  @property --float-y {
    syntax: '<length>';
    inherits: false;
    initial-value: 0px;
  }

  [data-page='home'] {
    /* Near-black, not the flat #0b0b0c token - the stage wants to read as a
       void the cards float in, one shade off true black so the vignette has
       somewhere to go. */
    --home-bg: #050506;
    --home-ink: #f0ede6;
    --home-muted: rgba(240, 237, 230, 0.58);
    --home-ease: cubic-bezier(0.4, 0, 0.2, 1);
    --home-accent: #8e7bff;
    --home-panel: #16161a;
    --home-hairline: rgba(240, 237, 230, 0.14);
    /* A distinct near-white from --home-ink: card text sits directly on the
       grain-textured canvas rather than the page background, and this is
       the shade that was tuned to read well there. Named so it isn't a
       silent duplicate of --home-ink or a bare literal repeated per-rule. */
    --home-card-ink: #f3f2ef;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .home-outer {
    min-height: 100vh;
    display: flex;
    font-family: var(--font-ui);
    color: var(--home-ink);
    overflow: hidden;
  }

  .home-card {
    position: relative;
    width: 100%;
    background: var(--home-bg);
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  /* ---------------------------------------------------------- desktop --- */

  .scene--desktop {
    flex: 1;
    position: relative;
    z-index: 3;
    display: block;
  }

  .flow-stage {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  .flow-card {
    position: absolute;
    top: 50%;
    left: 50%;
    width: clamp(150px, 16vw, 260px);
    aspect-ratio: 3 / 4;
    margin-top: calc(clamp(150px, 16vw, 260px) * 4 / 3 / -2);
    margin-left: calc(clamp(150px, 16vw, 260px) / -2);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    border-radius: 6px;
    overflow: hidden;
    text-decoration: none;
    color: var(--home-ink);
    box-shadow: 0 30px 60px -20px rgba(0, 0, 0, 0.75);
    background-color: #1a1a1a; /* pre-canvas fallback so a slow paint never shows a see-through hole */
    /* Traced against the reference clips frame-by-frame: every card follows
       the same shape of path (spawn small near the bottom-right, grow while
       drifting to exit large near the top-left) at linear speed - the
       apparent "faster/bigger near the end" feel comes from real growth in
       scale over the same path, not from an eased timing function. Each
       lane supplies its own --sx/--sy/--ex/--ey/--s-scale/--e-scale/--tilt/
       animation-duration/animation-delay inline (see FLOW_LANES). */
    animation-name: flow;
    animation-timing-function: linear;
    animation-iteration-count: infinite;
    animation-play-state: running;
  }
  .flow-card:hover,
  .flow-card:focus-visible {
    /* A constantly-moving target can't be clicked, so hovering (or focusing,
       for the rare case a lane is reachable - see .flow-fallback for the
       real tab path) freezes just that one lane mid-flight; the rest keep
       flowing. */
    animation-play-state: paused;
    z-index: 20;
    box-shadow: 0 40px 80px -18px rgba(0, 0, 0, 0.85);
  }
  @keyframes flow {
    0% { transform: translate(var(--sx), var(--sy)) scale(var(--s-scale)) rotate(var(--tilt)); opacity: 0; }
    6% { opacity: 1; }
    90% { opacity: 1; }
    100% { transform: translate(var(--ex), var(--ey)) scale(var(--e-scale)) rotate(var(--tilt)); opacity: 0; }
  }
  /* Same guaranteed-dark scrim as v2's cards: the texture always ramps to a
     pale end, and which corner that lands on depends on the accent's hue. */
  .flow-card::after {
    content: '';
    position: absolute;
    inset: auto 0 0 0;
    height: 46%;
    z-index: 1;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.55), rgba(0, 0, 0, 0));
    pointer-events: none;
  }
  .flow-card:focus-visible {
    outline: 2px solid var(--home-ink);
    outline-offset: 3px;
  }

  .flow-card__tag {
    position: relative;
    z-index: 2;
    align-self: flex-start;
    margin: 10px;
    font-family: var(--font-mono);
    font-size: 7px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    padding: 4px 7px;
    /* Opaque enough on its own to stay WCAG-AA-legible regardless of which
       part of the card's accent-to-white gradient sits behind it - this
       chip has no scrim under it to lean on. */
    background: rgba(0, 0, 0, 0.72);
    color: var(--home-card-ink);
    border-radius: 2px;
    pointer-events: none;
  }
  .flow-card__status {
    position: absolute;
    z-index: 2;
    top: 10px;
    right: 10px;
    font-family: var(--font-mono);
    font-size: 8px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 5px 10px;
    border-radius: 999px;
    background: var(--home-ink);
    color: var(--home-panel);
    pointer-events: none;
  }
  .flow-card__name {
    position: relative;
    z-index: 2;
    margin: 10px;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(12px, 1.3vw, 17px);
    color: var(--home-card-ink);
    text-shadow: 0 1px 4px rgba(0, 0, 0, 0.5);
  }

  /* Real links, real tab-focusable, in plain roster order - always in the
     DOM so completeness never depends on a lane's loop reaching an item.
     Visually hidden (standard sr-only clip) while the flow is what's shown,
     the same way SiteHeader's own .skip-link is hidden until focused - so it
     reveals itself as a real, usable panel the moment a keyboard user tabs
     into it, rather than landing them on an invisible 1px focus ring. Also
     becomes the visible page outright under reduced motion, below. */
  .flow-fallback {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
  /* Scoped to no-preference: under reduced motion, .flow-fallback is already
     the plain static grid below, and :focus-within's higher specificity
     would otherwise win the cascade over that media query and pop it into a
     floating panel the moment a link inside it is focused. */
  @media (prefers-reduced-motion: no-preference) {
    .flow-fallback:focus-within {
      position: fixed;
      inset: auto 4vw 92px 4vw;
      width: auto;
      height: auto;
      max-height: 55vh;
      margin: 0;
      overflow: auto;
      clip: auto;
      white-space: normal;
      z-index: 30;
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
      gap: 12px;
      padding: 16px;
      background: var(--home-panel);
      border: 1px solid var(--home-hairline);
      border-radius: 12px;
      box-shadow: 0 30px 70px rgba(0, 0, 0, 0.6);
    }
  }
  .flow-fallback__card {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 14px;
    border-radius: 6px;
    border: 1px solid var(--home-hairline);
    border-top: 3px solid var(--fb-accent, var(--home-ink));
    text-decoration: none;
    color: var(--home-ink);
  }
  .flow-fallback__tag {
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--home-muted);
  }
  .flow-fallback__name {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 15px;
  }
  .flow-fallback__status {
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--home-muted);
  }

  @media (prefers-reduced-motion: reduce) {
    .flow-stage { display: none; }
    .flow-fallback {
      position: static;
      width: auto;
      height: auto;
      padding: 6vh 4vw;
      margin: 0;
      overflow: visible;
      clip: auto;
      white-space: normal;
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
      gap: 14px;
      align-content: center;
    }
  }

  /* ----------------------------------------------------------- mobile --- */

  .scene--mobile { display: none; }

  @media (max-width: 880px) {
    .scene--desktop { display: none; }
    .scene--mobile {
      display: block;
      flex: 1;
      position: relative;
      z-index: 3;
      overflow: hidden;
    }
    .reel {
      position: absolute;
      inset: 0;
      overflow-y: auto;
      overflow-x: hidden;
      scroll-snap-type: y proximity;
      -webkit-overflow-scrolling: touch;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 14px;
      padding-inline: 8vw;
    }
    .reel-spacer { flex: 0 0 auto; height: 40vh; scroll-snap-align: none; }
    .pill {
      flex: 0 0 auto;
      scroll-snap-align: center;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 2px;
      text-decoration: none;
      color: var(--home-ink);
      opacity: 0.4;
      transform: scale(0.86);
      transition: opacity 260ms var(--home-ease), transform 260ms var(--home-ease);
      padding: 6px 10px;
    }
    .pill--focused { opacity: 1; transform: scale(1); }
    .pill__name {
      font-family: var(--font-display);
      font-weight: 600;
      font-size: clamp(20px, 7.2vw, 30px);
      white-space: nowrap;
    }
    .pill__tissue {
      font-family: var(--font-mono);
      font-size: 9px;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--home-muted);
    }
    .pill--focused .pill__tissue { color: var(--home-ink); }
    .pill:focus-visible { outline: 2px solid var(--home-ink); outline-offset: 4px; opacity: 1; transform: scale(1); }

    @media (prefers-reduced-motion: reduce) {
      .pill { transition: none; }
    }

    .reel-caption {
      position: absolute;
      left: 0;
      right: 0;
      bottom: 0;
      z-index: 4;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      padding: 56px 8vw 16px;
      background: linear-gradient(to top, var(--home-bg) 42%, rgba(5, 5, 6, 0));
      pointer-events: none;
    }
    .reel-oneliner {
      margin: 0;
      max-width: 64%;
      font-size: 12px;
      line-height: 1.5;
      color: var(--home-muted);
      display: -webkit-box;
      -webkit-line-clamp: 1;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }
    .reel-status {
      flex: 0 0 auto;
      font-family: var(--font-mono);
      font-size: 9px;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      padding: 5px 10px;
      border-radius: 999px;
      background: var(--home-ink);
      color: var(--home-panel);
    }
  }

  /* ------------------------------------------------------------ footer -- */

  .home-foot {
    z-index: 5;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    padding: 1.8% 3.4% 2.4%;
    gap: 2%;
  }
  .home-brand {
    display: flex;
    align-items: center;
    gap: 9px;
  }
  .home-brand-wordmark {
    font-family: var(--font-ui);
    font-weight: 700;
    font-size: clamp(15px, 2vw, 26px);
    line-height: 0.95;
    letter-spacing: 0.01em;
    white-space: nowrap;
  }
  .home-meta {
    display: flex;
    align-items: center;
  }
  .home-legal-links {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 18px;
    flex-wrap: wrap;
  }
  .home-legal-links a {
    font-family: var(--font-mono);
    font-size: clamp(5px, 0.7vw, 9px);
    letter-spacing: 0.1em;
    color: var(--home-muted);
    text-decoration: none;
  }
  .home-legal-links a:hover {
    color: var(--home-ink);
  }
  .home-rights {
    font-family: var(--font-mono);
    font-size: clamp(5px, 0.7vw, 9px);
    letter-spacing: 0.14em;
    color: var(--home-muted);
    white-space: nowrap;
  }
  .home-search-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 18px;
    height: 18px;
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    color: var(--home-muted);
    transition: color 0.15s;
  }
  .home-search-btn:hover,
  .home-search-btn:focus-visible {
    color: var(--home-ink);
  }
  .home-search-btn svg {
    width: 13px;
    height: 13px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
  }

  @media (max-width: 720px) {
    .home-legal-links { gap: 10px; }
  }

  /* ------------------------------------------------------------- search - */

  .search-overlay {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: none;
    align-items: flex-start;
    justify-content: center;
    padding: 12vh 5vw 0;
    background: rgba(0, 0, 0, 0.65);
    backdrop-filter: blur(6px);
  }
  .search-overlay.open {
    display: flex;
  }
  .search-panel {
    width: min(560px, 100%);
    max-height: 70vh;
    display: flex;
    flex-direction: column;
    background: var(--home-panel);
    border: 1px solid var(--home-hairline);
    border-radius: 14px;
    box-shadow: 0 30px 70px rgba(0, 0, 0, 0.6);
    overflow: hidden;
    font-family: var(--font-ui);
  }
  .search-input-row {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 16px 18px;
    border-bottom: 1px solid var(--home-hairline);
  }
  .search-input-row svg {
    flex: 0 0 auto;
    width: 18px;
    height: 18px;
    fill: none;
    stroke: var(--home-muted);
    stroke-width: 1.8;
  }
  .search-input {
    flex: 1;
    border: none;
    background: none;
    outline: none;
    font-family: inherit;
    font-size: 16px;
    color: var(--home-ink);
  }
  .search-input::placeholder {
    color: var(--home-muted);
  }
  .search-close {
    flex: 0 0 auto;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.06em;
    color: var(--home-muted);
    background: rgba(255, 255, 255, 0.08);
    border: none;
    border-radius: 4px;
    padding: 4px 8px;
    cursor: pointer;
  }
  .search-close:hover {
    color: var(--home-ink);
  }
  .search-results {
    list-style: none;
    margin: 0;
    padding: 8px;
    overflow-y: auto;
  }
  .search-results:empty {
    display: none;
  }
  .search-result {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 10px;
    border-radius: 8px;
    text-decoration: none;
    color: var(--home-ink);
  }
  .search-result:hover,
  .search-result.active {
    background: rgba(255, 255, 255, 0.08);
  }
  .search-result-swatch {
    flex: 0 0 auto;
    width: 32px;
    height: 32px;
    border-radius: 7px;
  }
  .search-result-text {
    min-width: 0;
  }
  .search-result-name {
    display: block;
    font-weight: 600;
    font-size: 14px;
  }
  .search-result-meta {
    display: block;
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
