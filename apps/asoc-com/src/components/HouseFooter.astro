---
// The fixed simple footer shared by every white page (SimplePageLayout and
// WingLayout). One copy of the markup. Styles live in styles/house-shell.css.
//
// Slot "links" adds page-specific links (e.g. a product's own privacy page)
// ahead of the house Privacy link.
import { ICONS } from '../scripts/social-icons.js'

// Social profiles are icon-only: the label lives in aria-label and title.
// `wing` is still accepted by callers but no longer draws a wing switcher: a
// page shows the way back (the top-left trail), not the sections it is not in.
const SOCIAL = [
  { key: 'instagram', label: 'Instagram', href: 'https://www.instagram.com/asystemofcells' },
  { key: 'linkedin', label: 'LinkedIn', href: 'https://www.linkedin.com/company/asystemofcells' },
  { key: 'github', label: 'GitHub', href: 'https://github.com/mbaliga' },
  { key: 'kofi', label: 'Ko-fi', href: 'https://ko-fi.com/asystemofcells' },
]
---
<footer class="site-foot">
  <div class="wrap foot-simple">
    <div class="foot-lead">
      <a class="foot-brand-name" href="/">asystemofcells</a>
    </div>
    <!-- site pages first, then the house's own profiles; GitHub is the
         maker's account because that is where the code lives, and Ko-fi
         is where the house takes support. -->
    <nav class="foot-links">
      <a href="/about">About</a>
      <a href="/faq">FAQ</a>
      <a href="/tools">Tools</a>
      <a href="/hyle-fonts">Fonts</a>
      <slot name="links" />
      <a href="/privacy">Privacy</a>
      <a href="/contact">Contact</a>
      <span class="foot-sep" aria-hidden="true"></span>
      {SOCIAL.map((x) => (
        <a class="foot-icon" href={x.href} target="_blank" rel="noopener noreferrer" aria-label={x.label} title={x.label}>
          <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" focusable="false"><path fill="currentColor" d={ICONS[x.key]} /></svg>
        </a>
      ))}
    </nav>
    <span class="foot-rights">&copy; 2026 asystemofcells</span>
  </div>
</footer>
