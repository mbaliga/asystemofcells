---
import ExtensionIcon from './ExtensionIcon.astro'
import ExtensionBadges from './ExtensionBadges.astro'
import { categoryLabel } from '../lib/extensions.js'
const { ext } = Astro.props
const search = [ext.name, ext.summary, ext.author, ...ext.tags].join(' ').toLowerCase()
---
<li class="ext-card" data-app={ext.app} data-category={ext.category} data-status={ext.status} data-risk={ext.maxRisk} data-search={search}>
  <a class="ext-card__link" href={`/extensions/${ext.app}/${ext.id}/`}>
    <ExtensionIcon ext={ext} size={56} />
    <span class="ext-card__body">
      <span class="ext-card__name">{ext.name}</span>
      <span class="ext-card__meta">{ext.appName} &middot; {categoryLabel(ext.category)} &middot; by {ext.author || 'unknown author'}</span>
      <span class="ext-card__summary">{ext.summary}</span>
      <ExtensionBadges ext={ext} />
    </span>
  </a>
</li>
