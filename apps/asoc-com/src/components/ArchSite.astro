---
// The shared site form for the architecture tools: place, coordinates, time zone, north.
const { north = true } = Astro.props
---
<fieldset class="arch-site">
  <legend>The site</legend>
  <label>Place <select id="siteSel"></select></label>
  <label>Latitude <input id="lat" type="number" step="0.0001" min="-90" max="90" /></label>
  <label>Longitude <input id="lon" type="number" step="0.0001" min="-180" max="180" /></label>
  <label>Time zone <input id="tz" value="Asia/Kolkata" /></label>
  {north && <label>True north is this many degrees clockwise from the top of the plan <input id="north" type="number" step="1" value="0" /></label>}
  <button class="cab-link" id="geo" type="button">Use my location (your browser will ask)</button>
</fieldset>
