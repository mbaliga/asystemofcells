---
import { STATUS_LABEL, RISK_LABEL } from '../lib/extensions.js'
const { ext, showRisk = true } = Astro.props
const glyph = { low: '○', medium: '◐', high: '●' }
---
<span class="ext-badges">
  <span class={`ext-badge ext-status ext-status--${ext.status}`}>{STATUS_LABEL[ext.status]}</span>
  {ext.noncommercial && <span class="ext-badge ext-badge--plain">Non-commercial</span>}
  {showRisk && (
    <span class={`ext-badge ext-risk ext-risk--${ext.maxRisk}`} title={ext.permissions.length ? `Highest permission risk: ${ext.maxRisk}` : 'Asks for no permissions'}>
      <span aria-hidden="true">{glyph[ext.maxRisk]}</span>
      {ext.permissions.length === 0 ? 'No permissions' : `${RISK_LABEL[ext.maxRisk]}`}
    </span>
  )}
</span>
