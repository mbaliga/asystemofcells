{
  "name": "asystemofcells",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter @asoc/com dev",
    "build": "bash docs/handoff/tools/check-analytics-boundary.sh && node packages/roster/validate.mjs && pnpm --filter @asoc/com build",
    "dev:dev": "pnpm --filter @asoc/dev dev",
    "build:dev": "pnpm --filter @asoc/dev build",
    "roster:check": "node packages/roster/validate.mjs",
    "test": "node --test api/counter/__tests__/*.test.js docs/handoff/tools/*.test.mjs apps/asoc-com/src/scripts/prints/*.test.mjs",
    "dev:counter": "pnpm build && node scripts/counter-dev.mjs",
    "e2e:cabinet": "node scripts/e2e-cabinet.mjs",
    "e2e:prints": "node scripts/e2e-prints.mjs"
  },
  "dependencies": {
    "@mozilla/readability": "^0.5.0",
    "linkedom": "^0.18.5"
  },
  "engines": {
    "node": ">=20"
  }
}
